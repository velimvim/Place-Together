local presenceToggle = makeButton("Peer Cursors: On")
local logout = makeButton("Check Connection & Refresh")
local dashToggle = makeButton("Web Dashboard: Checking...")
local isDashEnabled = false

local function updateDashButton(state)
	isDashEnabled = (state == true)
	if isDashEnabled then
		dashToggle.Text = "Web Dashboard: Enabled"
		dashToggle.TextColor3 = palette.green
	else
		dashToggle.Text = "Web Dashboard: Disabled"
		dashToggle.TextColor3 = palette.subtle
	end
end

fetchDashStatus = function()
	if not api then return end
	task.spawn(function()
		local ok, cfg = pcall(function()
			return api("/config/dashboard", "GET")
		end)
		if ok and type(cfg) == "table" and cfg.enabled ~= nil then
			updateDashButton(cfg.enabled == true)
		else
			dashToggle.Text = "Web Dashboard: Disabled"
			dashToggle.TextColor3 = palette.subtle
		end
	end)
end

dashToggle.MouseButton1Click:Connect(function()
	if not api then
		status("Please wait, plugin is initializing...")
		return
	end
	dashToggle.Text = "Updating..."
	task.spawn(function()
		local ok, res = pcall(function()
			return api("/config/dashboard", "POST", {enabled = not isDashEnabled})
		end)
		if ok and type(res) == "table" and res.enabled ~= nil then
			updateDashButton(res.enabled == true)
			status("Web Dashboard " .. (res.enabled and "enabled" or "disabled") .. " on server.")
		else
			updateDashButton(isDashEnabled)
			local err = (not ok and tostring(res)) or (type(res) == "table" and res.error) or "Server error"
			status("Failed to toggle dashboard: " .. tostring(err))
		end
	end)
end)


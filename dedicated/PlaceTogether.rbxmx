function app.status(s)
    app.operations.setNotice(s)
end
function app.warn(key, message)
    app.warnings[key] = message
end
function app.operations.warningText()
    local count = 0
    ;
    local sample = {
    }
    for _, message in pairs(app.warnings) do
        count = count + (1)
        ;
        if #sample &lt; 2 then
            table.insert(sample, message)
        end
    end
    return count &gt; 0 and (string.char(10) .. "Limitations (" .. count .. "): " .. table.concat(sample, "; ")) or ""
end
function app.operations.equal(a, b)
    if a == b then
        return true
    end
    if type(a) ~= type(b) then
        return false
    end
    if type(a) == "number" then
        if a ~= a or b ~= b then
            return a == b
        end
        return math.abs(a - b) &lt; 1e-06
    end
    if type(a) ~= "table" then
        return a == b
    end
    for k, v in pairs(a) do
        if not app.operations.equal(v, b[k]) then
            return false
        end
    end
    for k in pairs(b) do
        if a[k] == nil then
            return false
        end
    end
    return true
end
function app.operations.copy(value)
    if type(value) ~= "table" then
        return value
    end
    local result = {
    }
    ;
    for key, item in pairs(value) do
        result[key] = app.operations.copy(item)
    end
    ;
    return result
end
function app.operations.splitLines(text)
    local lines = {
    }
    if not text or text == "" then
        return lines
    end
    local clean = text:gsub(string.char(13, 10), string.char(10)):gsub(string.char(13), string.char(10))
    local pos = 1
    local len = #clean
    while pos &lt;= len do
        local nl = clean:find(string.char(10), pos, true)
        if nl then
            table.insert(lines, clean:sub(pos, nl - 1))
            pos = nl + 1
        else
            table.insert(lines, clean:sub(pos))
            break
        end
    end
    if clean:sub(-1) == string.char(10) then
        table.insert(lines, "")
    end
    return lines
end
function app.operations.lcsMatch(a, b)
    local n, m = #a, #b
    local pref = 0
    while pref &lt; n and pref &lt; m and a[pref + 1] == b[pref + 1] do
        pref = pref + 1
    end
    local suf = 0
    while suf &lt; (n - pref) and suf &lt; (m - pref) and a[n - suf] == b[m - suf] do
        suf = suf + 1
    end
    local midA_len = n - pref - suf
    local midB_len = m - pref - suf
    local matches = {
    }
    local matchedA = {
    }
    local matchedB = {
    }
    for k = 1, pref do
        matches[k] = k
        matchedA[k] = true
        matchedB[k] = true
    end
    for k = 0, suf - 1 do
        local aIdx = n - k
        local bIdx = m - k
        matches[aIdx] = bIdx
        matchedA[aIdx] = true
        matchedB[bIdx] = true
    end
    if midA_len &gt; 0 and midB_len &gt; 0 and midA_len * midB_len &lt;= 250000 then
        local dp = {
        }
        for i = 0, midA_len do
            dp[i] = {
            }
            for j = 0, midB_len do
                dp[i][j] = 0
            end
        end
        for i = 1, midA_len do
            local lineA = a[pref + i]
            for j = 1, midB_len do
                if lineA == b[pref + j] then
                    dp[i][j] = dp[i - 1][j - 1] + 1
                else
                    local v1 = dp[i - 1][j]
                    local v2 = dp[i][j - 1]
                    dp[i][j] = (v1 &gt; v2) and v1 or v2
                end
            end
        end
        local i, j = midA_len, midB_len
        while i &gt; 0 and j &gt; 0 do
            if a[pref + i] == b[pref + j] then
                local aIdx = pref + i
                local bIdx = pref + j
                matches[aIdx] = bIdx
                matchedA[aIdx] = true
                matchedB[bIdx] = true
                i = i - 1
                j = j - 1
            elseif dp[i - 1][j] &gt;= dp[i][j - 1] then
                i = i - 1
            else
                j = j - 1
            end
        end
    end
    return matches, matchedA, matchedB
end
function app.operations.analyzeDiff(baseLines, modLines)
    local matches, matchedBase, matchedMod = app.operations.lcsMatch(baseLines, modLines)
    local n = #baseLines
    local m = #modLines
    local insertsBefore = {
    }
    for i = 1, n + 1 do
        insertsBefore[i] = {
        }
    end
    local curBase = 1
    for j = 1, m do
        if matchedMod[j] then
            for aIdx, bIdx in pairs(matches) do
                if bIdx == j then
                    curBase = aIdx + 1
                    break
                end
            end
        else
            local target = (curBase &lt;= n) and curBase or (n + 1)
            table.insert(insertsBefore[target], modLines[j])
        end
    end
    local stateOf = {
    }
    for i = 1, n do
        stateOf[i] = matchedBase[i] and "equal" or "deleted"
    end
    return insertsBefore, stateOf
end
function app.operations.merge3WayText(baseStr, localStr, remoteStr)
    if localStr == baseStr then
        return remoteStr, (remoteStr ~= baseStr)
    end
    if remoteStr == baseStr or localStr == remoteStr then
        return localStr, false
    end
    local base = app.operations.splitLines(baseStr)
    local localLines = app.operations.splitLines(localStr)
    local remoteLines = app.operations.splitLines(remoteStr)
    local insLoc, stateLoc = app.operations.analyzeDiff(base, localLines)
    local insRem, stateRem = app.operations.analyzeDiff(base, remoteLines)
    local result = {
    }
    local n = #base
    local function appendLines(lines)
        for _, l in ipairs(lines) do
            table.insert(result, l)
        end
    end
    local function sameLines(a, b)
        if #a ~= #b then
            return false
        end
        for k = 1, #a do
            if a[k] ~= b[k] then
                return false
            end
        end
        return true
    end
    for i = 1, n + 1 do
        local locIn = insLoc[i] or {
        }
        local remIn = insRem[i] or {
        }
        if #locIn &gt; 0 and #remIn == 0 then
            appendLines(locIn)
        elseif #remIn &gt; 0 and #locIn == 0 then
            appendLines(remIn)
        elseif #locIn &gt; 0 and #remIn &gt; 0 then
            if sameLines(locIn, remIn) then
                appendLines(locIn)
            else
                app.warn("script:overlap", "Script edits overlap; local text kept.")
                return localStr, false
            end
        end
        if i &lt;= n then
            local stL = stateLoc[i]
            local stR = stateRem[i]
            if stL == "deleted" and stR == "deleted" then

            elseif stL == "deleted" and stR == "equal" then

            elseif stR == "deleted" and stL == "equal" then

            else
                table.insert(result, base[i])
            end
        end
    end
    return table.concat(result, "\n"), true
end
function app.operations.merge(base, localValue, remote, keyName)
    if keyName == "Source" and type(localValue) == "string" and type(remote) == "string" then
        return app.operations.merge3WayText(type(base) == "string" and base or "", localValue, remote)
    end
    if app.operations.equal(localValue, base) then
        return app.operations.copy(remote)
    end
    if app.operations.equal(remote, base) or app.operations.equal(localValue, remote) then
        return app.operations.copy(localValue)
    end
    if type(localValue) ~= "table" or type(remote) ~= "table" or localValue.t or remote.t then
        return app.operations.copy(localValue)
    end
    if localValue.class == nil and localValue.props == nil and #localValue &gt; 0 then
        return app.operations.copy(localValue)
    end
    local result = {
    }
    ;
    local keys = {
    }
    for key in pairs(localValue) do
        keys[key] = true
    end
    ;
    for key in pairs(remote) do
        keys[key] = true
    end
    if type(base) == "table" then
        for key in pairs(base) do
            keys[key] = true
        end
    end
    for key in pairs(keys) do
        local previous
        ;
        if type(base) == "table" then
            previous = base[key]
        end
        result[key] = app.operations.merge(previous, localValue[key], remote[key], key)
    end
    return result
end
function app.operations.acknowledged(remote, desired, actual)
    if app.operations.equal(remote, desired) then
        return app.operations.copy(actual)
    end
    if type(remote) ~= "table" or type(desired) ~= "table" or type(actual) ~= "table" then
        return app.operations.copy(remote)
    end
    local result = {
    }
    ;
    local keys = {
    }
    for key in pairs(remote) do
        keys[key] = true
    end
    for key in pairs(desired) do
        keys[key] = true
    end
    for key in pairs(actual) do
        keys[key] = true
    end
    for key in pairs(keys) do
        result[key] = app.operations.acknowledged(remote[key], desired[key], actual[key])
    end
    return result
end
app.BASE64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
function app.operations.base64Encode(data)
    local out = {
    }
    local n = #data
    local i = 1
    while i &lt;= n do
        local a = string.byte(data, i) or 0
        local b = string.byte(data, i + 1)
        local c = string.byte(data, i + 2)
        local triple = a * 65536 + (b or 0) * 256 + (c or 0)
        local c1 = math.floor(triple / 262144) % 64
        local c2 = math.floor(triple / 4096) % 64
        local c3 = math.floor(triple / 64) % 64
        local c4 = triple % 64
        table.insert(out, string.sub(app.BASE64, c1 + 1, c1 + 1) .. string.sub(app.BASE64, c2 + 1, c2 + 1) .. (b and string.sub(app.BASE64, c3 + 1, c3 + 1) or "=") .. (c and string.sub(app.BASE64, c4 + 1, c4 + 1) or "="))
        i = i + (3)
    end
    return table.concat(out)
end
function app.operations.base64Decode(text)
    local lookup = {
    }
    for i = 1, #app.BASE64 do
        lookup[string.sub(app.BASE64, i, i)] = i - 1
    end
    local out = {
    }
    local n = #text
    local i = 1
    while i &lt;= n do
        local c1 = lookup[string.sub(text, i, i)]
        local c2 = lookup[string.sub(text, i + 1, i + 1)]
        local c3 = lookup[string.sub(text, i + 2, i + 2)]
        local c4 = lookup[string.sub(text, i + 3, i + 3)]
        if not c1 or not c2 then
            break
        end
        local triple = c1 * 262144 + c2 * 4096 + (c3 or 0) * 64 + (c4 or 0)
        table.insert(out, string.char(math.floor(triple / 65536) % 256, math.floor(triple / 256) % 256, triple % 256))
        i = i + (4)
    end
    local joined = table.concat(out)
    local pad = 0
    if string.sub(text, -2, -2) == "=" then
        pad = 2
    elseif string.sub(text, -1) == "=" then
        pad = 1
    end
    if pad &gt; 0 then
        joined = string.sub(joined, 1, #joined - pad)
    end
    return joined
end
app.terrainCache, app.terrainKnown = {
}, {
}
app.CHUNK, app.VOXELS = 64, 16
function app.operations.terrainKey(x, y, z)
    return "~Terrain/" .. x .. "/" .. y .. "/" .. z
end
function app.operations.terrainOrigin(key, value)
    local origin = value and value.props and value.props.origin
    if not origin then
        local x, y, z = key:match("^~Terrain/([%-0-9]+)/([%-0-9]+)/([%-0-9]+)$")
        if x then
            origin = {
                tonumber(x),
                tonumber(y),
                tonumber(z),
            }
        end
    end
    if type(origin) ~= "table" or #origin ~= 3 then
        error("Invalid Terrain origin")
    end
    for i = 1, 3 do
        local n = origin[i]
        if type(n) ~= "number" or n ~= n or math.abs(n) &gt; 128000 or n % app.CHUNK ~= 0 then
            error("Unaligned Terrain origin")
        end
    end
    if app.operations.terrainKey(table.unpack(origin)) ~= key then
        error("Terrain key/origin mismatch")
    end
    return origin
end
function app.operations.terrainRegion(origin)
    return Region3.new(Vector3.new(table.unpack(origin)), Vector3.new(origin[1] + app.CHUNK, origin[2] + app.CHUNK, origin[3] + app.CHUNK))
end
function app.operations.terrainPacket(origin, runs)
    return {
        class = "PTTerrainChunk",
        name = "Terrain chunk",
        parent = "@Workspace",
        props = {
            origin = origin,
            runs = runs,
            generation = app.synchronization.terrainAppliedGeneration,
        },
    }
end
function app.operations.terrainAppend(runs, material, solid, liquid, count)
    local last = runs[#runs]
    if last and last[1] == material and last[2] == solid and last[3] == liquid then
        last[4] = last[4] + (count)
    else
        runs[#runs + 1] = {
            material,
            solid,
            liquid,
            count,
        }
    end
end
function app.operations.readTerrain(origin)
    local channels = workspace.Terrain:ReadVoxelChannels(app.operations.terrainRegion(origin), 4, {
        "SolidMaterial",
        "SolidOccupancy",
        "LiquidOccupancy",
    })
    local runs = {
    }
    for x = 1, app.VOXELS do
        for y = 1, app.VOXELS do
            for z = 1, app.VOXELS do
                local solid = channels.SolidOccupancy[x][y][z]
                local liquid = channels.LiquidOccupancy[x][y][z]
                local material = solid &gt; 0 and channels.SolidMaterial[x][y][z].Name or "Air"
                app.operations.terrainAppend(runs, material, solid, liquid, 1)
            end
        end
    end
    return app.operations.terrainPacket(origin, runs)
end
function app.operations.terrainRuns(value)
    if not value then
        return {
            {
                "Air",
                0,
                0,
                4096,
            },
        }
    end
    local props = value.props
    if not props or props.data then
        error("Legacy 5.0 Terrain data has truncated materials. Create a new room with the fixed plugin on both PCs.")
    end
    local runs = props.runs
    if type(runs) ~= "table" or #runs &lt; 1 then
        error("Missing Terrain runs")
    end
    local total = 0
    for _, run in ipairs(runs) do
        if type(run) ~= "table" or #run ~= 4 or type(run[1]) ~= "string" or not Enum.Material[run[1]] then
            error("Invalid Terrain material")
        end
        for i = 2, 3 do
            if type(run[i]) ~= "number" or run[i] ~= run[i] or run[i] &lt; 0 or run[i] &gt; 1 then
                error("Invalid voxel occupancy")
            end
        end
        if type(run[4]) ~= "number" or run[4] % 1 ~= 0 or run[4] &lt; 1 then
            error("Invalid Terrain run")
        end
        total = total + (run[4])
        if total &gt; 4096 then
            error("Oversized Terrain packet")
        end
    end
    if total ~= 4096 then
        error("Incomplete Terrain packet")
    end
    return runs
end
function app.operations.writeTerrain(origin, value)
    local runs = app.operations.terrainRuns(value)
    -- Validate the complete packet before touching terrain.
    local channels = {
        SolidMaterial = {
        },
        SolidOccupancy = {
        },
        LiquidOccupancy = {
        },
    }
    local index, remaining = 1, runs[1][4]
    for x = 1, app.VOXELS do
        for _, array in pairs(channels) do
            array[x] = {
            }
        end
        for y = 1, app.VOXELS do
            for _, array in pairs(channels) do
                array[x][y] = {
                }
            end
            for z = 1, app.VOXELS do
                if remaining == 0 then
                    index = index + (1)
                    ;
                    remaining = runs[index][4]
                end
                local run = runs[index]
                channels.SolidMaterial[x][y][z] = Enum.Material[run[1]]
                channels.SolidOccupancy[x][y][z] = run[2]
                channels.LiquidOccupancy[x][y][z] = run[3]
                remaining = remaining - (1)
            end
        end
    end
    workspace.Terrain:WriteVoxelChannels(app.operations.terrainRegion(origin), 4, channels)
end
-- Three-way merge per voxel: remote changes outside the local brush survive.
function app.synchronization.mergeTerrain(key, base, localValue, remote)
    local origin = app.operations.terrainOrigin(key, remote or localValue or base)
    local a, b, c = app.operations.terrainRuns(base), app.operations.terrainRuns(localValue), app.operations.terrainRuns(remote)
    local ai, bi, ci = 1, 1, 1
    local ar, br, cr = a[1][4], b[1][4], c[1][4]
    local runs = {
    }
    for _ = 1, 4096 do
        if ar == 0 then
            ai = ai + (1)
            ;
            ar = a[ai][4]
        end
        if br == 0 then
            bi = bi + (1)
            ;
            br = b[bi][4]
        end
        if cr == 0 then
            ci = ci + (1)
            ;
            cr = c[ci][4]
        end
        local av, bv, cv = a[ai], b[bi], c[ci]
        local unchanged = bv[1] == av[1] and bv[2] == av[2] and bv[3] == av[3]
        local chosen = unchanged and cv or bv
        app.operations.terrainAppend(runs, chosen[1], chosen[2], chosen[3], 1)
        ar = ar - (1)
        ;
        br = br - (1)
        ;
        cr = cr - (1)
    end
    return app.operations.terrainPacket(origin, runs)
end
function app.operations.terrainReset()
    app.terrainCache = {
    }
    ;
    app.terrainKnown = {
    }
    app.synchronization.terrainQueue = {
    }
    ;
    app.synchronization.terrainHead = 1
    ;
    app.synchronization.terrainQueued = {
    }
    app.synchronization.terrainOrigins = {
    }
    ;
    app.synchronization.terrainCursor = 1
    ;
    app.synchronization.terrainNext = 0
    app.synchronization.terrainScanAt = 0
    ;
    app.synchronization.terrainScanPos = nil
    ;
    app.synchronization.terrainAppliedGeneration = nil
    app.synchronization.terrainTotal = 0
    ;
    app.synchronization.terrainDone = 0
    ;
    app.synchronization.terrainBulk = false
end
function app.synchronization.queueTerrain(origin)
    local key = app.operations.terrainKey(table.unpack(origin))
    app.operations.terrainOrigin(key, {
        props = {
            origin = origin,
        },
    })
    if not app.terrainKnown[key] then
        if #app.synchronization.terrainOrigins &gt;= 16384 then
            error("Terrain tracking limit reached; use smaller bounds or a new session")
        end
        app.terrainKnown[key] = origin
        app.synchronization.terrainOrigins[#app.synchronization.terrainOrigins + 1] = origin
    end
    if not app.synchronization.terrainQueued[key] then
        app.synchronization.terrainQueued[key] = true
        app.synchronization.terrainQueue[#app.synchronization.terrainQueue + 1] = {
            key,
            origin,
        }
    end
end
-- CopyRegion uses Roblox's sparse terrain storage: no scan of billions of empty chunks.
function app.synchronization.queueFullTerrain()
    if not app.Serialization then
        error("Full Terrain transfer requires SerializationService in Studio")
    end
    local terrain = workspace.Terrain
    local extents = terrain.MaxExtents
    app.LoadUI.setLocal(true, "Copying all Terrain", "Roblox is capturing the complete Terrain. Large maps can take time.", 0, 0)
    task.wait()
    local region = terrain:CopyRegion(extents)
    local ok, raw = pcall(function()
        return buffer.tostring(app.Serialization:SerializeInstancesAsync({
            region,
        }))
    end)
    region:Destroy()
    if not ok then
        error("Cannot serialize complete Terrain: " .. tostring(raw))
    end
    local size = 72 * 1024
    local total = math.max(1, math.ceil(#raw / size))
    local generation = app.http:GenerateGUID(false)
    app.synchronization.terrainAppliedGeneration = generation
    -- Fixed snapshot keys prevent old generations from growing the server forever.
    for key in pairs(app.terrainCache) do
        app.terrainCache[key] = nil
        ;
        app.synchronization.current[key] = nil
        ;
        app.synchronization.unsent[key] = true
    end
    for i = 1, total do
        local key = "~Terrain/Full/" .. i
        local value = {
            class = "PTTerrainChunk",
            name = "Full Terrain archive",
            parent = "@Workspace",
            props = {
                generation = generation,
                index = i,
                total = total,
                bytes = #raw,
                corner = {
                    extents.Min.X,
                    extents.Min.Y,
                    extents.Min.Z,
                },
                data = app.operations.base64Encode(raw:sub((i - 1) * size + 1, i * size)),
            },
        }
        app.terrainCache[key] = value
        ;
        app.synchronization.current[key] = value
        ;
        app.synchronization.unsent[key] = true
        if i % 8 == 0 then
            app.LoadUI.setLocal(true, "Packing all Terrain", "Preparing transfer parts", i, total)
            ;
            task.wait()
        end
    end
    app.synchronization.terrainQueue = {
    }
    ;
    app.synchronization.terrainHead = 1
    ;
    app.synchronization.terrainQueued = {
    }
    app.synchronization.terrainBulk = false
    ;
    app.synchronization.terrainTotal = 0
    ;
    app.synchronization.terrainDone = 0
    return total
end
function app.synchronization.receiveFullTerrain(key, value)
    if not value then
        app.terrainCache[key] = nil
        ;
        return 
    end
    local props = value.props
    if type(props) ~= "table" or type(props.generation) ~= "string" or type(props.total) ~= "number" or props.total &lt; 1 or props.total % 1 ~= 0 or type(props.index) ~= "number" or props.index % 1 ~= 0 or props.index &lt; 1 or props.index &gt; props.total or type(props.data) ~= "string" or #props.data &gt; 100 * 1024 or type(props.bytes) ~= "number" or props.bytes &lt; 1 or type(props.corner) ~= "table" or #props.corner ~= 3 then
        error("Invalid full Terrain part")
    end
    for i = 1, 3 do
        local n = props.corner[i]
        if type(n) ~= "number" or n % 1 ~= 0 or math.abs(n) &gt; 32000 then
            error("Invalid Terrain corner")
        end
    end
    if key ~= "~Terrain/Full/" .. props.index then
        error("Invalid Terrain archive key")
    end
    app.terrainCache[key] = app.operations.copy(value)
    if app.synchronization.terrainAppliedGeneration == props.generation then
        return 
    end
    local parts = {
    }
    for i = 1, props.total do
        local part = app.terrainCache["~Terrain/Full/" .. i]
        local q = part and part.props
        if not q or q.generation ~= props.generation then
            return 
        end
        if q.total ~= props.total or q.bytes ~= props.bytes or not app.operations.equal(q.corner, props.corner) then
            error("Inconsistent Terrain archive")
        end
        parts[i] = app.operations.base64Decode(q.data)
    end
    local raw = table.concat(parts)
    if #raw ~= props.bytes then
        error("Incomplete full Terrain archive")
    end
    if not app.Serialization then
        error("SerializationService unavailable")
    end
    local instances = app.Serialization:DeserializeInstancesAsync(buffer.fromstring(raw))
    local region = instances[1]
    if #instances ~= 1 or not region or not region:IsA("TerrainRegion") then
        for _, obj in ipairs(instances) do
            obj:Destroy()
        end
        error("Archive is not a TerrainRegion")
    end
    local terrain = workspace.Terrain
    local backup = terrain:CopyRegion(terrain.MaxExtents)
    local ok, err = pcall(function()
        terrain:PasteRegion(region, Vector3int16.new(table.unpack(props.corner)), true)
    end)
    region:Destroy()
    if not ok then
        pcall(function()
            terrain:PasteRegion(backup, terrain.MaxExtents.Min, true)
        end)
        backup:Destroy()
        ;
        error("Full Terrain apply failed: " .. tostring(err))
    end
    backup:Destroy()
    app.synchronization.terrainAppliedGeneration = props.generation
    -- Existing tracked areas must get a fresh voxel baseline after the full replacement.
    for chunk, origin in pairs(app.terrainKnown) do
        local v = app.operations.readTerrain(origin)
        app.terrainCache[chunk] = v
        ;
        app.synchronization.current[chunk] = v
        ;
        app.acknowledged[chunk] = app.operations.copy(v)
        ;
        app.synchronization.unsent[chunk] = nil
    end
end
function app.synchronization.terrainStep(initializing)
    local now = os.clock()
    if now &lt; app.synchronization.terrainNext then
        return 
    end
    app.synchronization.terrainNext = now + 0.1
    if app.synchronization.terrainHead &gt; #app.synchronization.terrainQueue then
        app.synchronization.terrainQueue = {
        }
        ;
        app.synchronization.terrainHead = 1
        ;
        app.synchronization.terrainQueued = {
        }
    end
    -- Same Copy must drain a finite baseline. Slow reads must not replenish
    -- the camera queue every second while connectSession waits for it.
    if not app.synchronization.terrainBulk and (not initializing or app.synchronization.terrainScanAt == 0) and now &gt;= app.synchronization.terrainScanAt then
        app.synchronization.terrainScanAt = now + 1
        local cam = workspace.CurrentCamera
        if cam then
            for _, pos in ipairs({
                cam.Focus.Position,
                cam.CFrame.Position,
            }) do
                local cx, cy, cz = math.floor(pos.X / app.CHUNK) * app.CHUNK, math.floor(pos.Y / app.CHUNK) * app.CHUNK, math.floor(pos.Z / app.CHUNK) * app.CHUNK
                for x = cx - app.CHUNK, cx + app.CHUNK, app.CHUNK do
                    for y = cy - app.CHUNK, cy + app.CHUNK, app.CHUNK do
                        for z = cz - app.CHUNK, cz + app.CHUNK, app.CHUNK do
                            if math.abs(x) &lt;= 127936 and math.abs(y) &lt;= 127936 and math.abs(z) &lt;= 127936 then
                                app.synchronization.queueTerrain({
                                    x,
                                    y,
                                    z,
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    -- Bounded batches avoid freezing Studio; known empty chunks remain watched.
    local deadline = os.clock() + 0.008
    for step = 1, 16 do
        local item = app.synchronization.terrainQueue[app.synchronization.terrainHead]
        local queued = item ~= nil
        if not item then
            local count = #app.synchronization.terrainOrigins
            if count == 0 then
                break
            end
            if app.synchronization.terrainCursor &gt; count then
                app.synchronization.terrainCursor = 1
            end
            local origin = app.synchronization.terrainOrigins[app.synchronization.terrainCursor]
            app.synchronization.terrainCursor = app.synchronization.terrainCursor + (1)
            item = {
                app.operations.terrainKey(table.unpack(origin)),
                origin,
            }
        end
        local key, origin = item[1], item[2]
        local ok, value = pcall(app.operations.readTerrain, origin)
        if not ok then
            app.warn(key .. ":read", "Terrain read failed: " .. tostring(value))
            if app.synchronization.terrainBulk or initializing then
                error("Terrain transfer stopped: " .. tostring(value))
            end
            app.synchronization.terrainNext = now + 1
            break
        end
        app.warnings[key .. ":read"] = nil
        if queued then
            app.synchronization.terrainHead = app.synchronization.terrainHead + (1)
            ;
            app.synchronization.terrainQueued[key] = nil
        end
        if not app.operations.equal(app.terrainCache[key], value) then
            app.terrainCache[key] = value
            ;
            app.synchronization.current[key] = value
            ;
            app.synchronization.unsent[key] = true
        end
        if queued and app.synchronization.terrainBulk then
            app.synchronization.terrainDone = app.synchronization.terrainDone + (1)
            if app.synchronization.terrainDone &gt;= app.synchronization.terrainTotal then
                app.synchronization.terrainBulk = false
            end
        end
        if os.clock() &gt;= deadline then
            break
        end
    end
end
function app.operations.terrainRecords()
    return app.terrainCache
end
function app.operations.applyTerrain(key, value)
    local ok, err = pcall(function()
        local origin = app.operations.terrainOrigin(key, value)
        if not app.terrainKnown[key] then
            app.terrainKnown[key] = origin
            ;
            app.synchronization.terrainOrigins[#app.synchronization.terrainOrigins + 1] = origin
        end
        app.operations.writeTerrain(origin, value)
        app.terrainCache[key] = app.operations.readTerrain(origin)
    end)
    if ok then
        app.warnings[key .. ":terrain"] = nil
    else
        app.warn(key .. ":terrain", "Terrain: " .. tostring(err))
    end
end
function app.operations.encode(v)
    local t = typeof(v)
    if t == "nil" then
        return {
            t = "Nil",
        }
    end
    if t == "string" or t == "boolean" then
        return v
    end
    if t == "number" then
        if v == v and math.abs(v) &lt; math.huge then
            return v
        end
        ;
        return nil
    end
    if t == "Vector3" or t == "Vector3int16" then
        return {
            t = t,
            v = {
                v.X,
                v.Y,
                v.Z,
            },
        }
    end
    if t == "Vector2" or t == "Vector2int16" then
        return {
            t = t,
            v = {
                v.X,
                v.Y,
            },
        }
    end
    if t == "Color3" then
        return {
            t = t,
            v = {
                v.R,
                v.G,
                v.B,
            },
        }
    end
    if t == "CFrame" then
        return {
            t = t,
            v = {
                v:GetComponents(),
            },
        }
    end
    if t == "UDim2" then
        return {
            t = t,
            v = {
                v.X.Scale,
                v.X.Offset,
                v.Y.Scale,
                v.Y.Offset,
            },
        }
    end
    if t == "UDim" then
        return {
            t = t,
            v = {
                v.Scale,
                v.Offset,
            },
        }
    end
    if t == "BrickColor" then
        return {
            t = t,
            v = v.Number,
        }
    end
    if t == "NumberRange" then
        return {
            t = t,
            v = {
                v.Min,
                v.Max,
            },
        }
    end
    if t == "Rect" then
        return {
            t = t,
            v = {
                v.Min.X,
                v.Min.Y,
                v.Max.X,
                v.Max.Y,
            },
        }
    end
    if t == "NumberSequence" then
        local a = {
        }
        ;
        for _, k in ipairs(v.Keypoints) do
            table.insert(a, {
                k.Time,
                k.Value,
                k.Envelope,
            })
        end
        ;
        return {
            t = t,
            v = a,
        }
    end
    if t == "ColorSequence" then
        local a = {
        }
        ;
        for _, k in ipairs(v.Keypoints) do
            table.insert(a, {
                k.Time,
                k.Value.R,
                k.Value.G,
                k.Value.B,
            })
        end
        ;
        return {
            t = t,
            v = a,
        }
    end
    if t == "PhysicalProperties" then
        return {
            t = t,
            v = {
                v.Density,
                v.Friction,
                v.Elasticity,
                v.FrictionWeight,
                v.ElasticityWeight,
            },
        }
    end
    if t == "Font" then
        return {
            t = t,
            v = {
                v.Family,
                v.Weight.Name,
                v.Style.Name,
            },
        }
    end
    if t == "Ray" then
        return {
            t = t,
            o = app.operations.encode(v.Origin),
            d = app.operations.encode(v.Direction),
        }
    end
    if t == "Axes" then
        return {
            t = t,
            v = {
                v.X,
                v.Y,
                v.Z,
            },
        }
    end
    if t == "Faces" then
        return {
            t = t,
            v = {
                v.Top,
                v.Bottom,
                v.Left,
                v.Right,
                v.Front,
                v.Back,
            },
        }
    end
    if t == "EnumItem" then
        return {
            t = t,
            e = tostring(v.EnumType):gsub("^Enum%.", ""),
            v = v.Name,
        }
    end
    if t == "Instance" then
        if not app.instanceKeys[v] and app.synchronization.inScope(v) then
            app.synchronization.register(v)
        end
        if app.instanceKeys[v] then
            return {
                t = t,
                v = app.instanceKeys[v],
            }
        end
        if v.Parent == game then
            return {
                t = "Service",
                v = v.ClassName,
            }
        end
        if v == workspace.Terrain then
            return {
                t = "Terrain",
            }
        end
        if v == workspace.CurrentCamera then
            return {
                t = "CurrentCamera",
            }
        end
        return nil
    end
    if t == "Content" then
        if v.SourceType == Enum.ContentSourceType.None then
            return {
                t = t,
                v = "",
            }
        end
        if v.SourceType == Enum.ContentSourceType.Uri then
            return {
                t = t,
                v = v.Uri,
            }
        end
        return nil
    end
    return nil
end
function app.operations.decode(v)
    if type(v) ~= "table" then
        return v
    end
    local t = v.t
    if t == "Nil" then
        return nil
    end
    if t == "Vector3" then
        return Vector3.new(table.unpack(v.v))
    end
    if t == "Vector3int16" then
        return Vector3int16.new(table.unpack(v.v))
    end
    if t == "Vector2" then
        return Vector2.new(table.unpack(v.v))
    end
    if t == "Vector2int16" then
        return Vector2int16.new(table.unpack(v.v))
    end
    if t == "Color3" then
        return Color3.new(table.unpack(v.v))
    end
    if t == "CFrame" then
        return CFrame.new(table.unpack(v.v))
    end
    if t == "UDim2" then
        return UDim2.new(table.unpack(v.v))
    end
    if t == "UDim" then
        return UDim.new(table.unpack(v.v))
    end
    if t == "BrickColor" then
        return BrickColor.new(v.v)
    end
    if t == "NumberRange" then
        return NumberRange.new(table.unpack(v.v))
    end
    if t == "Rect" then
        return Rect.new(table.unpack(v.v))
    end
    if t == "NumberSequence" then
        local a = {
        }
        ;
        for _, k in ipairs(v.v) do
            table.insert(a, NumberSequenceKeypoint.new(table.unpack(k)))
        end
        ;
        return NumberSequence.new(a)
    end
    if t == "ColorSequence" then
        local a = {
        }
        ;
        for _, k in ipairs(v.v) do
            table.insert(a, ColorSequenceKeypoint.new(k[1], Color3.new(k[2], k[3], k[4])))
        end
        ;
        return ColorSequence.new(a)
    end
    if t == "PhysicalProperties" then
        return PhysicalProperties.new(table.unpack(v.v))
    end
    if t == "Font" then
        return Font.new(v.v[1], Enum.FontWeight[v.v[2]], Enum.FontStyle[v.v[3]])
    end
    if t == "Ray" then
        return Ray.new(app.operations.decode(v.o), app.operations.decode(v.d))
    end
    if t == "Axes" then
        local a = {
        }
        ;
        for i, b in ipairs(v.v) do
            if b then
                table.insert(a, ({
                    Enum.Axis.X,
                    Enum.Axis.Y,
                    Enum.Axis.Z,
                })[i])
            end
        end
        ;
        return Axes.new(table.unpack(a))
    end
    if t == "Faces" then
        local a = {
        }
        ;
        for i, b in ipairs(v.v) do
            if b then
                table.insert(a, ({
                    Enum.NormalId.Top,
                    Enum.NormalId.Bottom,
                    Enum.NormalId.Left,
                    Enum.NormalId.Right,
                    Enum.NormalId.Front,
                    Enum.NormalId.Back,
                })[i])
            end
        end
        ;
        return Faces.new(table.unpack(a))
    end
    if t == "EnumItem" then
        return Enum[v.e][v.v]
    end
    if t == "Instance" then
        return app.instances[v.v]
    end
    if t == "Service" then
        return game:GetService(v.v)
    end
    if t == "Terrain" then
        return workspace.Terrain
    end
    if t == "CurrentCamera" then
        return workspace.CurrentCamera
    end
    if t == "Content" then
        return v.v == "" and Content.none or Content.fromUri(v.v)
    end
    error("Unknown type " .. tostring(t))
end
app.unionCache = setmetatable({
}, {
    __mode = "k",
})
function app.operations.resetUnionCache()
    app.unionCache = setmetatable({
    }, {
        __mode = "k",
    })
end
-- MeshSize/TriangleCount are read-only, but they change when the CSG geometry is rebuilt.
function app.operations.partOperationSignature(obj)
    local okSize, size = pcall(function()
        return obj.MeshSize
    end)
    local okCount, count = pcall(function()
        return obj.TriangleCount
    end)
    local parts = {
    }
    if okSize and typeof(size) == "Vector3" then
        table.insert(parts, string.format("%.4f/%.4f/%.4f", size.X, size.Y, size.Z))
    end
    if okCount and type(count) == "number" then
        table.insert(parts, tostring(count))
    end
    if #parts == 0 then
        return nil
    end
    return table.concat(parts, "/")
end
-- An operation created with Instance.new has no mesh at all. Sending or applying
-- such a blob would replace real geometry with nothing, so it is never synced.
function app.operations.hasGeometry(obj)
    local okSize, size = pcall(function()
        return obj.MeshSize
    end)
    if okSize and typeof(size) == "Vector3" then
        if math.abs(size.X) &gt; 0.001 or math.abs(size.Y) &gt; 0.001 or math.abs(size.Z) &gt; 0.001 then
            return true
        end
    end
    local okCount, count = pcall(function()
        return obj.TriangleCount
    end)
    return okCount and type(count) == "number" and count &gt; 0
end
function app.operations.serializePartOperation(obj)
    if not app.Serialization then
        app.warn((app.instanceKeys[obj] or "?") .. ":union", obj.Name .. ": SerializationService unavailable; CSG geometry cannot be sent")
        return nil
    end
    local signature = app.operations.partOperationSignature(obj)
    if signature == nil then
        app.warn((app.instanceKeys[obj] or "?") .. ":union", obj.Name .. ": CSG geometry cannot be read")
        return nil
    end
    if not app.operations.hasGeometry(obj) then
        return nil
    end
    local cached = app.unionCache[obj]
    if cached and cached.signature == signature then
        return cached.data
    end
    local ok, encoded = pcall(function()
        local data = app.Serialization:SerializeInstancesAsync({
            obj,
        })
        return app.operations.base64Encode(buffer.tostring(data))
    end)
    if not ok or type(encoded) ~= "string" then
        app.warn((app.instanceKeys[obj] or "?") .. ":union", obj.Name .. ": CSG geometry cannot be serialized")
        return nil
    end
    if #encoded &gt; 700 * 1024 then
        app.warn((app.instanceKeys[obj] or "?") .. ":union", obj.Name .. ": CSG geometry is too large to transfer; split it into smaller unions")
        return nil
    end
    app.unionCache[obj] = {
        signature = signature,
        data = encoded,
    }
    app.warnings[(app.instanceKeys[obj] or "?") .. ":union"] = nil
    return encoded
end
function app.operations.deserializePartOperation(data)
    if not app.Serialization or type(data) ~= "string" or data == "" then
        return nil
    end
    local ok, list = pcall(function()
        return app.Serialization:DeserializeInstancesAsync(buffer.fromstring(app.operations.base64Decode(data)))
    end)
    if not ok or type(list) ~= "table" then
        return nil
    end
    local obj = list[1]
    if not obj then
        return nil
    end
    -- Only the operation itself is needed; children are synced as separate records.
    for _, child in ipairs(obj:GetChildren()) do
        child:Destroy()
    end
    return obj
end
function app.operations.createInstance(value)
    if type(value.serialized) == "string" then
        local obj = app.operations.deserializePartOperation(value.serialized)
        if obj then
            if obj.ClassName == value.class then
                return obj, true
            end
            obj:Destroy()
        end
    end
    local ok, obj = pcall(Instance.new, value.class)
    if ok then
        return obj, false
    end
    return nil, false
end
app.denied = {

end)
app.previousAddress = app.base()
function app.operations.applyAddressFields(composed)
    if tostring(composed):match("^https?://") then
        app.address.Text = composed
        ;
        return 
    end
    local host, port = app.operations.splitAddress(composed or "")
    if host ~= "" then
        app.address.Text = host
        app.portField.Text = tostring(port or app.DEFAULT_PORT)
    end
end
function app.operations.switchServer()
    local newBase = app.base()
    if newBase == "" then
        app.status("Enter a server IP/host and port.")
        ;
        return 
    end
    if newBase == app.previousAddress then
        if not app.loggedIn and not app.busy then
            local ok, err = pcall(app.guestEnter)
            if not ok then
                app.status(tostring(err))
            end
        end
        return 
    end
    if app.active then
        app.operations.applyAddressFields(app.previousAddress)
        app.status("Leave the current session before changing the server address.")
        return 
    end
    if app.busy or app.inviting then
        app.operations.applyAddressFields(app.previousAddress)
        app.status("Please wait for the current operation to finish.")
        return 
    end
    app.previousAddress = newBase
    app.active = false
    ;
    app.synchronization.disconnect()
    ;
    app.loggedIn = false
    ;
    app.inbox = nil
    ;
    app.room.Text = ""
    ;
    app.token.Text = ""
    app.yes.Visible = false
    ;
    app.no.Visible = false
    app.owner:SetSetting("PTAddress", newBase)
    ;
    app.uiTab = "home"
    local ok, err = pcall(app.guestEnter)
    if not ok then
        app.status("Failed to connect to new server. " .. tostring(err))
    end
end
function app.operations.normalizeAddressFields()
    if app.address.Text:match("^https?://") then
        app.address.Text = app.address.Text:gsub("%s+", ""):gsub("/+$", "")
        ;
        return app.base()
    end
    local host, port = app.operations.splitAddress(app.address.Text)
    if host ~= "" then
        app.address.Text = host
    end
    if port then
        app.portField.Text = tostring(port)
    end
    local portNumber = tonumber((tostring(app.portField.Text or ""):gsub("%D", "")))
    if not portNumber or portNumber &lt; 1 or portNumber &gt; 65535 then
        app.portField.Text = tostring(app.DEFAULT_PORT)
    end
    return app.base()
end
app.address.FocusLost:Connect(function()
    local normalized = app.operations.normalizeAddressFields()
    if normalized ~= "" and normalized ~= app.previousAddress then
        app.operations.switchServer()
    end
end)
app.portField.FocusLost:Connect(function()
    local normalized = app.operations.normalizeAddressFields()
    if normalized ~= "" and normalized ~= app.previousAddress then
        app.operations.switchServer()
    end
end)
app.useLocal.MouseButton1Click:Connect(function()
    if app.busy or app.inviting then
        app.status("Please wait for the current operation to finish.")
        ;
        return 
    end
    app.address.Text = "localhost"
    app.portField.Text = tostring(app.DEFAULT_PORT)
    if app.base() == app.previousAddress then
        if not app.loggedIn then
            local ok, err = pcall(app.guestEnter)
            if not ok then
                app.status(tostring(err))
                ;
                return 
            end
        end
        app.status("Already using localhost. Host a session in one Studio and join with the code in the other.")
        return 
    end
    app.operations.switchServer()
end)

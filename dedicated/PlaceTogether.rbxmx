local roots = {"Workspace", "ReplicatedStorage", "ReplicatedFirst", "ServerScriptService", "ServerStorage", "StarterGui", "StarterPack", "StarterPlayer", "Teams", "MaterialService", "TextChatService", "Lighting", "SoundService"}

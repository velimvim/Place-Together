app.contentAliases = {
    Image = "ImageContent",
    Texture = "TextureContent",
    ColorMap = "ColorMapContent",
    NormalMap = "NormalMapContent",
    RoughnessMap = "RoughnessMapContent",
    MetalnessMap = "MetalnessMapContent",
}
function app.operations.properties(obj)
    local class = obj.ClassName
    if app.propertyCache[class] then
        return app.propertyCache[class]
    end
    local list = {
    }
    ;
    local seen = {
    }
    local function add(name)
        if not seen[name] and not app.denied[name] and not app.physics[name] then
            local modern = app.contentAliases[name]
            if modern then
                local readable, value = pcall(function()
                    return obj[modern]
                end)
                ;
                if readable and typeof(value) == "Content" then
                    return 
                end
            end
            if obj:IsA("BasePart") and (name == "Position" or name == "Orientation" or name == "Rotation" or name == "BrickColor" or name == "CollisionGroupId") then
                return 
            end
            if obj:IsA("BaseScript") and name == "Enabled" then
                return 
            end
            if name == "MeshContent" or name == "MeshSize" or name == "MeshId" or name == "CollisionFidelity" or name == "RenderFidelity" or name == "FluidFidelity" then
                if obj:IsA("MeshPart") then
                    return 
                end
            end
            seen[name] = true
            ;
            table.insert(list, name)
        end
    end
    local ok, info = pcall(function()
        return app.Reflection:GetPropertiesOfClass(class, {
            ExcludeDisplay = true,
        })
    end)
    if ok and info then
        for _, p in ipairs(info) do
            if (p.Serialized or app.publicEdit[p.Name]) and p.Permits and p.Permits.Write ~= nil then
                add(p.Name)
            end
        end
    end
    for _, group in ipairs({
        app.common,
        app.props,
    }) do
        for _, name in ipairs(group) do
            local good = pcall(function()
                return obj[name]
            end)
            ;
            if good then
                add(name)
            end
        end
    end
    for _, name in ipairs(app.appearanceProps) do
        local good = pcall(function()
            return obj[name]
        end)
        ;
        if good then
            add(name)
        end
    end
    app.propertyCache[class] = list
    ;
    return list
end
function app.operations.eligible(obj)
    if obj == app.entry or obj == workspace.CurrentCamera or obj:IsA("Camera") or obj:IsA("Terrain") then
        return false
    end
    if obj:IsA("AccessoryWeld") or (obj:IsA("Weld") and obj.Name == "AccessoryWeld") then
        return false
    end
    if obj:IsDescendantOf(app.entry) then
        return false
    end
    local node = obj
    while node and node ~= game do
        if node:GetAttribute("PT_Internal") == true then
            return false
        end
        node = node.Parent
    end
    return true
end
function app.synchronization.inScope(obj)
    if not app.operations.eligible(obj) then
        return obj == workspace.Terrain
    end
    local p = obj
    while p and p.Parent ~= game do
        p = p.Parent
    end
    return p ~= nil and app.serviceIds["@" .. p.ClassName] == true
end
function app.synchronization.watch(obj)
    if app.synchronization.watches[obj] then
        return 
    end
    app.synchronization.watchHandle(obj)
    local allowed = app.synchronization.allowed[obj.ClassName]
    if not allowed then
        allowed = {
            Name = true,
            Parent = true,
            Source = true,
            WorldPivot = true,
            Scale = true,
        }
        for _, name in ipairs(app.operations.properties(obj)) do
            allowed[name] = true
        end
        if obj:IsA("PartOperation") then
            allowed.MeshSize = true
            ;
            allowed.TriangleCount = true
        end
        if obj:IsA("ValueBase") then
            allowed.Value = true
        end
        app.synchronization.allowed[obj.ClassName] = allowed
    end
    local list = {
    }
    if obj:IsA("ValueBase") then
        table.insert(list, obj.Changed:Connect(function()
            app.synchronization.mark(obj)
        end))
        table.insert(list, obj:GetPropertyChangedSignal("Name"):Connect(function()
            app.synchronization.mark(obj)
        end))
    else
        table.insert(list, obj.Changed:Connect(function(name)
            if allowed[name] then
                app.synchronization.mark(obj)
            end
        end))
    end
    table.insert(list, obj.AncestryChanged:Connect(function()
        app.synchronization.mark(obj)
    end))
    table.insert(list, obj.AttributeChanged:Connect(function(name)
        if name ~= "PT_ObjectId" and name ~= "PT_SavedRoom" and name ~= "PT_SavedServer" then
            app.synchronization.mark(obj)
        end
    end))
    -- Tags is not a normal reflected property, but has a property change signal.
    local ok, signal = pcall(function()
        return obj:GetPropertyChangedSignal("Tags")
    end)
    if ok then
        table.insert(list, signal:Connect(function()
            app.synchronization.mark(obj)
        end))
    end
    if obj:IsA("Animator") then
        local okAnim, played = pcall(function()
            return obj.AnimationPlayed
        end)
        if okAnim and played then
            table.insert(list, played:Connect(function()
                local rig = app.operations.rigOf(obj)
                ;
                if rig then
                    app.synchronization.animationUntil[rig] = os.clock() + 2.5
                end
            end))
        end
    end
    if obj:IsA("Motor6D") then
        local okTransform, transform = pcall(function()
            return obj:GetPropertyChangedSignal("Transform")
        end)
        if okTransform and transform then
            table.insert(list, transform:Connect(function()
                local rig = app.operations.rigOf(obj)
                ;
                if rig then
                    app.synchronization.animationUntil[rig] = os.clock() + 2
                end
            end))
        end
    end
    app.synchronization.watches[obj] = list
end
function app.synchronization.register(obj, key)
    if app.instanceKeys[obj] then
        app.synchronization.watch(obj)
        ;
        return app.instanceKeys[obj]
    end
    if obj.Parent and obj.Parent ~= game and not app.instanceKeys[obj.Parent] and app.operations.eligible(obj.Parent) then
        app.synchronization.register(obj.Parent)
    end
    key = key or obj:GetAttribute("PT_ObjectId")
    if type(key) ~= "string" or key == "" or #key &gt; 512 or app.serviceIds[key] or key:sub(1, 9) == "~Terrain/" or app.instances[key] then
        key = app.http:GenerateGUID(false)
    end
    app.instances[key] = obj
    ;
    app.instanceKeys[obj] = key
    obj:SetAttribute("PT_ObjectId", key)
    app.synchronization.watch(obj)
    ;
    app.synchronization.mark(obj, true)
    return key
end
function app.synchronization.attach()
    app.synchronization.enabled = true
    app.synchronization.attachInput()
    for _, name in ipairs(app.roots) do
        local svc = game:GetService(name)
        table.insert(app.synchronization.connections, svc.DescendantAdded:Connect(function(obj)
            if app.operations.eligible(obj) then
                app.synchronization.mark(obj)
                ;
                app.synchronization.noteInsert(obj)
            end
        end))
        table.insert(app.synchronization.connections, svc.DescendantRemoving:Connect(function(obj)
            app.synchronization.mark(obj)
        end))
    end
    table.insert(app.synchronization.connections, app.editor.TextDocumentDidChange:Connect(function(doc)
        local ok, obj = pcall(function()
            return doc:GetScript()
        end)
        if ok and obj then
            app.synchronization.mark(obj)
        end
    end))
end
-- Explicit frames keep deeply nested places off the Lua call stack. Yield for
-- every visited node, including ignored objects and parents before descent.
function app.synchronization.walkLocalObjects(roots, visit)
    for _, root in ipairs(roots) do
        local stack = {{children = root.node:GetChildren(), next = 1, parentId = root.key, counts = {}}}
        while #stack &gt; 0 do
            local frame = stack[#stack]
            local obj = frame.children[frame.next]
            if not obj then
                stack[#stack] = nil
            else
                frame.next = frame.next + 1
                if app.operations.eligible(obj) then
                    local stem = obj.ClassName .. ":" .. obj.Name
                    frame.counts[stem] = (frame.counts[stem] or 0) + 1
                    local key = visit(obj, frame.parentId, stem, frame.counts[stem])
                    stack[#stack + 1] = {children = obj:GetChildren(), next = 1, parentId = key, counts = {}}
                end
                app.synchronization.budget()
            end
        end
    end
end
function app.synchronization.preparationProgress(title, detail, done, total, force)
    if not app.synchronization.preparing then return end
    local now = os.clock()
    if force or title ~= app.synchronization.prepareTitle or now &gt;= (app.synchronization.prepareUpdateAt or 0) then
        app.synchronization.prepareTitle = title
        app.synchronization.prepareUpdateAt = now + 0.1
        app.LoadUI.setLocal(true, title, detail, done, total)
    end
end
function app.index()
    app.features.restoreEpoch = nil
    app.features.forceRestore = nil
    app.synchronization.disconnect()
    ;
    app.currentRevision = 0
    app.instances = {
    }
    ;
    app.instanceKeys = {
    }
    ;
    app.acknowledged = {
    }
    ;
    app.remoteVersions = {
    }
    ;
    app.pending = {
    }
    ;
    app.meshRetry = {
    }
    ;
    app.referenceRetry = {
    }
    ;
    app.appearanceRetry = {
    }
    ;
    app.warnings = {
    }
    app.synchronization.current = {
    }
    ;
    app.synchronization.dirty = {
    }
    ;
    app.synchronization.unsent = {
    }
    ;
    app.synchronization.queue = {
    }
    ;
    app.synchronization.head = 1
    app.synchronization.retryRecords = {
    }
    ;
    app.synchronization.retryAt = {
    }
    ;
    app.synchronization.retryExpected = {
    }
    ;
    app.synchronization.retryRemote = {
    }
    ;
    app.synchronization.sliceAt = os.clock()
    ;
    app.synchronization.generation = app.synchronization.generation + (1)
    app.synchronization.deferred = {
    }
    ;
    app.synchronization.deferredRevision = 0
    ;
    app.synchronization.inFlight = 0
    ;
    app.synchronization.sending = false
    ;
    app.synchronization.lastEditAt = 0
    ;
    app.synchronization.releasedAt = 0
    app.rigCache = setmetatable({
    }, {
        __mode = "k",
    })
    ;
    app.synchronization.animationUntil = {
    }
    ;
    app.synchronization.rigBurst = {
    }
    ;
    app.synchronization.animCheck = {
    }
    app.operations.terrainReset()
    ;
    app.operations.resetUnionCache()
    ;
    app.synchronization.attach()
    local roots = {}
    for _, name in ipairs(app.roots) do
        local svc = game:GetService(name)
        roots[#roots + 1] = {node = svc, key = "@" .. name}
    end
    local total, done = 0, 0
    app.synchronization.preparationProgress("Counting local objects", "Finding objects before indexing. No map upload.", 0, 0, true)
    app.synchronization.walkLocalObjects(roots, function()
        total = total + 1
        app.synchronization.preparationProgress("Counting local objects", string.format("Found %d objects. Counting continues; no map upload.", total), total, 0)
    end)
    app.synchronization.preparationProgress("Indexing local objects", "Assigning object IDs and attaching change listeners.", 0, total, true)
    for _, root in ipairs(roots) do
        local svc, name = root.node, root.key
        ;
        app.instances[name] = svc
        ;
        app.instanceKeys[svc] = name
        app.synchronization.watch(svc)
        ;
        app.synchronization.mark(svc)
    end
    app.synchronization.walkLocalObjects(roots, function(obj, parentId, stem, ordinal)
        local key = obj:GetAttribute("PT_ObjectId")
        if type(key) ~= "string" or key == "" or #key &gt; 512 or app.serviceIds[key] or key:sub(1, 9) == "~Terrain/" or app.instances[key] then
            key = parentId .. "/" .. app.http:UrlEncode(stem) .. ":" .. ordinal
            if #key &gt; 480 then key = app.http:GenerateGUID(false) end
        end
        key = app.synchronization.register(obj, key)
        done = done + 1
        total = math.max(total, done)
        app.synchronization.preparationProgress("Indexing local objects", string.format("%d / %d objects | Current: %s", done, total, obj.Name:sub(1, 80)), done, total)
        return key
    end)
    app.synchronization.preparationProgress("Indexing local objects", string.format("Indexed %d objects. Preparing their initial state next.", done), done, done, true)
    app.instances["@Terrain"] = workspace.Terrain
    ;
    app.instanceKeys[workspace.Terrain] = "@Terrain"
    ;
    app.serviceIds["@Terrain"] = true
    app.synchronization.watch(workspace.Terrain)
    ;
    app.synchronization.mark(workspace.Terrain)
end
function app.capture(obj, key)
    local ancestor = obj
    while ancestor and ancestor ~= game do
        if app.features.previews[app.instanceKeys[ancestor]] and app.synchronization.current[key] then
            return app.operations.copy(app.synchronization.current[key])
        end
        ancestor = ancestor.Parent
    end
    local p = {
    }
    for _, property in ipairs(app.operations.properties(obj)) do
        local ok, value = pcall(function()
            return app.operations.encode(obj[property])
        end)
        if ok and value ~= nil then
            p[property] = value
        end
        if ok and value == nil and app.appearanceSet[property] then
            app.warn(key .. ":content:" .. property, obj.Name .. "." .. property .. ": local EditableImage cannot be sent as URI; image must be published")
        else
            app.warnings[key .. ":content:" .. property] = nil
        end
    end
    if obj:IsA("Accessory") then
        p.WorldPivot = nil
    elseif obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Accessory") then
        p.CFrame = nil
        ;
        p.Position = nil
        ;
        p.Orientation = nil
        ;
        p.Rotation = nil
        ;
        p.WorldPivot = nil
    end
    local rig = app.operations.rigOf(obj)
    local animating = rig and app.synchronization.rigAnimating(rig)
    if animating then
        if obj:IsA("Model") and obj == rig then
            p.WorldPivot = nil
        elseif obj:IsA("BasePart") and obj ~= rig.PrimaryPart and obj.Name ~= "HumanoidRootPart" then
            p.CFrame = nil
            ;
            p.Position = nil
            ;
            p.Orientation = nil
            ;
            p.Rotation = nil
            ;
            p.WorldPivot = nil
        end
    end
    if obj:IsA("Model") and not p.WorldPivot and not obj:IsA("Accessory") and not (animating and obj == rig) then
        pcall(function()
            p.WorldPivot = app.operations.encode(obj:GetPivot())
        end)
    end
    if obj:IsA("LuaSourceContainer") then
        local ok, text = pcall(function()
            return app.editor:GetEditorSource(obj)
        end)
        if not ok then
            ok, text = pcall(function()
                return obj.Source
            end)
        end
        if ok then
            p.Source = text:gsub(string.char(13, 10), string.char(10)):gsub(string.char(13), string.char(10))
            ;
            app.warnings[key .. ":Source"] = nil
        else
            app.warn(key .. ":Source", obj.Name .. ": cannot access script source")
        end
    end
    if obj:IsA("MeshPart") then
        for _, name in ipairs({
            "MeshId",
            "MeshContent",
            "CollisionFidelity",
            "RenderFidelity",
            "FluidFidelity",
        }) do
            local ok, v = pcall(function()
                return app.operations.encode(obj[name])
            end)
            ;
            if ok and v then
                p[name] = v
            end
        end
    end
    local attrs = {
    }
    ;
    for name, value in pairs(obj:GetAttributes()) do
        if name ~= "PT_ObjectId" and name ~= "PT_SavedRoom" and name ~= "PT_SavedServer" then
            local v = app.operations.encode(value)
            ;
            if v ~= nil then
                attrs[name] = v
            end
        end
    end
    local tags = app.Collection:GetTags(obj)
    ;
    table.sort(tags)
    local tbAssetId = 0
    if obj:IsA("Model") then
        pcall(function()
            if obj.SourceAssetId and obj.SourceAssetId &gt; 0 then
                tbAssetId = obj.SourceAssetId
            end
        end)
        if tbAssetId == 0 then
            local attrId = obj:GetAttribute("SourceAssetId") or obj:GetAttribute("AssetId") or obj:GetAttribute("ToolboxAssetId")
            if tonumber(attrId) then
                tbAssetId = tonumber(attrId)
            end
        end
    end
    local serialized
    if obj:IsA("PartOperation") then
        serialized = app.operations.serializePartOperation(obj)
    end
    return {
        class = obj.ClassName,
        name = obj.Name,
        parent = app.instanceKeys[obj.Parent] or "@game",
        props = p,
        attributes = attrs,
        tags = tags,
        modelScale = obj:IsA("Model") and obj:GetScale() or nil,
        isToolbox = false,
        assetId = tbAssetId,
        serialized = serialized,
    }
end
function app.synchronization.refresh(obj)
    local key = app.instanceKeys[obj]
    if not app.synchronization.inScope(obj) then
        if key and not app.serviceIds[key] then
            app.synchronization.current[key] = nil
            ;
            app.synchronization.unsent[key] = true
        end
        return 
    end
    if not key then
        local chain = {
        }
        ;
        local p = obj
        while p and not app.instanceKeys[p] and p ~= game do
            table.insert(chain, p)
            ;
            p = p.Parent
        end
        for i = #chain, 1, -1 do
            if app.operations.eligible(chain[i]) then
                app.synchronization.register(chain[i])
            end
        end
        key = app.instanceKeys[obj]
    end
    if not key then
        return 
    end
    local ok, value = pcall(app.capture, obj, key)
    if ok then
        app.synchronization.current[key] = value
        ;
        app.synchronization.captured = app.synchronization.captured + (1)
        if not app.operations.equal(value, app.acknowledged[key]) then
            app.synchronization.unsent[key] = true
        else
            app.synchronization.unsent[key] = nil
        end
        app.warnings[key .. ":capture"] = nil
    else
        app.warn(key .. ":capture", obj.Name .. ": cannot read object; outgoing record preserved")
    end
end
function app.synchronization.drain(force)
    if not force and app.synchronization.holdReason() then
        return 
    end
    app.synchronization.sliceAt = os.clock()
    local finish = #app.synchronization.queue
    local first = app.synchronization.head
    local total = math.max(0, finish - first + 1)
    app.synchronization.preparationProgress("Reading initial object state", "Reading local properties; large meshes and unions can take longer.", 0, total, true)
    while app.synchronization.head &lt;= finish do
        if not force and app.synchronization.holdReason() then
            break
        end
        local obj = app.synchronization.queue[app.synchronization.head]
        ;
        app.synchronization.queue[app.synchronization.head] = false
        ;
        app.synchronization.head = app.synchronization.head + (1)
        app.synchronization.refresh(obj)
        ;
        app.synchronization.dirty[obj] = nil
        local done = app.synchronization.head - first
        app.synchronization.preparationProgress("Reading initial object state", string.format("%d / %d objects | Current: %s", done, total, obj.Name:sub(1, 80)), done, total)
        ;
        app.synchronization.budget()
    end
    app.synchronization.preparationProgress("Reading initial object state", "Initial property pass finished.", app.synchronization.head - first, total, true)
    if app.synchronization.head &gt; #app.synchronization.queue then
        app.synchronization.queue = {
        }
        ;
        app.synchronization.head = 1
    end
end
function app.operations.snapshot(force)
    app.synchronization.drain(force)
    return app.synchronization.current
end
function app.request(method, payload, renewed, full)
    local t0 = os.clock()
    local reqUrl = app.endpoint
    if method == "GET" then
        reqUrl = reqUrl .. (reqUrl:find("?") and "&amp;" or "?") .. "_t=" .. tostring(os.clock())
        if not full and app.currentRevision and app.currentRevision &gt; 0 then
            reqUrl = reqUrl .. "&amp;since=" .. tostring(app.currentRevision)
        end
    end
    local response = app.http:RequestAsync({
        Url = reqUrl,
        Method = method,
        Headers = {
            Authorization = "Bearer " .. app.credential,
            ["Content-Type"] = "application/json",
            ["bypass-tunnel-reminder"] = "true",
            ["X-PT-Secret"] = app.features.secret and app.features.secret.Text or (app.owner:GetSetting("PTServerSecret") or ""),
        },
        Body = payload and app.http:JSONEncode(payload) or nil,
    })
    if response.StatusCode == 401 and app.guestEnter and not renewed then
        app.guestEnter()
        ;
        return app.request(method, payload, true, full)
    end
    local decoded, value = pcall(function()
        return app.http:JSONDecode(response.Body)
    end)
    if decoded and type(value) == "table" and value.restoreEpoch then
        if app.features.restoreEpoch and value.restoreEpoch &gt; app.features.restoreEpoch then
            app.features.forceRestore = true
            ;
            app.synchronization.terrainAppliedGeneration = nil
        end
        app.features.restoreEpoch = value.restoreEpoch
    end
    if not decoded then
        error("Server returned invalid response (HTTP " .. response.StatusCode .. "). Retrying...")
    end
    if response.StatusCode == 409 and method == "POST" then
        value.conflict = true
        ;
        return value
    end
    if response.StatusCode == 423 and method == "POST" then
        value.conflict = true
        ;
        value.locked = true
        ;
        return value
    end
    if not response.Success then
        error(value.error or ("HTTP " .. response.StatusCode))
    end
    return value
end
function app.operations.meshSource(value)
    local p = value.props
    if type(p.MeshId) == "string" and p.MeshId ~= "" then
        return Content.fromUri(p.MeshId)
    end
    if p.MeshContent and p.MeshContent.t == "Content" and p.MeshContent.v ~= "" then
        return app.operations.decode(p.MeshContent)
    end
    return nil
end
function app.operations.loadMesh(obj, key, value)
    if not obj:IsA("MeshPart") then
        return 
    end
    local source = app.operations.meshSource(value)
    ;
    if not source then
        return 
    end
    local p = value.props
    local ok, current = pcall(function()
        return obj.MeshId
    end)
    if ok and type(p.MeshId) == "string" and current == p.MeshId then
        return 
    end
    if app.meshRetry[key] and app.meshRetry[key] &gt; os.clock() then
        return 
    end
    local success, err = pcall(function()
        local options = {
        }
        ;
        for _, name in ipairs({
            "CollisionFidelity",
            "RenderFidelity",
            "FluidFidelity",
        }) do
            if p[name] then
                options[name] = app.operations.decode(p[name])
            end
        end
        local fresh = app.Assets:CreateMeshPartAsync(source, options)
        ;
        if not fresh then
            error("Roblox did not return mesh geometry")
        end
        obj:ApplyMesh(fresh)
        ;
        fresh:Destroy()
    end)
    if success then
        app.meshRetry[key] = nil
        ;
        app.warnings[key .. ":mesh"] = nil
    else
        app.meshRetry[key] = os.clock() + 15
        ;
        app.warn(key .. ":mesh", value.name .. ": Roblox refused to load mesh; other parts continue syncing")
    end
end
function app.synchronization.write(obj, callback)
    return pcall(callback)
end
function app.synchronization.defer(remote, revision)
    for key, record in pairs(remote) do
        if not app.synchronization.deferred[key] or record.version &gt;= app.synchronization.deferred[key].version then
            app.synchronization.deferred[key] = record
        end
    end
    app.synchronization.deferredRevision = math.max(app.synchronization.deferredRevision, revision or 0)
end
function app.operations.applyRecords(remote, sent, force)
    if type(remote) ~= "table" then
        error("Invalid sync records")
    end
    local changed = {
    }
    app.synchronization.sliceAt = os.clock()
    for key, record in pairs(remote) do
        if type(record) ~= "table" or type(record.version) ~= "number" then
            error("Invalid object revision")
        end
        if force or app.remoteVersions[key] ~= record.version or app.pending[key] or app.synchronization.retryRecords[key] then
            changed[key] = record
            local v = record.value
            if v and v.class ~= "PTTerrainChunk" and not app.instances[key] and not app.serviceIds[key] then
                local obj, fromBlob = app.operations.createInstance(v)
                if obj then
                    obj:SetAttribute("PT_ObjectId", key)
                    ;
                    app.instances[key] = obj
                    ;
                    app.instanceKeys[obj] = key
                    if fromBlob and type(v.serialized) == "string" and obj:IsA("PartOperation") then
                        app.unionCache[obj] = {
                            signature = app.operations.partOperationSignature(obj),
                            data = v.serialized,
                        }
                    end
                    app.synchronization.watch(obj)
                    ;
                    app.pending[key] = nil
                    ;
                    app.warnings[key .. ":create"] = nil
                else
                    app.pending[key] = true
                    ;
                    app.warn(key .. ":create", v.name .. ": class cannot be created via API")
                end
            end
        end
        app.synchronization.budget()
    end
    -- Parent-first order is necessary: a freshly created child may otherwise appear
    -- outside the synced services while its detached parent is still being attached.
    local order, visited, visiting = {
    }, {
    }, {
    }
    local function visit(key)
        if visited[key] then
            return 
        end
        if visiting[key] then
            error("Cyclic sync hierarchy")
        end
        visiting[key] = true
        local r = changed[key]
        ;
        local v = r and r.value
        if v and changed[v.parent] then
            visit(v.parent)
        end
        visiting[key] = nil
        ;
        visited[key] = true
        ;
        table.insert(order, key)
    end
    for key in pairs(changed) do
        visit(key)
        ;
        app.synchronization.budget()
    end
    local grouped = {
    }
    for rank = 0, 2 do
        for _, key in ipairs(order) do
            local r = key:sub(1, 14) == "~Terrain/Full/" and 0 or (key:sub(1, 9) == "~Terrain/" and 2 or 1)
            if r == rank then
                grouped[#grouped + 1] = key
            end
        end
    end
    order = grouped
    for _, key in ipairs(order) do
        if not force and app.synchronization.ready and (app.synchronization.inputHeld() or app.synchronization.paused) then
            return false
        end
        local record = changed[key]
        ;
        local obj = app.instances[key]
        app.features.previews[key] = nil
        if app.features.smoothTargets then
            app.features.smoothTargets[key] = nil
        end
        local before = app.synchronization.current[key]
        if obj and app.synchronization.inScope(obj) then
            app.synchronization.refresh(obj)
            ;
            before = app.synchronization.current[key]
        end
        local retryBase = app.acknowledged[key]
        local remoteValue = record.value
        if app.synchronization.retryRecords[key] == record then
            retryBase = app.synchronization.retryExpected[key]
            ;
            remoteValue = app.synchronization.retryRemote[key]
        end
        local desired
        if force then
            desired = app.operations.copy(record.value)
        else
            desired = app.operations.merge(retryBase, before, record.value)
        end
        local retry, sourceRaced, unionBlocked = false, false, false
        if not desired and obj and not force and not app.serviceIds[key] then
            for _, child in ipairs(obj:GetDescendants()) do
                local id = app.instanceKeys[child]
                if id then
                    if app.synchronization.dirty[child] then
                        app.synchronization.refresh(child)
                    end
                    if not app.operations.equal(app.synchronization.current[id], app.acknowledged[id]) then
                        desired = before
                        ;
                        break
                    end
                end
                app.synchronization.budget()
            end
        end
        if key:sub(1, 14) == "~Terrain/Full/" then
            desired = app.operations.copy(record.value)
            app.synchronization.receiveFullTerrain(key, desired)
            app.synchronization.current[key] = app.operations.copy(desired)
        elseif key:sub(1, 9) == "~Terrain/" and (not record.value or (record.value.props.generation and record.value.props.generation ~= app.synchronization.terrainAppliedGeneration)) then
            desired = app.operations.copy(app.synchronization.current[key])
        elseif key:sub(1, 9) == "~Terrain/" then
            if not force then
                local origin = app.operations.terrainOrigin(key, record.value)
                if origin then
                    local ok, localValue = pcall(app.operations.readTerrain, origin)
                    if not ok then
                        error("Cannot read incoming Terrain chunk")
                    end
                    desired = app.synchronization.mergeTerrain(key, app.acknowledged[key], localValue, record.value)
                end
            end
            app.operations.applyTerrain(key, desired)
            if app.warnings[key .. ":terrain"] then
                error(app.warnings[key .. ":terrain"])
            end
            app.synchronization.current[key] = app.operations.copy(app.terrainCache[key])
        elseif desired and obj then
            local ok = app.synchronization.write(obj, function()
                if obj.Name ~= desired.name then
                    obj.Name = desired.name
                end
                if not app.serviceIds[key] then
                    local parent = app.instances[desired.parent]
                    if not parent then
                        error("Parent unavailable")
                    end
                    if obj.Parent ~= parent then
                        obj.Parent = parent
                    end
                end
            end)
            app.pending[key] = not ok or nil
            if not ok then
                retry = true
                ;
                app.warn(key .. ":parent", desired.name .. ": waiting for parent")
            else
                app.warnings[key .. ":parent"] = nil
                if obj:IsA("PartOperation") and type(desired.serialized) == "string" then
                    local cached = app.unionCache[obj]
                    if not cached or cached.data ~= desired.serialized then
                        local fresh = app.operations.deserializePartOperation(desired.serialized)
                        if fresh then
                            local applied = pcall(function()
                                obj:SubstituteGeometry(fresh)
                            end)
                            if applied then
                                app.unionCache[obj] = {
                                    signature = app.operations.partOperationSignature(obj),
                                    data = desired.serialized,
                                }
                                ;
                                app.warnings[key .. ":union"] = nil
                            else
                                unionBlocked = true
                                ;
                                app.warn(key .. ":union", desired.name .. ": cannot apply CSG geometry")
                            end
                        else
                            unionBlocked = true
                            app.warn(key .. ":union", desired.name .. ": received CSG geometry cannot be restored")
                        end
                        if fresh then
                            fresh:Destroy()
                        end
                    end
                end
                if obj:IsA("Model") and type(desired.modelScale) == "number" and desired.modelScale &gt; 0 then
                    local scaled, reason = pcall(function()
                        if math.abs(obj:GetScale() - desired.modelScale) &gt; 1e-07 then
                            obj:ScaleTo(desired.modelScale)
                        end
                    end)
                    if not scaled then
                        app.warn(key .. ":scale", tostring(reason))
                    end
                end
                if obj:IsA("MeshPart") then
                    local preMeshOK, preMesh = pcall(app.capture, obj, key)
                    app.operations.loadMesh(obj, key, desired)
                    if app.meshRetry[key] then
                        retry = true
                    end
                    if not force then
                        local captured, fresh = pcall(app.capture, obj, key)
                        if captured and preMeshOK then
                            desired = app.operations.merge(preMesh, fresh, desired)
                            ;
                            before = fresh
                        end
                    end
                end
                local suppressTransform = obj:IsA("Accessory") or (obj.Parent and obj.Parent:IsA("Accessory"))
                local rig = app.operations.rigOf(obj)
                if rig and app.synchronization.rigAnimating(rig) then
                    if obj:IsA("Model") and obj == rig then
                        suppressTransform = true
                    elseif obj:IsA("BasePart") and obj ~= rig.PrimaryPart and obj.Name ~= "HumanoidRootPart" then
                        suppressTransform = true
                    end
                end
                local values = {
                }
                for name, value in pairs(desired.props or {
                }) do
                    local skip = obj:IsA("MeshPart") and (name == "MeshId" or name == "MeshContent" or name == "CollisionFidelity" or name == "RenderFidelity" or name == "FluidFidelity")
                    if suppressTransform and (name == "CFrame" or name == "WorldPivot" or name == "Position" or name == "Orientation" or name == "Rotation") then
                        skip = true
                    end
                    if not skip then
                        table.insert(values, {
                            name,
                            value,
                        })
                    end
                end
                local function priority(pair)
                    local name, value = pair[1], pair[2]
                    if name == "Shape" then
                        return 0
                    end
                    if name == "Part0" or name == "Part1" or name == "Attachment0" or name == "Attachment1" or name == "PrimaryPart" then
                        return 1
                    end
                    if name == "C0" or name == "C1" or name == "Size" then
                        return 2
                    end
                    if name == "CFrame" or name == "WorldPivot" then
                        return 3
                    end
                    if type(value) == "table" and value.t == "Instance" then
                        return 4
                    end
                    if name == "Source" then
                        return 5
                    end
                    return 1
                end
                table.sort(values, function(a, b)
                    local aa, bb = priority(a), priority(b)
                    ;
                    if aa == bb then
                        return a[1] &lt; b[1]
                    end
                    ;
                    return aa &lt; bb
                end)
                local sourceValue
                for _, pair in ipairs(values) do
                    local name, value = pair[1], pair[2]
                    local success = pcall(function()
                        if type(value) == "table" and value.t == "Instance" and not app.instances[value.v] then
                            retry = true
                            ;
                            error("Linked instance unavailable")
                        end
                        if name == "Source" and obj:IsA("LuaSourceContainer") then
                            sourceValue = value
                        elseif obj:IsA("Model") and (name == "CFrame" or name == "WorldPivot") then
                            if not app.operations.equal(app.operations.encode(obj:GetPivot()), value) then
                                obj:PivotTo(app.operations.decode(value))
                            end
                        elseif not app.operations.equal(app.operations.encode(obj[name]), value) then
                            obj[name] = app.operations.decode(value)
                        end
                    end)
                    if success then
                        app.warnings[key .. ":" .. name] = nil
                    else
                        app.warn(key .. ":" .. name, desired.name .. "." .. name .. ": unavailable via API")
                    end
                end
                local attrs = desired.attributes or {
                }
                for name in pairs(obj:GetAttributes()) do
                    if name ~= "PT_ObjectId" and name ~= "PT_SavedRoom" and name ~= "PT_SavedServer" and attrs[name] == nil then
                        pcall(function()
                            obj:SetAttribute(name, nil)
                        end)
                    end
                end
                for name, value in pairs(attrs) do
                    if name ~= "PT_ObjectId" and name ~= "PT_SavedRoom" and name ~= "PT_SavedServer" then
                        pcall(function()
                            if not app.operations.equal(app.operations.encode(obj:GetAttribute(name)), value) then
                                obj:SetAttribute(name, app.operations.decode(value))
                            end
                        end)
                    end
                end
                local tags = {
                }
                for _, tag in ipairs(desired.tags or {
                }) do
                    tags[tag] = true
                    ;
                    if not app.Collection:HasTag(obj, tag) then
                        app.Collection:AddTag(obj, tag)
                    end
                end
                for _, tag in ipairs(app.Collection:GetTags(obj)) do
                    if not tags[tag] then
                        app.Collection:RemoveTag(obj, tag)
                    end
                end
                if sourceValue ~= nil then
                    local success = pcall(function()
                        local existing = app.editor:GetEditorSource(obj)
                        local expected = before and before.props.Source or existing
                        if existing ~= sourceValue then
                            local doc, selection
                            pcall(function()
                                doc = app.editor:FindScriptDocument(obj)
                                ;
                                if doc then
                                    selection = {
                                        doc:GetSelection(),
                                    }
                                end
                            end)
                            app.editor:UpdateSourceAsync(obj, function(latest)
                                local normalized = latest:gsub("\r\n", "\n"):gsub("\r", "\n")
                                if normalized ~= expected and normalized ~= sourceValue then
                                    sourceRaced = true
                                    ;
                                    return nil
                                end
                                return sourceValue
                            end)
                            if doc and selection and not sourceRaced then
                                pcall(function()
                                    local lines = app.operations.splitLines(sourceValue)
                                    local function clampPosition(line, column)
                                        line = math.clamp(line or 1, 1, math.max(1, #lines))
                                        return line, math.clamp(column or 1, 1, #(lines[line] or "") + 1)
                                    end
                                    local a, b = clampPosition(selection[1], selection[2])
                                    ;
                                    local c, d = clampPosition(selection[3], selection[4])
                                    doc:SetSelection(a, b, c, d)
                                end)
                            end
                        end
                    end)
                    if not success then
                        retry = true
                        ;
                        app.warn(key .. ":Source", desired.name .. ": script source update failed")
                    end
                end
            end
            if obj:IsA("PartOperation") and type(desired.serialized) == "string" and not unionBlocked then
                app.unionCache[obj] = {
                    signature = app.operations.partOperationSignature(obj),
                    data = desired.serialized,
                }
            end
            local captured, actual = pcall(app.capture, obj, key)
            if not captured then
                error("Cannot read applied object")
            end
            app.synchronization.current[key] = actual
        elseif not desired and obj and not app.serviceIds[key] then
            local ok = pcall(function()
                obj:Destroy()
            end)
            if not ok then
                error("Roblox prevented object deletion")
            end
            local list = app.synchronization.watches[obj]
            ;
            if list then
                for _, c in ipairs(list) do
                    c:Disconnect()
                end
            end
            app.synchronization.watches[obj] = nil
            ;
            app.instanceKeys[obj] = nil
            ;
            app.instances[key] = nil
            ;
            app.synchronization.current[key] = nil
        elseif desired then
            retry = true
        end
        app.remoteVersions[key] = record.version
        if retry then
            app.acknowledged[key] = app.operations.copy(remoteValue)
            ;
            app.synchronization.retryRemote[key] = app.operations.copy(remoteValue)
            app.synchronization.retryRecords[key] = {
                version = record.version,
                value = app.operations.copy(desired),
            }
            app.synchronization.retryExpected[key] = app.operations.copy(app.synchronization.current[key])
            ;
            app.synchronization.retryAt[key] = os.clock() + 3
        else
            if key:sub(1, 9) == "~Terrain/" then
                app.acknowledged[key] = app.operations.copy(remoteValue)
                if app.operations.equal(desired, remoteValue) then
                    app.acknowledged[key] = app.operations.copy(app.synchronization.current[key])
                end
            else
                app.acknowledged[key] = app.operations.acknowledged(remoteValue, desired, app.synchronization.current[key])
            end
            if sourceRaced and app.acknowledged[key] and remoteValue then
                app.acknowledged[key].props.Source = remoteValue.props.Source
            end
            app.synchronization.retryRecords[key] = nil
            ;
            app.synchronization.retryAt[key] = nil
            ;
            app.synchronization.retryExpected[key] = nil
            ;
            app.synchronization.retryRemote[key] = nil
        end
        if not app.operations.equal(app.synchronization.current[key], app.acknowledged[key]) then
            app.synchronization.unsent[key] = true
        else
            app.synchronization.unsent[key] = nil
        end
        app.synchronization.received = app.synchronization.received + (1)
        ;
        app.synchronization.budget()
    end
end
function app.operations.apply(remote, sent, force)
    if app.features.forceRestore then
        force = true
        ;
        app.features.forceRestore = false
    end
    if not force and app.synchronization.holdReason() then
        app.synchronization.defer(remote)
        ;
        return false
    end
    app.synchronization.receiving = true
    local ok, result = pcall(app.operations.applyRecords, remote, sent, force)
    app.synchronization.receiving = false
    if not ok then
        error(result)
    end
    if result == false then
        app.synchronization.defer(remote)
        ;
        return false
    end
    return true
end
function app.synchronization.applyDeferred()
    if not next(app.synchronization.deferred) then
        return 
    end
    local records = app.synchronization.deferred
    if app.operations.apply(records, app.synchronization.current, false) then
        app.currentRevision = math.max(app.currentRevision, app.synchronization.deferredRevision)
        app.synchronization.deferred = {
        }
        ;
        app.synchronization.deferredRevision = 0
    end
end
function app.operations.blocked(obj, key)
    if app.pending[key] or app.synchronization.retryRecords[key] then
        return true
    end
    local parent = obj and obj.Parent
    while parent and parent ~= game do
        local id = app.instanceKeys[parent]
        ;
        if id and app.pending[id] then
            return true
        end
        parent = parent.Parent
    end
    return false
end
function app.changes(current, force)
    if not force and app.synchronization.holdReason() then
        return {
        }
    end
    local list, bytes = {
    }, 0
    -- Protocol is unchanged: complete records, only for dirty objects, in small batches.
    for key in pairs(app.synchronization.unsent) do
        if not force and app.synchronization.holdReason() then
            break
        end
        local value = current[key]
        if app.operations.equal(value, app.acknowledged[key]) then
            app.synchronization.unsent[key] = nil
        elseif not app.operations.blocked(app.instances[key], key) then
            local change = {
                id = key,
                version = app.remoteVersions[key] or 0,
            }
            if value then
                change.value = value
            else
                change.deleted = true
            end
            local size = #app.http:JSONEncode(change)
            if #list &gt; 0 and (#list &gt;= 64 or bytes + size &gt; 256 * 1024) then
                break
            end
            table.insert(list, change)
            ;
            bytes = bytes + (size)
        end
        app.synchronization.budget()
    end
    app.synchronization.lastBytes = bytes
    return list
end
function app.operations.sendChanges(current, force)
    if not force and app.synchronization.holdReason() then
        return {
            revision = app.currentRevision,
            objects = {
            },
        }
    end
    local list = app.changes(current, force)
    if not force and app.synchronization.holdReason() then
        return {
            revision = app.currentRevision,
            objects = {
            },
        }
    end
    if #list &gt; 0 then
        app.synchronization.inFlight = #list
        ;
        app.synchronization.sending = true
        local ok, result = pcall(app.request, "POST", {
            changes = list,
            since = app.currentRevision,
        })
        app.synchronization.inFlight = 0
        ;
        app.synchronization.sending = false
        if not ok then
            error(result)
        end
        if result.conflict then
            app.warnings.syncConflict = "Concurrent edits; merging and retrying"
        else
            if type(result.revision) ~= "number" then
                error("Server omitted revision")
            end
            app.warnings.syncConflict = nil
            for _, ch in ipairs(list) do
                app.acknowledged[ch.id] = app.operations.copy(ch.value)
                if ch.deleted then
                    app.remoteVersions[ch.id] = nil
                else
                    app.remoteVersions[ch.id] = (app.remoteVersions[ch.id] or 0) + 1
                end
                if app.operations.equal(app.synchronization.current[ch.id], ch.value) and not (app.instances[ch.id] and app.synchronization.dirty[app.instances[ch.id]]) then
                    app.synchronization.unsent[ch.id] = nil
                end
                local removed = app.instances[ch.id]
                if ch.deleted and removed and not app.synchronization.inScope(removed) then
                    for _, c in ipairs(app.synchronization.watches[removed] or {
                    }) do
                        c:Disconnect()
                    end
                    app.synchronization.watches[removed] = nil
                    ;
                    app.instanceKeys[removed] = nil
                    ;
                    app.instances[ch.id] = nil
                end
            end
            app.synchronization.sent = app.synchronization.sent + (#list)
            app.synchronization.lastConfirmedAt = os.clock()
            ;
            app.synchronization.log("Sent " .. #list .. " object" .. (#list == 1 and "" or "s") .. " | revision " .. result.revision)
            if result.remoteChanges and next(result.remoteChanges) then
                if force then
                    app.synchronization.defer(result.remoteChanges, result.revision)
                else
                    app.operations.apply(result.remoteChanges, current, false)
                end
            end
            if force then
                app.currentRevision = result.revision
                ;
                return {
                    revision = app.currentRevision,
                    objects = {
                    },
                }
            end
        end
    end
    if not force and app.synchronization.holdReason() then
        return {
            revision = app.currentRevision,
            objects = {
            },
        }
    end
    local latest = app.request("GET")
    if not latest.unchanged then
        if type(latest.revision) ~= "number" then
            error("Server omitted revision")
        end
        if app.operations.apply(latest.objects or {
        }, current, false) then
            app.currentRevision = latest.revision
        else
            app.synchronization.defer(latest.objects or {
            }, latest.revision)
        end
    end
    if #list == 0 or not app.warnings.syncConflict then
        app.warnings.syncConflict = nil
    end
    return {
        revision = app.currentRevision,
        objects = {
        },
    }
end
function app.synchronization.flush(progress, force)
    if not force and app.synchronization.paused then
        error("Resume sync before leaving")
    end
    if not force then
        local waitUntil = os.clock() + 2
        while app.synchronization.holdReason() and os.clock() &lt; waitUntil do
            task.wait(0.05)
        end
        if app.synchronization.holdReason() then
            error("Finish the current edit before leaving")
        end
    end
    -- Finish the terrain work already queued before confirming an explicit Leave.
    local terrainFinish = #app.synchronization.terrainQueue
    local terrainTotal = math.max(terrainFinish, app.synchronization.terrainTotal or 0)
    while app.synchronization.terrainHead &lt;= terrainFinish do
        app.synchronization.terrainNext = 0
        ;
        app.synchronization.terrainStep()
        ;
        app.synchronization.budget()
        if progress and terrainTotal &gt; 0 then
            progress("Reading Terrain", math.min(terrainTotal, app.synchronization.terrainHead - 1), terrainTotal)
        end
    end
    local total = 0
    ;
    for _ in pairs(app.synchronization.unsent) do
        total = total + (1)
    end
    local initial = total
    for _ = 1, 4096 do
        local current = app.operations.snapshot(force)
        if not next(app.synchronization.unsent) then
            if next(app.synchronization.retryRecords) then
                error("Remote objects are still loading; wait before leaving")
            end
            if progress then
                progress("Publishing map", initial, initial)
            end
            return 
        end
        app.operations.sendChanges(current, force)
        if progress then
            local remaining = 0
            ;
            for _ in pairs(app.synchronization.unsent) do
                remaining = remaining + (1)
            end
            progress("Publishing map", math.max(0, initial - remaining), initial)
        end
        if not force and (app.warnings.syncConflict or next(app.synchronization.retryRecords)) then
            error("Unconfirmed changes remain; wait and retry Leave")
        end
        task.wait()
    end
    error("Large backlog remains; wait for background sync before leaving")
end
app.api = nil
app.lastRemoteKeys = {
}
function app.operations.announceLoad(active, task, done, total, detail)
    local wasActive = app.synchronization.loading
    app.synchronization.loading = active == true
    if active then
        app.synchronization.loadTask = task or "Loading..."
        app.synchronization.loadDone = done or 0
        app.synchronization.loadTotal = total or 0
    end
    -- Flooding /load for every Terrain chunk would compete with the transfer
    -- itself. Two updates per second are enough for the peer's progress screen.
    local now = os.clock()
    local important = (active ~= wasActive) or not active
    if important or now - (app.synchronization.loadPostAt or 0) &gt;= 0.5 then
        app.synchronization.loadPostAt = now
        pcall(function()
            if app.room.Text ~= "" then
                app.api("/rooms/" .. app.room.Text .. "/load", "POST", {
                    active = active == true,
                    task = app.synchronization.loadTask,
                    done = app.synchronization.loadDone,
                    total = app.synchronization.loadTotal,
                })
            end
        end)
    end
    if active then
        app.LoadUI.setLocal(true, app.synchronization.loadTask, detail or "Editing is paused for both players while this transfer finishes.", app.synchronization.loadDone, app.synchronization.loadTotal)
    else
        app.LoadUI.setLocal(false)
    end
end
function app.operations.updateRemoteLoad(list)
    local peer = nil
    for _, item in ipairs(list or {
    }) do
        if item.active and item.token ~= app.token.Text then
            peer = item
            ;
            break
        end
    end
    app.synchronization.remoteLoad = peer
    app.LoadUI.setRemote(peer)
end
task.spawn(function()
    while app.synchronization.alive do
        task.wait(0.3)
        if app.synchronization.bulkDue and not app.synchronization.bulkUpload and app.active and app.synchronization.ready and not app.busy and not app.run:IsRunning() and not app.synchronization.remoteLoad then
            app.synchronization.bulkDue = false
            app.synchronization.bulkUpload = true
            task.spawn(function()
                local ok, err = pcall(function()
                    app.operations.announceLoad(true, "Loading model", 0, 0)
                    while os.clock() &lt; (app.synchronization.insertUntil or 0) do
                        task.wait(0.25)
                    end
                    app.operations.snapshot(true)
                    local total = 0
                    for _ in pairs(app.synchronization.unsent) do
                        total = total + (1)
                    end
                    app.operations.announceLoad(true, "Loading model", 0, total, "Sending a heavy insertion to the server...")
                    app.synchronization.flush(function(label, done, all)
                        app.operations.announceLoad(true, "Loading model", done or 0, all or 0, "Sending a heavy insertion to the server...")
                    end, true)
                end)
                app.synchronization.bulkUpload = false
                app.synchronization.insertCount = 0
                ;
                app.synchronization.insertUntil = 0
                ;
                app.synchronization.bulkDue = false
                app.operations.announceLoad(false)
                app.synchronization.loading = false
                app.LoadUI.setLocal(false)
                app.status(ok and "Heavy model loaded and synced." or ("Heavy model sync failed: " .. tostring(err)))
            end)
        end
    end
end)
function app.operations.loadInitialRoom(state, opts)
    app.lastRemoteKeys = {
    }
    local total = tonumber(state.objectCount) or 0
    local done = 0
    local cursor = 0
    local last = nil
    app.operations.announceLoad(true, "Loading map", 0, total)
    local fallback = false
    while true do
        local ok, chunk = pcall(app.api, "/rooms/" .. app.room.Text .. "/snapshot?cursor=" .. cursor .. "&amp;limit=96")
        if not ok then
            fallback = true
            break
        end
        last = chunk
        local records = chunk.objects or {
        }
        local n = 0
        for key in pairs(records) do
            app.lastRemoteKeys[key] = true
            ;
            n = n + (1)
        end
        if n &gt; 0 then
            app.operations.apply(records, app.operations.snapshot(true), true)
        end
        done = done + (n)
        total = tonumber(chunk.total) or total
        app.operations.announceLoad(true, "Loading map", done, total)
        cursor = tonumber(chunk.nextCursor) or 0
        if chunk.done or n == 0 or cursor == 0 then
            break
        end
        task.wait()
    end
    if fallback then
        app.LoadUI.setLocal(true, "Loading map", "Server is sending the full map in one request...", 0, 0)
        local full = app.api("/rooms/" .. app.room.Text .. "/sync")
        app.lastRemoteKeys = {
        }
        for key in pairs(full.objects or {
        }) do
            app.lastRemoteKeys[key] = true
        end
        app.operations.apply(full.objects or {
        }, app.operations.snapshot(true), true)
        last = full
    end
    app.currentRevision = tonumber(state.revision) or (last and last.revision) or app.currentRevision
    app.operations.announceLoad(false)
    app.LoadUI.setLocal(false)
end
function app.operations.connectSession(opts)
    opts = opts or {
    }
    if app.busy then
        return 
    end
    if app.active then
        if app.run:IsRunning() then
            app.status("Stop Play mode before leaving session.")
            ;
            return 
        end
        app.busy = true
        local ok, err = pcall(function()
            local current = app.operations.snapshot()
            app.synchronization.flush()
            if app.warnings.syncConflict then
                error("Unsent edits remain. Retry leaving in a few seconds.")
            end
        end)
        app.busy = false
        if not ok then
            app.status("Cannot leave: unsent changes. " .. tostring(err))
            ;
            return 
        end
        app.restoreSuppressed = true
        ;
        app.active = false
        ;
        app.synchronization.disconnect()
        ;
        app.connect.Text = "Reconnect to Session"
        ;
        app.status("Changes synced to session. Safe to close local copy.")
        return 
    end
    if app.run:IsRunning() then
        app.status("Stop Play/Test mode before connecting.")
        ;
        return 
    end
    app.busy = true
    local ok, err = pcall(function()
        app.synchronization.preparing = true
        if app.setup.Text:match("^%s*{") then
            local c = app.http:JSONDecode(app.setup.Text)
            local h, p = app.operations.splitAddress(c.server)
            app.address.Text = h
            ;
            app.portField.Text = tostring(p or app.DEFAULT_PORT)
            app.room.Text = c.room
            ;
            app.token.Text = c.token
            ;
            app.setup.Text = ""
        end
        local serverBase = app.base()
        if serverBase == "" then
            error("Enter server IP and port in Settings tab")
        end
        app.endpoint = serverBase .. "/api/rooms/" .. app.room.Text .. "/sync"
        ;
        app.credential = app.token.Text
        app.owner:SetSetting("PTAddress", serverBase)
        ;
        app.owner:SetSetting("PTRoom", app.room.Text)
        if opts.sameCopy then
            app.LoadUI.setLocal(true, "Preparing Same Copy", "Indexing local objects. The map is not being uploaded.", 0, 0)
        end
        app.index()
        local state = app.api("/rooms/" .. app.room.Text .. "/state")
        if state.closed then
            error("This room is closed.")
        end
        if opts.sameCopy then
            app.LoadUI.setLocal(true, "Preparing Same Copy", "Checking the local Terrain baseline. The map is not being uploaded.", 0, 0)
            app.synchronization.terrainNext = 0
            ;
            app.synchronization.terrainStep(true)
            while app.synchronization.terrainHead &lt;= #app.synchronization.terrainQueue do
                app.synchronization.terrainNext = 0
                ;
                app.synchronization.terrainStep(true)
                app.LoadUI.setLocal(true, "Preparing Same Copy", "Checking the local Terrain baseline", math.min(app.synchronization.terrainHead - 1, #app.synchronization.terrainQueue), #app.synchronization.terrainQueue)
                ;
                task.wait()
            end
            for key, value in pairs(app.terrainCache) do
                app.acknowledged[key] = app.operations.copy(value)
                ;
                app.synchronization.unsent[key] = nil
            end
        end
        if opts.host then
            if opts.sameCopy then
                if state.mode ~= "copy" then
                    error("This saved room is a normal live room. Use Host New Session instead.")
                end
                app.currentRevision = state.revision or 0
                pcall(function()
                    app.api("/rooms/" .. app.room.Text .. "/ready", "POST", {
                    })
                end)
            else
                if state.mode == "copy" then
                    error("This saved room uses Same Copy mode. Use Host Same Copy or start a new session.")
                end
                app.operations.announceLoad(true, "Preparing map", 0, 0)
                app.operations.snapshot(true)
                local terrainCount = app.synchronization.queueFullTerrain()
                local objectTotal = 0
                for _ in pairs(app.synchronization.unsent) do
                    objectTotal = objectTotal + (1)
                end
                app.operations.announceLoad(true, "Publishing map", 0, terrainCount + objectTotal)
                app.synchronization.flush(function(label, done, total)
                    app.operations.announceLoad(true, label or "Publishing map", done or 0, total or 0, "Sending the map to the server...")
                end, true)
                app.operations.announceLoad(false)
                pcall(function()
                    app.api("/rooms/" .. app.room.Text .. "/ready", "POST", {
                    })
                end)
            end
        else
            local waited = 0
            while state.ready == false do
                app.LoadUI.setLocal(true, "Waiting for host", "The host is preparing the map. This window will continue automatically.", 0, 0)
                task.wait(2)
                ;
                waited = waited + (2)
                state = app.api("/rooms/" .. app.room.Text .. "/state")
                if state.closed then
                    error("This room is closed.")
                end
            end
            if state.mode == "copy" and not opts.sameCopy then
                error("This room uses Same Copy mode. Open the shared .rbxl and use Join Same Copy.")
            end
            if opts.sameCopy and state.mode ~= "copy" then
                error("This is a normal live room. Use Join by Room Code instead.")
            end
            if opts.sameCopy and (state.revision or 0) &lt;= 1 then
                app.lastRemoteKeys = {
                }
                app.currentRevision = state.revision or 0
            else
                app.operations.loadInitialRoom(state, opts)
            end
        end
        local after = app.operations.snapshot()
        local baselineTotal = 0
        for _ in pairs(after) do baselineTotal = baselineTotal + 1; app.synchronization.budget() end
        local baselineDone = 0
        app.synchronization.preparationProgress("Saving local baseline", "Remembering initial state for future edits. No map upload in Same Copy mode.", 0, baselineTotal, true)
        for key, value in pairs(after) do
            if opts.sameCopy or not app.remoteVersions[key] then
                app.acknowledged[key] = app.operations.copy(value)
                ;
                app.synchronization.unsent[key] = nil
            end
            baselineDone = baselineDone + 1
            app.synchronization.preparationProgress("Saving local baseline", string.format("%d / %d objects", baselineDone, baselineTotal), baselineDone, baselineTotal)
            app.synchronization.budget()
        end
        app.currentRevision = app.currentRevision or state.revision or 0
        app.synchronization.loading = false
        ;
        app.synchronization.remoteLoad = nil
        ;
        app.LoadUI.hide()
        app.synchronization.preparing = false
        app.active = true
        ;
        app.synchronization.ready = true
        ;
        app.synchronization.paused = false
        ;
        app.synchronization.log("Session connected")
        ;
        app.accept.Visible = false
        ;
        app.connect.Text = "Leave Session"
        ;
        app.status("Place connected. Real-time sync enabled." .. app.operations.warningText())
    end)
    app.busy = false
    if not ok then
        app.synchronization.preparing = false
        app.synchronization.loading = false
        ;
        app.synchronization.remoteLoad = nil
        ;
        app.LoadUI.hide()
        ;
        app.operations.announceLoad(false)
        app.active = false
        ;
        app.synchronization.disconnect()
        ;
        app.status(tostring(err))
        ;
        app.accept.Visible = app.endpoint ~= nil
    end
end
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="PT_ViewportInput">
      <Properties>
        <string name="Name">ViewportInput</string>
        <ProtectedString name="Source">-- Owns viewport input only for the lifetime of a walkthrough.
local Input={}
Input.__index=Input

function Input.new(owner,onExit)
    return setmetatable({plugin=owner,onExit=onExit,connections={},keys={},look=Vector2.zero,wheel=0,dragging=false,running=false,lastPosition=nil,lastRaw=0},Input)
end

function Input:bind(signal,callback)
    local c=signal:Connect(callback)
    self.connections[#self.connections+1]=c
end

function Input:addLook(x,y)
    if x~=x or y~=y then return end
    self.look+=Vector2.new(math.clamp(x,-150,150),math.clamp(y,-150,150))
end

function Input:beginDrag()
    if not self.running then return end
    local user=game:GetService("UserInputService")
    if user:GetFocusedTextBox() then return end
    self.dragging=true
    self.lastRaw=0
    self.lastPosition=user:GetMouseLocation()
    self.lastPluginPosition=self.mouse and Vector2.new(self.mouse.X,self.mouse.Y) or nil
    pcall(function() user.MouseBehavior=Enum.MouseBehavior.LockCurrentPosition end)
end

function Input:endDrag()
    self.dragging=false
    self.lastPosition=nil
    self.lastPluginPosition=nil
    if self.originalMouse then pcall(function() game:GetService("UserInputService").MouseBehavior=self.originalMouse end) end
end

function Input:start()
    if self.running then return end
    local user=game:GetService("UserInputService")
    self.originalMouse=user.MouseBehavior
    self.originalIcon=user.MouseIconEnabled
    self.running=true
    local ok,err=pcall(function()
        self.plugin:Activate(true)
        self.mouse=self.plugin:GetMouse()
        self:bind(self.mouse.Button2Down,function() self:beginDrag() end)
        self:bind(self.mouse.Button2Up,function() self:endDrag() end)
        self:bind(self.mouse.Move,function()
            if not self.dragging then return end
            local position=Vector2.new(self.mouse.X,self.mouse.Y)
            if self.lastPluginPosition and os.clock()-self.lastRaw&gt;.04 then
                local delta=position-self.lastPluginPosition
                self:addLook(delta.X,delta.Y)
            end
            self.lastPluginPosition=position
        end)
        self:bind(self.mouse.WheelForward,function() self.wheel+=1 end)
        self:bind(self.mouse.WheelBackward,function() self.wheel-=1 end)
        self:bind(user.InputBegan,function(event,processed)
            if event.UserInputType==Enum.UserInputType.MouseButton2 then self:beginDrag() end
            if event.KeyCode==Enum.KeyCode.Escape then self.onExit();return end
            if not user:GetFocusedTextBox() then
                self.keys[event.KeyCode]=true
            end
        end)
        self:bind(user.InputEnded,function(event)
            self.keys[event.KeyCode]=nil
            if event.UserInputType==Enum.UserInputType.MouseButton2 then self:endDrag() end
        end)
        self:bind(user.InputChanged,function(event)
            if self.dragging and event.UserInputType==Enum.UserInputType.MouseMovement and event.Delta.Magnitude&gt;0 then
                self.lastRaw=os.clock()
                self:addLook(event.Delta.X,event.Delta.Y)
            end
        end)
        self:bind(user.WindowFocusReleased,function() self.keys={};self:endDrag() end)
        self:bind(self.plugin.Deactivation,function() if self.running then self.onExit() end end)
    end)
    if not ok then self:stop();error("Cannot capture the Studio viewport: "..tostring(err)) end
end

function Input:sample()
    local user=game:GetService("UserInputService")
    local focused=user:GetFocusedTextBox()~=nil
    local function down(code)
        if focused then return false end
        local ok,value=pcall(function() return user:IsKeyDown(code) end)
        return self.keys[code] or (ok and value) or false
    end
    local x=((down(Enum.KeyCode.D) or down(Enum.KeyCode.Right)) and 1 or 0)-((down(Enum.KeyCode.A) or down(Enum.KeyCode.Left)) and 1 or 0)
    local z=((down(Enum.KeyCode.W) or down(Enum.KeyCode.Up)) and 1 or 0)-((down(Enum.KeyCode.S) or down(Enum.KeyCode.Down)) and 1 or 0)
    local look,wheel=self.look,self.wheel
    self.look,self.wheel=Vector2.zero,0
    return {move=Vector2.new(x,z),jump=down(Enum.KeyCode.Space),sprint=down(Enum.KeyCode.LeftShift) or down(Enum.KeyCode.RightShift),look=focused and Vector2.zero or look,wheel=wheel}
end

function Input:stop()
    if not self.running then return end
    self.running=false
    self:endDrag()
    for _,c in ipairs(self.connections) do c:Disconnect() end
    self.connections={};self.keys={};self.look=Vector2.zero;self.wheel=0
    pcall(function() game:GetService("UserInputService").MouseIconEnabled=self.originalIcon end)
    pcall(function() self.plugin:Deactivate() end)
end
return Input
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="PT_Walkthrough">
      <Properties>
        <string name="Name">Walkthrough</string>
        <ProtectedString name="Source">local AvatarRig=require(script.Parent.AvatarRig)
local ViewportInput=require(script.Parent.ViewportInput)
local Walkthrough={}

local function finite(value)
    return type(value)=="number" and value==value and math.abs(value)&lt;1000000
end

local function vector(data)
    if type(data)~="table" or not finite(data[1]) or not finite(data[2]) or not finite(data[3]) then return nil end
    return Vector3.new(data[1],data[2],data[3])
end

function Walkthrough.new(context)
    local self={active=false,starting=false,remoteTesters={},remotePending={},activeTestersList={},state="Idle",myUserId=0,epoch=0}
    local cameraBackup,rig,input,hud
    local position,heading=Vector3.zero,CFrame.identity
    local vertical,height,phase,idle,yaw,pitch,distance=0,3,0,0,0,-.18,12
    local function notify(text) if context.status then context.status(text) end end
    pcall(function() self.myUserId=game:GetService("StudioService"):GetUserId() end)

    function self.getFolder()
        if self.folder and self.folder.Parent then return self.folder end
        local folder=Instance.new("Folder")
        folder.Name="PlaceTogetherTeamTest"
        folder.Archivable=false
        folder:SetAttribute("PT_Internal",true)
        folder.Parent=workspace
        self.folder=folder
        return folder
    end

    function self.getSpawn()
        local options={}
        for _,item in ipairs(workspace:GetDescendants()) do
            if item:IsA("SpawnLocation") and item.Enabled then options[#options+1]=item end
        end
        if #options&gt;0 then
            local spawn=options[1]
            return spawn.Position+Vector3.new(0,spawn.Size.Y*.5+height+.15,0)
        end
        local camera=workspace.CurrentCamera
        local origin=camera and camera.Focus.Position+Vector3.new(0,64,0) or Vector3.new(0,128,0)
        local params=RaycastParams.new()
        params.FilterDescendantsInstances={self.getFolder()}
        params.FilterType=Enum.RaycastFilterType.Exclude
        local floor=workspace:Raycast(origin,Vector3.new(0,-1024,0),params)
        return floor and floor.Position+Vector3.new(0,height+.15,0) or Vector3.new(0,10,0)
    end

    local function buildHUD()
        local gui=Instance.new("ScreenGui")
        gui.Name="PlaceTogetherWalkHUD"
        gui.ResetOnSpawn=false
        gui.DisplayOrder=9000
        gui:SetAttribute("PT_Internal",true)
        local panel=Instance.new("Frame")
        panel.Size=UDim2.fromOffset(570,44)
        panel.Position=UDim2.new(.5,-285,0,16)
        panel.BackgroundColor3=Color3.fromRGB(21,31,42)
        panel.BorderSizePixel=0
        panel.Parent=gui
        local rounded=Instance.new("UICorner")
        rounded.CornerRadius=UDim.new(0,12)
        rounded.Parent=panel
        local controls=Instance.new("TextLabel")
        controls.Size=UDim2.new(1,-90,0,30)
        controls.Position=UDim2.fromOffset(12,5)
        controls.BackgroundTransparency=1
        controls.Font=Enum.Font.GothamMedium
        controls.TextSize=12
        controls.TextColor3=Color3.fromRGB(224,238,242)
        controls.Text="WASD · Space jump · Shift sprint · hold RMB to look · wheel zoom"
        controls.Parent=panel
        local exit=Instance.new("TextButton")
        exit.Size=UDim2.fromOffset(64,28)
        exit.Position=UDim2.new(1,-76,0,8)
        exit.BackgroundColor3=Color3.fromRGB(59,82,94)
        exit.TextColor3=Color3.new(1,1,1)
        exit.Text="Exit Esc"
        exit.BorderSizePixel=0
        exit.Parent=panel
        exit.MouseButton1Click:Connect(function()self.stop()end)
        gui.Parent=game:GetService("CoreGui")
        self.hudGui=gui
        return gui
    end

    function self.stop()
        if self.stopping then return end
        self.stopping=true
        self.active,self.starting=false,false
        self.epoch+=1
        if input then input:stop();input=nil end
        if rig then rig:destroy();rig=nil end
        if hud then hud:Destroy();hud=nil end
        self.char,self.hudGui=nil,nil
        local camera=workspace.CurrentCamera
        if camera and cameraBackup then
            pcall(function()
                camera.CameraSubject=cameraBackup.subject
                camera.CFrame=cameraBackup.frame
                camera.Focus=cameraBackup.focus
                camera.FieldOfView=cameraBackup.fov
                camera.CameraType=cameraBackup.kind
            end)
        end
        cameraBackup=nil
        if context.toggle then
            context.toggle.Text="Start co-op walkthrough"
            context.toggle.BackgroundColor3=Color3.fromRGB(46,127,140)
        end
        self.stopping=false
    end

    function self.start()
        if self.active or self.starting then return end
        if not context.canStart() then notify("Connect to a session and wait for synchronization first.");return end
        local camera=workspace.CurrentCamera
        if not camera then notify("Studio viewport camera is unavailable.");return end
        self.starting=true
        self.epoch+=1
        local epoch=self.epoch
        local ok,err=pcall(function()
            local created=AvatarRig.create(context.name(),Color3.fromRGB(81,191,174))
            if epoch~=self.epoch or not context.canStart() then created:destroy();return end
            rig=created
            local humanoid=rig.model:FindFirstChildOfClass("Humanoid")
            height=humanoid and humanoid.HipHeight+rig.root.Size.Y*.5 or 3
            if humanoid and humanoid.RigType==Enum.HumanoidRigType.R6 then height=rig.root.Size.Y*.5+2 end
            height=math.clamp(height,1.5,8)
            position=self.getSpawn()
            vertical,phase,idle=0,0,0
            local look=camera.CFrame.LookVector
            yaw,pitch,distance=math.atan2(-look.X,-look.Z),-.18,12
            heading=CFrame.Angles(0,yaw,0)
            cameraBackup={kind=camera.CameraType,frame=camera.CFrame,focus=camera.Focus,fov=camera.FieldOfView,subject=camera.CameraSubject}
            rig:pose(CFrame.new(position)*heading,"Idle",0,0)
            rig.model.Parent=self.getFolder()
            self.char=rig.model
            hud=buildHUD()
            input=ViewportInput.new(context.plugin,function()self.stop()end)
            input:start()
            camera.CameraType=Enum.CameraType.Scriptable
            self.active=true
            if context.toggle then context.toggle.Text="Exit walkthrough" end
            notify("Walkthrough ready: hold the right mouse button and move the mouse to rotate.")
        end)
        self.starting=false
        if not ok then self.stop();notify("Walkthrough failed: "..tostring(err)) end
    end

    function self.toggle()
        if self.active or self.starting then self.stop() else self.start() end
    end

    function self.updateLocal(dt)
        if not self.active or not rig or not input then return end
        if not context.canContinue() then self.stop();return end
        local controls=input:sample()
        yaw-=controls.look.X*.004
        pitch=math.clamp(pitch-controls.look.Y*.004,-1.25,.75)
        distance=math.clamp(distance-controls.wheel*1.4,4,32)
        local orientation=CFrame.Angles(0,yaw,0)
        local direction=orientation.RightVector*controls.move.X+orientation.LookVector*controls.move.Y
        if direction.Magnitude&gt;1 then direction=direction.Unit end
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances={self.getFolder()}
        params.RespectCanCollide=true
        local total=math.clamp(dt,0,.12)
        local steps=math.max(1,math.ceil(total/(1/60)))
        local slice=total/steps
        local grounded=false
        for _=1,steps do
            local move=direction*(controls.sprint and 25 or 16)*slice
            if move.Magnitude&gt;.0001 then
                for _,offset in ipairs({Vector3.new(0,-height*.35,0),Vector3.new(0,.7,0)}) do
                    local wall=workspace:Raycast(position+offset,move.Unit*(move.Magnitude+.8),params)
                    if wall and wall.Normal.Y&lt;.6 then
                        local into=move:Dot(wall.Normal)
                        if into&lt;0 then move-=wall.Normal*into end
                    end
                end
            end
            position+=move
            vertical-=workspace.Gravity*slice
            local drop=vertical*slice
            local floor=workspace:Raycast(position+Vector3.new(0,.4,0),Vector3.new(0,-(height+.5+math.max(0,-drop)),0),params)
            if floor and floor.Normal.Y&gt;.4 and vertical&lt;=0 and position.Y+drop&lt;=floor.Position.Y+height+.08 then
                position=Vector3.new(position.X,floor.Position.Y+height,position.Z)
                vertical=0;grounded=true
                if controls.jump then vertical=48;grounded=false end
            else
                if drop&gt;0 then
                    local ceiling=workspace:Raycast(position,Vector3.new(0,drop+1.6,0),params)
                    if ceiling then vertical=0;drop=0 end
                end
                position+=Vector3.new(0,drop,0)
                grounded=false
            end
        end
        if position.Y&lt;-1000 then position=self.getSpawn();vertical=0 end
        local moving=direction.Magnitude&gt;.01
        if moving then heading=heading:Lerp(CFrame.lookAt(Vector3.zero,direction),1-math.exp(-14*total)) end
        self.state=not grounded and (vertical&gt;0 and "Jumping" or "Freefall") or (moving and (controls.sprint and "Running" or "Walking") or "Idle")
        phase+=total*(controls.sprint and 15 or 10)
        idle+=total
        rig:pose(CFrame.new(position)*heading,self.state,phase,idle)
        local camera=workspace.CurrentCamera
        local focus=position+Vector3.new(0,1,0)
        local desired=focus-(orientation*CFrame.Angles(pitch,0,0)).LookVector*distance
        local obstruction=workspace:Raycast(focus,desired-focus,params)
        if obstruction then desired=obstruction.Position+obstruction.Normal*.35 end
        camera.CameraType=Enum.CameraType.Scriptable
        camera.CFrame=CFrame.lookAt(desired,focus)
        camera.Focus=CFrame.new(focus)
    end

    function self.updateRemote(peer,dt)
        local packet=peer.teamTest
        local target=packet and packet.active and vector(packet.pos)
        if not target then return end
        local item=self.remoteTesters[peer.id]
        if not item then
            if self.remotePending[peer.id] then return end
            self.remotePending[peer.id]=true
            local epoch=self.epoch
            task.spawn(function()
                local ok,result=pcall(AvatarRig.create,peer.name or "Builder",Color3.fromHSV(peer.hue or .5,.55,1))
                self.remotePending[peer.id]=nil
                if not ok then return end
                if epoch~=self.epoch or not context.canContinue() then result:destroy();return end
                result.model.Parent=self.getFolder()
                self.remoteTesters[peer.id]={rig=result,model=result.model,pos=target,rot=CFrame.identity,phase=0,idle=0}
            end)
            return
        end
        local elapsed=math.clamp(dt,0,.1)
        local blend=1-math.exp(-18*elapsed)
        item.pos=item.pos:Lerp(target,blend)
        local look=vector(packet.look)
        if look and Vector3.new(look.X,0,look.Z).Magnitude&gt;.001 then
            item.rot=item.rot:Lerp(CFrame.lookAt(Vector3.zero,Vector3.new(look.X,0,look.Z)),blend)
        end
        item.phase+=elapsed*12;item.idle+=elapsed
        item.rig:pose(CFrame.new(item.pos)*item.rot,packet.state or "Idle",item.phase,item.idle)
        item.seen=os.clock()
    end

    function self.destroy()
        self.stop()
        for id,item in pairs(self.remoteTesters) do item.rig:destroy();self.remoteTesters[id]=nil end
        if self.folder then self.folder:Destroy();self.folder=nil end
    end
    return self
end
return Walkthrough
</ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>
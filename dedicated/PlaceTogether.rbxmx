    while app.synchronization.alive do
        app.operations.refreshUI(app.active, app.loggedIn, app.inbox ~= nil, app.busy or app.inviting)
        task.wait(0.25)
    end
end)
-- Peer Cursors / Participant Avatars
app.perf.check.MouseButton1Click:Connect(function()
    if not app.active or app.busy then
        app.status("Connect a session and wait for the current operation.")
        ;
        return 
    end
    task.spawn(function()
        app.busy = true
        local ok, err = pcall(function()
            app.operations.resetUnionCache()
            for _, obj in pairs(app.instances) do
                app.synchronization.mark(obj)
                ;
                app.synchronization.budget()
            end
            app.operations.snapshot()
        end)
        app.busy = false
        ;
        app.status(ok and "Object recheck complete; edits queued." or tostring(err))
    end)
end)
app.perf.terrain.MouseButton1Click:Connect(function()
    if not app.active then
        app.status("Connect a session first.")
        ;
        return 
    end
    if app.busy or app.synchronization.bulkUpload or app.synchronization.loading or app.synchronization.remoteLoad then
        app.status("Wait for the current operation to finish.")
        ;
        return 
    end
    app.busy = true
    ;
    app.synchronization.bulkUpload = true
    task.spawn(function()
        local ok, err = pcall(function()
            app.operations.announceLoad(true, "Preparing complete Terrain", 0, 0)
            app.synchronization.queueFullTerrain()
            app.synchronization.flush(function(label, done, total)
                app.operations.announceLoad(true, "Sending complete Terrain", done or 0, total or 0, "All Terrain is being transferred. Please wait.")
            end, true)
        end)
        app.synchronization.bulkUpload = false
        ;
        app.busy = false
        ;
        app.operations.announceLoad(false)
        app.status(ok and "Complete Terrain uploaded." or ("Terrain transfer failed: " .. tostring(err)))
    end)
end)
task.spawn(function()
    while app.synchronization.alive do
        local queued = math.max(0, #app.synchronization.queue - app.synchronization.head + 1)
        local unsent = 0
        ;
        for _ in pairs(app.synchronization.unsent) do
            unsent = unsent + (1)
        end
        app.perf.stats.Text = string.format("Queue: %d objects | %d outgoing\nRead: %d | Sent: %d | Batch: %.1f KB\nTerrain queue: %d chunks", queued, unsent, app.synchronization.captured, app.synchronization.sent, app.synchronization.lastBytes / 1024, math.max(0, #app.synchronization.terrainQueue - app.synchronization.terrainHead + 1))
        app.perf.details.Text = app.operations.warningText():gsub("^\n", "")
        task.wait(1)
    end
end)
app.live.pause.MouseButton1Click:Connect(function()
    if not app.active then
        return 
    end
    app.synchronization.paused = not app.synchronization.paused
    app.synchronization.log(app.synchronization.paused and "Sync paused - local edits retained" or "Sync resumed")
end)
app.live.now.MouseButton1Click:Connect(function()
    if not app.active then
        return 
    end
    app.synchronization.paused = false
    ;
    app.synchronization.nextPoll = 0
    ;
    app.synchronization.nextNetwork = 0
    app.synchronization.log("Sync requested - waiting for edit to finish")
end)
task.spawn(function()
    local peak = 0
    while app.synchronization.alive do
        if app.active then
            if app.synchronization.centerPending and not app.busy and not app.run:IsRunning() then
                local ok = pcall(app.synchronization.centerAfterJoin)
                if not ok then
                    app.synchronization.centerPending = false
                end
            end
            local count = app.synchronization.queueCount()
            local chunks = math.max(0, #app.synchronization.terrainQueue - app.synchronization.terrainHead + 1)
            local reason = app.synchronization.holdReason()
            local text, detail, tint = "All changes saved", "Your object edits are confirmed by the server.", app.palette.green
            if app.run:IsRunning() then
                text = "Paused during Play"
                ;
                detail = "Stop Play mode to resume synchronization."
                ;
                tint = app.palette.muted
            elseif reason == "Paused" then
                text = "Sync paused"
                ;
                detail = "Local changes stay queued. Resume when you are ready."
                ;
                tint = app.palette.muted
            elseif app.synchronization.errors &gt; 0 then
                text = "Connection interrupted"
                ;
                detail = "Your edits are queued. Retrying automatically."
                ;
                tint = app.palette.danger
            elseif reason == "Editing" and count &gt; 0 then
                text = "Editing"
                ;
                detail = "Finish dragging to sync the final result."
                ;
                tint = Color3.fromRGB(251, 191, 36)
            elseif reason == "Waiting" and count &gt; 0 then
                text = "Waiting to sync"
                ;
                detail = "Combining your latest changes into one update."
                ;
                tint = Color3.fromRGB(251, 191, 36)
            elseif app.synchronization.sending then
                text = "Syncing " .. app.synchronization.inFlight .. " objects"
                ;
                detail = "Waiting for server confirmation."
                ;
                tint = app.palette.accent
            elseif app.synchronization.receiving then
                text = "Receiving changes"
                ;
                detail = "Applying your collaborator's updates."
                ;
                tint = app.palette.accent
            elseif count &gt; 0 then
                text = "Changes queued"
                ;
                detail = "Preparing the next update. Keep Studio open."
                ;
                tint = app.palette.accent
            elseif next(app.synchronization.deferred) then
                text = "Updates waiting"
                ;
                detail = "Collaborator updates will apply after your edit."
                ;
                tint = app.palette.accent
            elseif chunks &gt; 0 then
                text = "Object changes saved"
                ;
                detail = "Terrain is still being checked in the background."
                ;
                tint = app.palette.green
            end
            app.live.heading.Text = text
            ;
            app.live.heading.TextColor3 = tint
            app.live.summary.Text = detail
            app.live.queue.Text = string.format("Queue: %d objects | Sending: %d\nTerrain: %d chunks", count, app.synchronization.inFlight, chunks)
            peak = math.max(peak, count)
            local fraction = peak &gt; 0 and math.clamp((peak - count) / peak, 0, 1) or 1
            if count == 0 then
                fraction = 1
                ;
                peak = 0
            end
            app.live.fill.Size = UDim2.fromScale(fraction, 1)
            ;
            app.live.fill.BackgroundColor3 = tint
            app.live.pause.Text = app.synchronization.paused and "Resume Sync" or "Pause Sync"
            app.live.history.Text = #app.synchronization.activity &gt; 0 and table.concat(app.synchronization.activity, "\n") or "Activity will appear here."
        end
        task.wait(0.2)
    end
end)
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="PT_Synchronization">
      <Properties>
        <string name="Name">Synchronization</string>
        <ProtectedString name="Source">-- PlaceTogether Studio application component.
return function(app)
app.active = false
app.busy = false
app.restoreSuppressed = false
app.instances, app.instanceKeys, app.acknowledged, app.remoteVersions = {
}, {
}, {
}, {
}
app.rigCache = setmetatable({
}, {
    __mode = "k",
})
function app.operations.rigOf(obj)
    if not obj then
        return nil
    end
    local cached = app.rigCache[obj]
    if cached ~= nil then
        return cached or nil
    end
    local p = obj
    while p and p ~= game do
        if p:IsA("Model") and (p:FindFirstChildOfClass("Humanoid") or p:FindFirstChildOfClass("Animator")) then
            app.rigCache[obj] = p
            return p
        end
        p = p.Parent
    end
    app.rigCache[obj] = false
    return nil
end
app.HEAVY_OBJECTS = 2500
app.HEAVY_BYTES = 8 * 1024 * 1024
app.HEAVY_PLACE_OBJECTS = 3500
app.synchronization = {
    alive = true,
    enabled = false,

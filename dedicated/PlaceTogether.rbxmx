        ;
        app.synchronization.paused = false
        ;
        app.synchronization.centerAfterJoin()
        ;
        app.connect.Visible = true
        ;
        app.accept.Visible = false
        ;
        app.status("Server version accepted.")
    end)
    app.busy = false
    ;
    if not ok then
        app.status(tostring(err))
    end
end)
task.spawn(function()
    if app.selfNick.Text == "" then
        pcall(function()
            local uid = game:GetService("StudioService"):GetUserId()
            ;
            if uid &gt; 0 then
                app.selfNick.Text = game:GetService("Players"):GetNameFromUserIdAsync(uid)
            end
        end)
    end
    if app.base() ~= "" then
        local ready, reason = pcall(app.guestEnter)
        if not ready then
            app.status("Failed to connect. Check server address in Settings. " .. tostring(reason))
        end
    else
        app.status("Enter server address in Settings tab")
    end
    while app.synchronization.alive do
        task.wait(3)
        if not app.loggedIn and not app.inviting and not app.polling then
            pcall(app.guestEnter)
        end
        if app.loggedIn and not app.polling and not app.inviting then
            app.polling = true
            local ok, err = pcall(function()
                local invitations = app.api("/invitations")
                if app.lastSent then
                    for _, sent in ipairs(app.api("/invitations/outbox")) do
                        if sent.id == app.lastSent then
                            if sent.state == "accepted" then
                                app.inviteStatus.Text = "Friend accepted invitation."
                                ;
                                app.lastSent = nil
                            elseif sent.state == "declined" then
                                app.inviteStatus.Text = "Friend declined invitation."
                                ;
                                app.lastSent = nil
                            elseif sent.delivered then
                                app.inviteStatus.Text = "Request received by friend's plugin. Waiting for acceptance."
                            elseif sent.recipientOnline then
                                app.inviteStatus.Text = "Friend is online. Delivering invitation..."
                            else
                                app.inviteStatus.Text = "Friend has not received request yet. Check username and plugin version."
                            end
                        end
                    end
                end
                local nextInvite = invitations[#invitations]
                if nextInvite and (not app.inbox or app.inbox.id ~= nextInvite.id) then
                    app.inbox = nextInvite
                    ;
                    app.incoming.Text = nextInvite.from .. " invited you to '" .. nextInvite.place .. "'. Accept to join the shared session."
                    ;
                    app.yes.Visible = true
                    ;
                    app.no.Visible = true
                    ;
                    app.uiTab = "home"
                    ;
                    app.widget.Enabled = true
                elseif not nextInvite and app.inbox then
                    app.inbox = nil
                    ;
                    app.yes.Visible = false
                    ;
                    app.no.Visible = false
                    ;
                    app.incoming.Text = "No new invitations."
                end
            end)
            app.polling = false
            ;
            if not ok then
                app.incoming.Text = "Failed to check invitations: " .. tostring(err)
            end
        end
    end
end)
task.spawn(function()
    while app.synchronization.alive do
        task.wait(0.7)
        if app.active and app.room.Text ~= "" and not app.run:IsRunning() then
            local ok, list = pcall(function()
                return app.api("/rooms/" .. app.room.Text .. "/load")
            end)
            if ok then
                app.operations.updateRemoteLoad(list)
            end
        elseif app.synchronization.remoteLoad then
            app.operations.updateRemoteLoad({
            })
        end
    end
end)
task.spawn(function()
    local wasPlaying = false
    while app.synchronization.alive do
        task.wait(0.1)
        if app.active and app.run:IsRunning() then
            wasPlaying = true
            app.status("Sync paused during Play mode. Stop game to resume editing.")
        elseif app.active and not app.busy and os.clock() &gt;= app.synchronization.nextPoll and not app.synchronization.holdReason() then
            app.busy = true
            local ok, err = pcall(function()
                if wasPlaying then
                    wasPlaying = false
                    -- One deferred refresh after Play; never serialize simulation frames.
                    for _, obj in pairs(app.instances) do
                        app.synchronization.mark(obj)
                        ;
                        app.synchronization.budget()
                    end
                end
                app.synchronization.applyDeferred()
                if app.synchronization.holdReason() then
                    return 
                end
                app.synchronization.terrainStep()
                local retry = {
                }
                for key, record in pairs(app.synchronization.retryRecords) do
                    if (app.synchronization.retryAt[key] or 0) &lt;= os.clock() then
                        retry[key] = record
                    end
                end
                if next(retry) then
                    app.operations.apply(retry, app.synchronization.current, false)
                end
                local current = app.operations.snapshot()
                if app.synchronization.holdReason() then
                    return 
                end
                local hasUnsent = next(app.synchronization.unsent) ~= nil
                if hasUnsent or os.clock() &gt;= app.synchronization.nextNetwork then
                    local state = app.operations.sendChanges(current)
                    app.synchronization.nextNetwork = os.clock() + (hasUnsent and 0.65 or 1.5)
                    app.status((app.warnings.syncConflict and "Merging concurrent edits" or ("Synced rev " .. state.revision)) .. " | " .. app.room.Text:sub(1, 8) .. app.operations.warningText())
                end
                app.synchronization.errors = 0
                ;
                app.synchronization.nextPoll = 0
            end)
            app.busy = false
            if not ok then
                app.synchronization.errors = app.synchronization.errors + (1)
                app.synchronization.nextPoll = os.clock() + math.min(15, 2 ^ (math.min(4, app.synchronization.errors) - 1))
                app.status("Sync retry queued; local edits preserved. " .. tostring(err))
                app.synchronization.log("Connection error - retry queued")
            end
        end
    end
end)
app.owner.Unloading:Connect(function()
    app.active = false
    ;
    app.loggedIn = false
    ;
    app.synchronization.alive = false
    ;
    app.synchronization.disconnect()
end)
app.logout.MouseButton1Click:Connect(function()
    if app.busy or app.inviting then

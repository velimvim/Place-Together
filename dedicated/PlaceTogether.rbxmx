local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 8)
	c.Parent = obj
	return c
end

local function stroke(obj, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or palette.line
	s.Thickness = thickness or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = obj
	return s
end

local function pad(obj, n, nY)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, n)
	p.PaddingRight = UDim.new(0, n)
	p.PaddingTop = UDim.new(0, nY or n)
	p.PaddingBottom = UDim.new(0, nY or n)
	p.Parent = obj
	return p
end

local function stack(obj, gap)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, gap or 10)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = obj
	return l
end

local function container(parent, name)
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = UDim2.new(1, 0, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.BackgroundTransparency = 1
	f.Parent = parent
	stack(f, 10)
	return f
end

local body = Instance.new("ScrollingFrame")
body.Name = "Content"
body.Position = UDim2.new(0, 16, 0, 108)
body.Size = UDim2.new(1, -32, 1, -158)
body.AutomaticCanvasSize = Enum.AutomaticSize.Y
body.CanvasSize = UDim2.new()
body.ScrollBarThickness = 4
body.ScrollBarImageColor3 = palette.line
body.BackgroundTransparency = 1
body.BorderSizePixel = 0
body.Parent = frame

local currentParent = body

local function textLabel(text, height, parent)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 0, height or 20)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.Text = text
	l.TextColor3 = palette.muted
	l.BackgroundTransparency = 1
	l.TextWrapped = true
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	l.Font = Enum.Font.Gotham
	l.TextSize = 13
	l.Parent = parent or currentParent
	return l
end

local function title(text, parent)
	local l = textLabel(text, 22, parent)
	l.Font = Enum.Font.GothamBold
	l.TextSize = 15
	l.TextColor3 = palette.text
	return l
end

local function field(placeholder, text, parent)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, 0, 0, 36)
	box.Text = text or ""
	box.PlaceholderText = placeholder
	box.ClearTextOnFocus = false
	box.TextColor3 = palette.text
	box.PlaceholderColor3 = palette.subtle
	box.BackgroundColor3 = palette.field
	box.BorderSizePixel = 0
	box.Font = Enum.Font.GothamMedium
	box.TextSize = 13
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.Parent = parent or currentParent
	corner(box, 8)
	pad(box, 12, 0)
	local s = stroke(box, palette.fieldBorder, 1)
	box.Focused:Connect(function()
		s.Color = palette.fieldFocus
		s.Thickness = 1.5
	end)
	box.FocusLost:Connect(function()
		s.Color = palette.fieldBorder
		s.Thickness = 1
	end)
	return box
end

local function makeButton(text, parent, kind)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 36)
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.Parent = parent or currentParent
	corner(b, 8)
	if kind == "primary" then
		b.TextColor3 = palette.ink
		b.BackgroundColor3 = palette.accent
		stroke(b, palette.accentBorder, 1)
	elseif kind == "danger" then
		b.TextColor3 = Color3.fromRGB(252, 165, 165)
		b.BackgroundColor3 = palette.dangerBg
		stroke(b, palette.dangerBorder, 1)
	else
		b.TextColor3 = palette.text
		b.BackgroundColor3 = Color3.fromRGB(28, 33, 45)
		b.Font = Enum.Font.GothamMedium
		stroke(b, palette.line, 1)
	end
	return b
end

local function card(parent, name)
	local f = container(parent, name)
	f.BackgroundTransparency = 0
	f.BackgroundColor3 = palette.card
	pad(f, 14, 14)
	corner(f, 10)
	stroke(f, palette.cardBorder, 1)
	return f
end


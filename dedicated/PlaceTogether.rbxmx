local function setNotice(message)
	local nl = message:find(string.char(10), 1, true)
	local line = nl and message:sub(1, nl - 1) or message
	if line:sub(-1) == string.char(13) then line = line:sub(1, -2) end
	notice.Text = line
end

local function refreshUI(isActive, isLoggedIn, hasInbox, isBusy)
	projectsPanel.Visible = uiTab == "projects"
	sessionPanel.Visible = uiTab == "session"
	settingsPanel.Visible = uiTab == "settings"
	identity.Text = isLoggedIn and (selfNick.Text..(isActive and " · In Session" or " · Ready")) or "Connecting to server..."

	if isActive then
		dot.BackgroundColor3 = palette.green
		statusBadgeLabel.Text = "LIVE"
		statusBadgeLabel.TextColor3 = palette.green
		badgeStroke.Color = palette.green
	elseif isLoggedIn then
		dot.BackgroundColor3 = palette.accent
		statusBadgeLabel.Text = "READY"
		statusBadgeLabel.TextColor3 = palette.accent
		badgeStroke.Color = palette.line
	else
		dot.BackgroundColor3 = palette.muted
		statusBadgeLabel.Text = "OFFLINE"
		statusBadgeLabel.TextColor3 = palette.muted
		badgeStroke.Color = palette.line
	end

	sessionCard.Visible = isActive
	connect.Visible = isActive
	btnForcePush.Visible = isActive
	btnForcePull.Visible = isActive
	btnFocusBuild.Visible = isActive
	btnDeleteActiveRoom.Visible = isActive and not activeDelConfirm.Visible
	if not isActive then
		activeDelConfirm.Visible = false
	end
	incomingCard.Visible = hasInbox
	retry.Visible = isLoggedIn and not isActive and room.Text ~= ""

	for key, b in pairs(tabButtons) do
		local isSelected = uiTab == key
		b.BackgroundColor3 = isSelected and palette.tabActive or palette.tabBg
		b.TextColor3 = isSelected and palette.text or palette.muted
		b.Font = isSelected and Enum.Font.GothamBold or Enum.Font.GothamMedium
		if tabStrokes[key] then
			tabStrokes[key].Enabled = isSelected
			tabStrokes[key].Color = isSelected and palette.cardBorder or palette.line
		end
	end
	for _, b in ipairs({btnConnectProject, btnCreateProject, btnRefreshProjects, btnForcePush, btnForcePull, btnFocusBuild, btnDeleteActiveRoom, activeDelCancel, activeDelExec, invite, yes, no, connect, retry, accept, logout}) do
		b.Active = not isBusy
		b.AutoButtonColor = not isBusy
		b.TextTransparency = isBusy and .45 or 0
	end
end

button.Click:Connect(function() widget.Enabled = not widget.Enabled end)
refreshUI(false, false, false, false)

-- ============================================================
-- HIGH-PERFORMANCE ZERO-LAG SYNC ENGINE
-- ============================================================
local active = false
local busy = false
local restoreSuppressed = false
local objects, ids, baseline, versions = {}, {}, {}, {}
local endpoint, credential
local currentRevision = 0

-- DIRTY TRACKING QUEUES (EVENT-DRIVEN: 0% CPU WHEN IDLE)
local dirtyObjects = {}
local dirtyDeleted = {}
local cachedSnapshot = {}
local initialScanDone = false

local Reflection = game:GetService("ReflectionService")
local Assets = game:GetService("AssetService")
local Collection = game:GetService("CollectionService")
local propertyCache = {}
local pending = {}
local meshRetry = {}
local referenceRetry = {}
local appearanceRetry = {}
local warnings = {}

local function status(s) setNotice(s) end
local function formatCount(n)
	n = tonumber(n) or 0
	if n >= 1000000 then
		local m = n / 1000000
		return string.format(m >= 10 and "%.0fM" or "%.1fM", m):gsub("%.0M", "M")
	elseif n >= 1000 then
		local k = n / 1000
		return string.format(k >= 10 and "%.0fk" or "%.1fk", k):gsub("%.0k", "k")
	else
		return tostring(n)
	end
end
local function warn(key, message) warnings[key] = message end
local function warningText()
	local count = 0; local sample = {}
	for _, message in pairs(warnings) do count += 1; if #sample < 2 then table.insert(sample, message) end end
	return count > 0 and (string.char(10).."Limitations ("..count.."): "..table.concat(sample, "; ")) or ""
end

local function equal(a, b)
	if type(a) ~= type(b) then return false end
	if type(a) == "number" then
		if a ~= a or b ~= b then return a == b end
		return math.abs(a - b) < 0.005
	end
	if type(a) ~= "table" then return a == b end
	for k, v in pairs(a) do if not equal(v, b[k]) then return false end end
	for k in pairs(b) do if a[k] == nil then return false end end
	return true
end

local function copy(value)
	if type(value) ~= "table" then return value end
	local result = {}; for key, item in pairs(value) do result[key] = copy(item) end; return result
end

local function merge(base, localValue, remote)
	if equal(localValue, base) then return copy(remote) end
	if equal(remote, base) or equal(localValue, remote) then return copy(localValue) end
	if type(localValue) ~= "table" or type(remote) ~= "table" or localValue.t or remote.t then return copy(localValue) end
	if localValue.class == nil and localValue.props == nil and #localValue > 0 then return copy(localValue) end
	local result = {}; local keys = {}
	for key in pairs(localValue) do keys[key] = true end; for key in pairs(remote) do keys[key] = true end
	if type(base) == "table" then for key in pairs(base) do keys[key] = true end end
	for key in pairs(keys) do
		local previous; if type(base) == "table" then previous = base[key] end
		result[key] = merge(previous, localValue[key], remote[key])
	end
	return result
end

local function acknowledged(remote, desired, actual)
	if equal(remote, desired) then return copy(actual) end
	if type(remote) ~= "table" or type(desired) ~= "table" or type(actual) ~= "table" then return copy(remote) end
	local result = {}; local keys = {}
	for key in pairs(remote) do keys[key] = true end
	for key in pairs(desired) do keys[key] = true end
	for key in pairs(actual) do keys[key] = true end
	for key in pairs(keys) do result[key] = acknowledged(remote[key], desired[key], actual[key]) end
	return result
end

-- ============================================================
-- OPTIMIZED TERRAIN ENGINE (REACTIVE ONLY - NO IDLE VOXEL SCANS)
-- ============================================================
local terrainCache = {}
local terrainKnown = {}
local dirtyTerrainChunks = {}
local CHUNK, VOXELS = 64, 16

local function terrainKey(x, y, z) return "~Terrain/"..x.."/"..y.."/"..z end
local function terrainRegion(origin)
	return Region3.new(Vector3.new(table.unpack(origin)), Vector3.new(origin[1] + CHUNK, origin[2] + CHUNK, origin[3] + CHUNK))
end

local function readTerrain(origin)
	local channels = workspace.Terrain:ReadVoxelChannels(terrainRegion(origin), 4, {"SolidMaterial", "SolidOccupancy", "LiquidOccupancy"})
	local runs = {}; local previous; local nonempty = false
	for x = 1, VOXELS do for y = 1, VOXELS do for z = 1, VOXELS do
				local material = channels.SolidMaterial[x][y][z].Name
				local solid, liquid = channels.SolidOccupancy[x][y][z], channels.LiquidOccupancy[x][y][z]
				if solid > 0 or liquid > 0 then nonempty = true end
				if previous and previous[1] == material and previous[2] == solid and previous[3] == liquid then
					previous[4] += 1
				else
					previous = {material, solid, liquid, 1}
					table.insert(runs, previous)
				end
			end end end
	if not nonempty then return nil end
	return {class = "PTTerrainChunk", name = "Terrain chunk", parent = "@Workspace", props = {origin = origin, runs = runs}}
end

local function writeTerrain(origin, runs)
	local channels = {SolidMaterial = {}, SolidOccupancy = {}, LiquidOccupancy = {}}
	local runIndex, remaining = 1, runs[1] and runs[1][4] or 0
	local written = 0
	for x = 1, VOXELS do
		for _, array in pairs(channels) do array[x] = {} end
		for y = 1, VOXELS do
			for _, array in pairs(channels) do array[x][y] = {} end
			for z = 1, VOXELS do
				while remaining == 0 and runIndex < #runs do runIndex += 1; remaining = runs[runIndex][4] end
				local run = runs[runIndex]; if not run or remaining < 1 then error("Corrupted Terrain packet") end
				local material = Enum.Material[run[1]]; if not material then error("Unknown Terrain material") end
				channels.SolidMaterial[x][y][z] = material; channels.SolidOccupancy[x][y][z] = run[2]; channels.LiquidOccupancy[x][y][z] = run[3]
				remaining -= 1; written += 1
			end
		end
	end
	if written ~= 4096 or runIndex ~= #runs or remaining ~= 0 then error("Invalid Terrain packet size") end
	workspace.Terrain:WriteVoxelChannels(terrainRegion(origin), 4, channels)
end

local function terrainReset()
	terrainCache = {}
	terrainKnown = {}
	table.clear(dirtyTerrainChunks)
end

-- PURE EVENT-DRIVEN TERRAIN: only triggers when user actually sculpts or paints
pcall(function()
	workspace.Terrain.TerrainModified:Connect(function(region)
		pcall(function()
			local minV = region.Min; local maxV = region.Max
			local x0 = math.floor((minV.X * 4) / CHUNK) * CHUNK; local x1 = math.floor((maxV.X * 4) / CHUNK) * CHUNK
			local y0 = math.floor((minV.Y * 4) / CHUNK) * CHUNK; local y1 = math.floor((maxV.Y * 4) / CHUNK) * CHUNK
			local z0 = math.floor((minV.Z * 4) / CHUNK) * CHUNK; local z1 = math.floor((maxV.Z * 4) / CHUNK) * CHUNK
			for x = x0, x1, CHUNK do for y = y0, y1, CHUNK do for z = z0, z1, CHUNK do
				dirtyTerrainChunks[terrainKey(x, y, z)] = {x, y, z}
			end end end
		end)
	end)
end)

local function terrainRecords()
	-- FAST PATH: If no terrain was modified by the user, return cache instantly (< 0.001ms)
	if not next(dirtyTerrainChunks) then
		return terrainCache
	end

	for key, origin in pairs(dirtyTerrainChunks) do
		local value = readTerrain(origin)
		terrainCache[key] = value
		if value or terrainKnown[key] then terrainKnown[key] = origin end
		dirtyTerrainChunks[key] = nil
	end
	return terrainCache
end

local function applyTerrain(key, value)
	local origin = value and value.props.origin or terrainKnown[key]
	if not origin then return end
	local ok, err = pcall(function()
		if #origin ~= 3 then error("Invalid Terrain position") end
		writeTerrain(origin, value and value.props.runs or {{"Air", 0, 0, 4096}})
	end)
	if ok then terrainKnown[key] = origin; terrainCache[key] = copy(value); warnings[key..":terrain"] = nil
	else warn(key..":terrain", "Terrain: "..tostring(err)) end
end

local function encode(v)
	local t = typeof(v)
	if t == "nil" then return {t = "Nil"} end
	if t == "string" or t == "boolean" then return v end
	if t == "number" then if v == v and math.abs(v) < math.huge then return v end; return nil end
	if t == "Vector3" or t == "Vector3int16" then return {t = t, v = {v.X, v.Y, v.Z}} end
	if t == "Vector2" or t == "Vector2int16" then return {t = t, v = {v.X, v.Y}} end
	if t == "Color3" then return {t = t, v = {v.R, v.G, v.B}} end
	if t == "CFrame" then return {t = t, v = {v:GetComponents()}} end
	if t == "UDim2" then return {t = t, v = {v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset}} end
	if t == "UDim" then return {t = t, v = {v.Scale, v.Offset}} end
	if t == "BrickColor" then return {t = t, v = v.Number} end
	if t == "NumberRange" then return {t = t, v = {v.Min, v.Max}} end
	if t == "Rect" then return {t = t, v = {v.Min.X, v.Min.Y, v.Max.X, v.Max.Y}} end
	if t == "NumberSequence" then local a = {}; for _, k in ipairs(v.Keypoints) do table.insert(a, {k.Time, k.Value, k.Envelope}) end; return {t = t, v = a} end
	if t == "ColorSequence" then local a = {}; for _, k in ipairs(v.Keypoints) do table.insert(a, {k.Time, k.Value.R, k.Value.G, k.Value.B}) end; return {t = t, v = a} end
	if t == "PhysicalProperties" then return {t = t, v = {v.Density, v.Friction, v.Elasticity, v.FrictionWeight, v.ElasticityWeight}} end
	if t == "Font" then return {t = t, v = {v.Family, v.Weight.Name, v.Style.Name}} end
	if t == "Ray" then return {t = t, o = encode(v.Origin), d = encode(v.Direction)} end
	if t == "Axes" then return {t = t, v = {v.X, v.Y, v.Z}} end
	if t == "Faces" then return {t = t, v = {v.Top, v.Bottom, v.Left, v.Right, v.Front, v.Back}} end
	if t == "EnumItem" then return {t = t, e = tostring(v.EnumType):gsub("^Enum%.", ""), v = v.Name} end
	if t == "Instance" then
		if ids[v] then return {t = t, v = ids[v]} end
		if v.Parent == game then return {t = "Service", v = v.ClassName} end
		if v == workspace.Terrain then return {t = "Terrain"} end
		if v == workspace.CurrentCamera then return {t = "CurrentCamera"} end
		return nil
	end
	if t == "Content" then
		if v.SourceType == Enum.ContentSourceType.None then return {t = t, v = ""} end
		if v.SourceType == Enum.ContentSourceType.Uri then return {t = t, v = v.Uri} end
		return nil
	end
	return nil
end

local function decode(v)
	if type(v) ~= "table" then return v end
	local t = v.t
	if t == "Nil" then return nil end
	if t == "Vector3" then return Vector3.new(table.unpack(v.v)) end
	if t == "Vector3int16" then return Vector3int16.new(table.unpack(v.v)) end
	if t == "Vector2" then return Vector2.new(table.unpack(v.v)) end
	if t == "Vector2int16" then return Vector2int16.new(table.unpack(v.v)) end
	if t == "Color3" then return Color3.new(table.unpack(v.v)) end
	if t == "CFrame" then return CFrame.new(table.unpack(v.v)) end
	if t == "UDim2" then return UDim2.new(table.unpack(v.v)) end
	if t == "UDim" then return UDim.new(table.unpack(v.v)) end
	if t == "BrickColor" then return BrickColor.new(v.v) end
	if t == "NumberRange" then return NumberRange.new(table.unpack(v.v)) end
	if t == "Rect" then return Rect.new(table.unpack(v.v)) end
	if t == "NumberSequence" then local a = {}; for _, k in ipairs(v.v) do table.insert(a, NumberSequenceKeypoint.new(table.unpack(k))) end; return NumberSequence.new(a) end
	if t == "ColorSequence" then local a = {}; for _, k in ipairs(v.v) do table.insert(a, ColorSequenceKeypoint.new(k[1], Color3.new(k[2], k[3], k[4]))) end; return ColorSequence.new(a) end
	if t == "PhysicalProperties" then return PhysicalProperties.new(table.unpack(v.v)) end
	if t == "Font" then return Font.new(v.v[1], Enum.FontWeight[v.v[2]], Enum.FontStyle[v.v[3]]) end
	if t == "Ray" then return Ray.new(decode(v.o), decode(v.d)) end
	if t == "Axes" then local a = {}; for i, b in ipairs(v.v) do if b then table.insert(a, ({Enum.Axis.X, Enum.Axis.Y, Enum.Axis.Z})[i]) end end; return Axes.new(table.unpack(a)) end
	if t == "Faces" then local a = {}; for i, b in ipairs(v.v) do if b then table.insert(a, ({Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Front, Enum.NormalId.Back})[i]) end end; return Faces.new(table.unpack(a)) end
	if t == "EnumItem" then return Enum[v.e][v.v] end
	if t == "Instance" then return objects[v.v] end
	if t == "Service" then return game:GetService(v.v) end
	if t == "Terrain" then return workspace.Terrain end
	if t == "CurrentCamera" then return workspace.CurrentCamera end
	if t == "Content" then return v.v == "" and Content.none or Content.fromUri(v.v) end
	error("Unknown type "..tostring(t))
end

local denied = {Name = true, Parent = true, ClassName = true, Source = true, UniqueId = true, HistoryId = true, Capabilities = true, Sandboxed = true, DefinesCapabilities = true, RobloxLocked = true, Tags = true, Attributes = true, AttributesSerialize = true, AttributesReplicate = true}
local physics = {AssemblyLinearVelocity = true, AssemblyAngularVelocity = true, Velocity = true, RotVelocity = true, ReceiveAge = true}
local publicEdit = {Size = true, Color = true, Shape = true, MaterialVariant = true, Archivable = true, WorldPivot = true, ImageContent = true, AudioContent = true, MeshContent = true, TextureContent = true, ColorMapContent = true, CameraOffset = true, Health = true, Axis = true, SecondaryAxis = true}
local appearanceProps = {"Image", "ImageContent", "ImageColor3", "ImageTransparency", "ImageRectOffset", "ImageRectSize", "ScaleType", "SliceCenter", "SliceScale", "TileSize", "ResampleMode", "Texture", "TextureContent", "TextureID", "ColorMap", "ColorMapContent", "NormalMap", "NormalMapContent", "RoughnessMap", "RoughnessMapContent", "MetalnessMap", "MetalnessMapContent", "EmissiveMaskContent", "EmissiveStrength", "EmissiveTint", "AlphaMode", "Color", "Transparency", "Face", "StudsPerTileU", "StudsPerTileV", "OffsetStudsU", "OffsetStudsV"}
local appearanceSet = {}; for _, name in ipairs(appearanceProps) do appearanceSet[name] = true end
local contentAliases = {Image = "ImageContent", Texture = "TextureContent", ColorMap = "ColorMapContent", NormalMap = "NormalMapContent", RoughnessMap = "RoughnessMapContent", MetalnessMap = "MetalnessMapContent"}

local function properties(obj)
	local class = obj.ClassName
	if propertyCache[class] then return propertyCache[class] end
	local list = {}; local seen = {}
	local function add(name)
		if not seen[name] and not denied[name] and not physics[name] then
			local modern = contentAliases[name]
			if modern then local readable, value = pcall(function() return obj[modern] end); if readable and typeof(value) == "Content" then return end end
			if obj:IsA("BasePart") and (name == "Position" or name == "Orientation" or name == "Rotation" or name == "BrickColor" or name == "CollisionGroupId") then return end
			if obj:IsA("Attachment") and (name == "Position" or name == "Orientation" or name == "Rotation") then return end
			if obj:IsA("BaseScript") and name == "Enabled" then return end
			if name == "MeshContent" or name == "MeshSize" or name == "MeshId" or name == "CollisionFidelity" or name == "RenderFidelity" or name == "FluidFidelity" then if obj:IsA("MeshPart") then return end end
			seen[name] = true; table.insert(list, name)
		end
	end
	local ok, info = pcall(function() return Reflection:GetPropertiesOfClass(class, {ExcludeDisplay = true}) end)
	if ok and info then for _, p in ipairs(info) do if (p.Serialized or publicEdit[p.Name]) and p.Permits and p.Permits.Write ~= nil then add(p.Name) end end end
	for _, group in ipairs({common, props}) do for _, name in ipairs(group) do local good = pcall(function() return obj[name] end); if good then add(name) end end end
	for _, name in ipairs(appearanceProps) do local good = pcall(function() return obj[name] end); if good then add(name) end end
	propertyCache[class] = list; return list
end

local function isToolboxDescendant(obj)
	local cur = obj.Parent
	while cur and cur ~= game and cur ~= workspace do
		if cur:IsA("Model") then
			local tbId = 0
			pcall(function() if cur.SourceAssetId and cur.SourceAssetId > 0 then tbId = cur.SourceAssetId end end)
			if tbId == 0 then
				local attr = cur:GetAttribute("SourceAssetId") or cur:GetAttribute("AssetId") or cur:GetAttribute("ToolboxAssetId")
				if tonumber(attr) and tonumber(attr) > 0 then tbId = tonumber(attr) end
			end
			if tbId > 0 then return true end
		end
		cur = cur.Parent
	end
	return false
end

local function isAnimationArtifact(obj)
	if not obj then return false end
	local name = obj.Name
	if name == "CameraRig" or name == "RootCam" or name == "TemporaryScriptFolder" then
		return true
	end
	return false
end

local function isRigLimb(part)
	if not part or not part:IsA("BasePart") then return false end
	local m = part:FindFirstAncestorWhichIsA("Model")
	if not m or m == workspace then return false end
	local humanoid = m:FindFirstChildOfClass("Humanoid") or m:FindFirstChildOfClass("AnimationController")
	if not humanoid or part.Name == "HumanoidRootPart" or part == m.PrimaryPart then return false end
	if part:FindFirstAncestorWhichIsA("Accessory") then return false end

	-- 1. Direct joint check
	local ok, joints = pcall(function() return part:GetJoints() end)
	if ok and joints then
		for _, joint in ipairs(joints) do
			if joint:IsA("Motor6D") and (joint.Part1 == part or joint.Part0 == part) then
				return true
			end
		end
	end

	-- 2. Safe descendant traversal: EVERY property access wrapped in pcall
	local okD, descs = pcall(function() return m:GetDescendants() end)
	if okD and descs then
		for _, desc in ipairs(descs) do
			if desc:IsA("Motor6D") then
				local ok1, p1 = pcall(function() return desc.Part1 end)
				local ok0, p0 = pcall(function() return desc.Part0 end)
				if (ok1 and p1 == part) or (ok0 and p0 == part) then return true end
			elseif desc:IsA("AnimationConstraint") then
				local okAtt1, att1 = pcall(function() return desc.Attachment1 end)
				if okAtt1 and att1 and att1.Parent == part then return true end
				local okAtt0, att0 = pcall(function() return desc.Attachment0 end)
				if okAtt0 and att0 and att0.Parent == part then return true end
			elseif desc:IsA("Constraint") then
				local okAtt1, att1 = pcall(function() return desc.Attachment1 end)
				if okAtt1 and att1 and att1:IsDescendantOf(part) then return true end
			end
		end
	end

	-- 3. Standard R15/R6 limb name fallback
	local name = part.Name
	if name == "Head" or name == "UpperTorso" or name == "LowerTorso" or name == "Torso"
		or name:find("Arm") or name:find("Leg") or name:find("Hand") or name:find("Foot") then
		return true
	end

	return false
end

local function isCharacterPart(part)
	if not part or not part:IsA("BasePart") then return false end
	if part:FindFirstAncestorWhichIsA("Accessory") then return true end
	local m = part:FindFirstAncestorWhichIsA("Model")
	if not m or m == workspace then return false end
	local humanoid = m:FindFirstChildOfClass("Humanoid") or m:FindFirstChildOfClass("AnimationController")
	if humanoid then return true end
	if isRigLimb(part) then return true end
	local name = part.Name
	if name == "HumanoidRootPart" or name == "Head" or name == "UpperTorso" or name == "LowerTorso" or name:find("Leg") or name:find("Arm") or name:find("Foot") or name:find("Hand") then
		return true
	end
	return false
end

local function getRigLimbRestCFrame(part)
	if not part or not part:IsA("BasePart") then return nil end
	local m = part:FindFirstAncestorWhichIsA("Model")
	if not m or m == workspace then return nil end
	local humanoid = m:FindFirstChildOfClass("Humanoid") or m:FindFirstChildOfClass("AnimationController")
	if not humanoid or part.Name == "HumanoidRootPart" or part == m.PrimaryPart then return nil end

	local ok, descs = pcall(function() return m:GetDescendants() end)
	if ok and descs then
		for _, desc in ipairs(descs) do
			if desc:IsA("Motor6D") then
				local okJoint, res = pcall(function()
					if desc.Part1 == part and desc.Part0 and desc.Part0:IsA("BasePart") then
						return desc.Part0.CFrame * desc.C0 * desc.C1:Inverse()
					end
				end)
				if okJoint and typeof(res) == "CFrame" then return res end
			elseif desc:IsA("AnimationConstraint") then
				local okConst, res = pcall(function()
					local att0 = desc.Attachment0
					local att1 = desc.Attachment1
					if att0 and att1 then
						local p0 = att0.Parent
						local p1 = att1.Parent
						if p1 == part and p0 and p0:IsA("BasePart") then
							return p0.CFrame * att0.CFrame * att1.CFrame:Inverse()
						end
					end
				end)
				if okConst and typeof(res) == "CFrame" then return res end
			end
		end
	end
	return nil
end

local function isRigBeingAnimated(model)
	if not model or not model:IsA("Model") then return false end
	local ok, descs = pcall(function() return model:GetDescendants() end)
	if ok and descs then
		for _, desc in ipairs(descs) do
			if desc:IsA("Motor6D") then
				local okTr, tr = pcall(function() return desc.Transform end)
				if okTr and typeof(tr) == "CFrame" and tr ~= CFrame.identity then
					return true
				end
			elseif desc:IsA("AnimationConstraint") then
				local okTr, tr = pcall(function() return desc.Transform end)
				if okTr and typeof(tr) == "CFrame" and tr ~= CFrame.identity then
					return true
				end
			end
		end
	end
	local anim = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("AnimationController")
	local animator = anim and anim:FindFirstChildOfClass("Animator")
	if animator then
		local okTracks, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
		if okTracks and tracks and #tracks > 0 then
			return true
		end
	end
	return false
end

local function eligible(obj)
	return obj ~= script
		and obj ~= workspace.CurrentCamera
		and not obj:IsA("Terrain")
		and not isToolboxDescendant(obj)
		and not isAnimationArtifact(obj)
		and not (obj:IsA("Weld") and obj.Name == "AccessoryWeld")
end

local function ensureAccessoryWelds()
	for _, m in ipairs(workspace:GetDescendants()) do
		if m:IsA("Model") and (m:FindFirstChildOfClass("Humanoid") or m:FindFirstChildOfClass("AnimationController")) then
			local beingAnimated = isRigBeingAnimated(m)
			for _, acc in ipairs(m:GetChildren()) do
				if acc:IsA("Accessory") then
					local h = acc:FindFirstChild("Handle")
					if h and h:IsA("BasePart") then
						local rc = h:FindFirstChildOfClass("RigidConstraint")
						local a0 = rc and rc.Attachment0 or h:FindFirstChildOfClass("Attachment")
						local a1 = rc and rc.Attachment1
						if not a1 and a0 then
							for _, d in ipairs(m:GetDescendants()) do
								if d:IsA("Attachment") and d.Name == a0.Name and d ~= a0 and d.Parent:IsA("BasePart") then
									a1 = d
									break
								end
							end
						end
						if a1 and a1.Parent and a1.Parent:IsA("BasePart") then
							local limb = a1.Parent
							local w = h:FindFirstChild("AccessoryWeld")
							if not beingAnimated or not w or not w:IsA("Weld") or w.Part1 ~= limb then
								local c0 = a0 and a0.CFrame or CFrame.new()
								-- Mathematically preserve exact visual position: Part0.CFrame * C0 = Part1.CFrame * C1
								local c1 = limb.CFrame:Inverse() * h.CFrame * c0
								if not w or not w:IsA("Weld") or w.Part1 ~= limb then
									if w then pcall(function() w:Destroy() end) end
									pcall(function()
										local wld = Instance.new("Weld")
										wld.Name = "AccessoryWeld"
										wld.Part0 = h
										wld.Part1 = limb
										wld.C0 = c0
										wld.C1 = c1
										wld.Parent = h
									end)
								else
									pcall(function()
										w.C0 = c0
										w.C1 = c1
									end)
								end
							end
						end
						pcall(function() h.Anchored = false end)
					end
				end
			end
		end
	end
end

local function consolidateEclipseSaves()
	local ok, ss = pcall(function() return game:GetService("ServerStorage") end)
	if not ok or not ss then return end

	local roots = {}
	for _, c in ipairs(ss:GetChildren()) do
		if c.Name == "Eclipse Animator Saves" and c:IsA("Folder") then
			table.insert(roots, c)
		end
	end
	if #roots == 0 then return end

	local primary = roots[1]

	-- 1. Merge any loose Eclipse folders directly under ServerStorage into primary
	for _, child in ipairs(ss:GetChildren()) do
		if child ~= primary and (child.Name == "EclipseAnimator_Saves" or child.Name == "EclipseAnimator_Backups" or child.Name == "EclipseEffectStorage") and child:IsA("Folder") then
			local targetSub = primary:FindFirstChild(child.Name)
			if targetSub and targetSub:IsA("Folder") then
				for _, itm in ipairs(child:GetChildren()) do
					itm.Parent = targetSub
				end
				local childKey = ids[child]
				if childKey then
					local oldKey = ids[targetSub]
					if oldKey and oldKey ~= childKey then objects[oldKey] = nil; dirtyDeleted[oldKey] = nil end
					objects[childKey] = targetSub
					ids[targetSub] = childKey
					pcall(function() targetSub:SetAttribute("PT_ObjectId", childKey) end)
				end
				pcall(function() child:Destroy() end)
			else
				child.Parent = primary
			end
		end
	end

	-- 2. Merge duplicate "Eclipse Animator Saves" root folders into primary
	for i = 2, #roots do
		local dup = roots[i]
		for _, sub in ipairs(dup:GetChildren()) do
			local targetSub = primary:FindFirstChild(sub.Name)
			if targetSub and targetSub:IsA("Folder") then
				for _, item in ipairs(sub:GetChildren()) do
					local existingItem = targetSub:FindFirstChild(item.Name)
					if existingItem and existingItem ~= item then
						pcall(function() existingItem:Destroy() end)
					end
					item.Parent = targetSub
				end
				local subKey = ids[sub]
				if subKey then
					local oldKey = ids[targetSub]
					if oldKey and oldKey ~= subKey then objects[oldKey] = nil; dirtyDeleted[oldKey] = nil end
					objects[subKey] = targetSub
					ids[targetSub] = subKey
					pcall(function() targetSub:SetAttribute("PT_ObjectId", subKey) end)
				end
				pcall(function() sub:Destroy() end)
			else
				sub.Parent = primary
			end
		end
		local dupKey = ids[dup]
		if dupKey then
			local oldKey = ids[primary]
			if oldKey and oldKey ~= dupKey then objects[oldKey] = nil; dirtyDeleted[oldKey] = nil end
			objects[dupKey] = primary
			ids[primary] = dupKey
			pcall(function() primary:SetAttribute("PT_ObjectId", dupKey) end)
		end
		pcall(function() dup:Destroy() end)
	end

	-- 3. Consolidate duplicate subfolders within primary
	local seenSub = {}
	for _, sub in ipairs(primary:GetChildren()) do
		if sub:IsA("Folder") then
			if seenSub[sub.Name] then
				local targetSub = seenSub[sub.Name]
				for _, item in ipairs(sub:GetChildren()) do
					local existingItem = targetSub:FindFirstChild(item.Name)
					if existingItem and existingItem ~= item then
						pcall(function() existingItem:Destroy() end)
					end
					item.Parent = targetSub
				end
				local subKey = ids[sub]
				if subKey then
					local oldKey = ids[targetSub]
					if oldKey and oldKey ~= subKey then objects[oldKey] = nil; dirtyDeleted[oldKey] = nil end
					objects[subKey] = targetSub
					ids[targetSub] = subKey
					pcall(function() targetSub:SetAttribute("PT_ObjectId", subKey) end)
				end
				pcall(function() sub:Destroy() end)
			else
				seenSub[sub.Name] = sub
			end
		end
	end
end

local function index()
	consolidateEclipseSaves()
	ensureAccessoryWelds()
	currentRevision = 0
	objects = {}; ids = {}; baseline = {}; versions = {}; pending = {}; meshRetry = {}; referenceRetry = {}; appearanceRetry = {}; warnings = {}
	table.clear(dirtyObjects)
	table.clear(dirtyDeleted)
	cachedSnapshot = {}
	initialScanDone = false
	terrainReset()
	local function walk(parent, parentId)
		local counts = {}
		for _, obj in ipairs(parent:GetChildren()) do if eligible(obj) then
				local stem = obj.ClassName..":"..obj.Name; counts[stem] = (counts[stem] or 0) + 1
				local key = obj:GetAttribute("PT_ObjectId")
				if type(key) ~= "string" or #key > 512 or objects[key] then
					key = parentId.."/"..Http:UrlEncode(stem)..":"..counts[stem]
					if #key > 480 then key = Http:GenerateGUID(false) end
					obj:SetAttribute("PT_ObjectId", key)
				end
				objects[key] = obj; ids[obj] = key; walk(obj, key)
			end end
	end
	for _, name in ipairs(roots) do local svc = game:GetService(name); objects["@"..name] = svc; ids[svc] = "@"..name; walk(svc, "@"..name) end
	objects["@Terrain"] = workspace.Terrain; ids[workspace.Terrain] = "@Terrain"; serviceIds["@Terrain"] = true
end

local function discover(parent)
	for _, obj in ipairs(parent:GetChildren()) do if eligible(obj) then
			if not ids[obj] then local key = Http:GenerateGUID(false); ids[obj] = key; objects[key] = obj; obj:SetAttribute("PT_ObjectId", key) end
			discover(obj)
		end end
end

local function capture(obj, key)
	local p = {}
	for _, property in ipairs(properties(obj)) do
		local ok, value = pcall(function() return encode(obj[property]) end)
		if ok and value ~= nil then p[property] = value end
		if ok and value == nil and appearanceSet[property] then
			warn(key..":content:"..property, obj.Name.."."..property..": local EditableImage cannot be sent as URI; image must be published")
		else
			warnings[key..":content:"..property] = nil
		end
	end
	if obj:IsA("Model") and not p.WorldPivot then pcall(function() p.WorldPivot = encode(obj:GetPivot()) end) end
	if obj:IsA("LuaSourceContainer") then
		local ok, text = pcall(function() return Editor:GetEditorSource(obj) end)
		if not ok then ok, text = pcall(function() return obj.Source end) end
		if ok then p.Source = text:gsub(string.char(13, 10), string.char(10)):gsub(string.char(13), string.char(10)); warnings[key..":Source"] = nil else warn(key..":Source", obj.Name..": cannot access script source") end
	end
	if obj:IsA("MeshPart") then for _, name in ipairs({"MeshId", "MeshContent", "CollisionFidelity", "RenderFidelity", "FluidFidelity"}) do local ok, v = pcall(function() return encode(obj[name]) end); if ok and v then p[name] = v end end end
	if obj:IsA("BasePart") and (isRigLimb(obj) or obj:FindFirstAncestorWhichIsA("Accessory")) then
		local m = obj:FindFirstAncestorWhichIsA("Model")
		if m and isRigBeingAnimated(m) then
			if baseline[key] and baseline[key].props and baseline[key].props.CFrame then
				p.CFrame = baseline[key].props.CFrame
			elseif cachedSnapshot[key] and cachedSnapshot[key].props and cachedSnapshot[key].props.CFrame then
				p.CFrame = cachedSnapshot[key].props.CFrame
			else
				local rest = getRigLimbRestCFrame(obj)
				if rest then p.CFrame = encode(rest) end
			end
		end
	end
	local attrs = {}; for name, value in pairs(obj:GetAttributes()) do if name ~= "PT_ObjectId" then local v = encode(value); if v ~= nil then attrs[name] = v end end end
	local tags = Collection:GetTags(obj); table.sort(tags)
	local tbAssetId = 0
	if obj:IsA("Model") then
		pcall(function() if obj.SourceAssetId and obj.SourceAssetId > 0 then tbAssetId = obj.SourceAssetId end end)
		if tbAssetId == 0 then
			local attrId = obj:GetAttribute("SourceAssetId") or obj:GetAttribute("AssetId") or obj:GetAttribute("ToolboxAssetId")
			if tonumber(attrId) then tbAssetId = tonumber(attrId) end
		end
	end
	return {class = obj.ClassName, name = obj.Name, parent = ids[obj.Parent] or "@game", props = p, attributes = attrs, tags = tags, modelScale = obj:IsA("Model") and obj:GetScale() or nil, isToolbox = (tbAssetId > 0), assetId = tbAssetId}
end

-- ============================================================
-- EVENT-DRIVEN HOOKS (TRIGGERS DIRTY QUEUES AUTOMATICALLY)
-- ============================================================
local function hookHierarchy(service)
	pcall(function()
		service.DescendantAdded:Connect(function(obj)
			if eligible(obj) then
				dirtyObjects[obj] = true
				if not ids[obj] then
					local key = Http:GenerateGUID(false)
					ids[obj] = key; objects[key] = obj; obj:SetAttribute("PT_ObjectId", key)
				end
			end
		end)
		service.DescendantRemoving:Connect(function(obj)
			local key = ids[obj]
			if key then
				dirtyDeleted[key] = true
				dirtyObjects[obj] = nil
			end
		end)
	end)
end

for _, name in ipairs(roots) do
	pcall(function() hookHierarchy(game:GetService(name)) end)
end

-- Selection-driven property listener: listens to Changed on objects developer interacts with
local selectionConnections = {}
pcall(function()
	Selection.SelectionChanged:Connect(function()
		for _, c in ipairs(selectionConnections) do pcall(function() c:Disconnect() end) end
		table.clear(selectionConnections)
		for _, obj in ipairs(Selection:Get()) do
			if eligible(obj) then
				local isLimb = obj:IsA("BasePart") and isRigLimb(obj)
				local isAcc = obj:IsA("BasePart") and obj:FindFirstAncestorWhichIsA("Accessory") ~= nil
				local m = obj:IsA("Model") and obj or obj:FindFirstAncestorWhichIsA("Model")
				if not isLimb and not isAcc and not (m and isRigBeingAnimated(m)) then
					dirtyObjects[obj] = true
				end
				local ok, conn = pcall(function()
					return obj.Changed:Connect(function(prop)
						if (prop == "CFrame" or prop == "Position" or prop == "Orientation") and obj:IsA("BasePart") and (isRigLimb(obj) or obj:FindFirstAncestorWhichIsA("Accessory")) then
							return
						end
						local curM = obj:IsA("Model") and obj or obj:FindFirstAncestorWhichIsA("Model")
						if curM and isRigBeingAnimated(curM) then
							return
						end
						dirtyObjects[obj] = true
					end)
				end)
				if ok and conn then table.insert(selectionConnections, conn) end
			end
		end
	end)
end)

-- ChangeHistoryService listener (tracks Studio Undo/Redo/Property actions)
pcall(function()
	ChangeHistoryService.OnUndo:Connect(function()
		for _, obj in pairs(objects) do if eligible(obj) then dirtyObjects[obj] = true end end
	end)
	ChangeHistoryService.OnRedo:Connect(function()
		for _, obj in pairs(objects) do if eligible(obj) then dirtyObjects[obj] = true end end
	end)
end)

-- INCREMENTAL FAST SNAPSHOT (0ms when nothing changed)
local function snapshot(forceFull)
	if forceFull or not initialScanDone or next(cachedSnapshot) == nil then
		for _, name in ipairs(roots) do discover(game:GetService(name)) end
		cachedSnapshot = {}
		for key, obj in pairs(objects) do
			if obj.Parent and (serviceIds[key] or ids[obj.Parent]) then
				local ok, value = pcall(capture, obj, key)
				if ok then
					cachedSnapshot[key] = value
				else
					warn(key..":capture_err", obj.Name .. " (" .. obj.ClassName .. "): capture failed: " .. tostring(value))
					cachedSnapshot[key] = baseline[key]
				end
			end
		end
		for key, value in pairs(terrainRecords()) do cachedSnapshot[key] = value end
		table.clear(dirtyObjects)
		table.clear(dirtyDeleted)
		initialScanDone = true
		return cachedSnapshot
	end

	-- Incremental: apply deletions
	if next(dirtyDeleted) then
		for key in pairs(dirtyDeleted) do
			cachedSnapshot[key] = nil
		end
		table.clear(dirtyDeleted)
	end

	-- Incremental: capture dirty objects
	if next(dirtyObjects) then
		for obj in pairs(dirtyObjects) do
			if obj and obj.Parent and eligible(obj) then
				if not ids[obj] then
					local key = Http:GenerateGUID(false)
					ids[obj] = key; objects[key] = obj; obj:SetAttribute("PT_ObjectId", key)
				end
				local key = ids[obj]
				if key then
					local ok, value = pcall(capture, obj, key)
					if ok then cachedSnapshot[key] = value end
				end
			end
		end
		table.clear(dirtyObjects)
	end

	-- Incremental: terrain updates
	if next(dirtyTerrainChunks) then
		for key, value in pairs(terrainRecords()) do
			cachedSnapshot[key] = value
		end
	end

	return cachedSnapshot
end

base = function()
	local a = (address and address.Text or ""):gsub("%s+", ""):gsub("/+$", "")
	if a == "" or a == "http://" or a == "https://" then
		a = plugin:GetSetting("PTAddress") or "http://127.0.0.1:8787"
		a = tostring(a):gsub("%s+", ""):gsub("/+$", "")
	end
	return a
end

local function request(method, payload, renewed)
	if not alive then return {} end
	local reqUrl = endpoint

	if method == "GET" then
		reqUrl = reqUrl .. (reqUrl:find("?") and "&" or "?") .. "_t=" .. tostring(os.clock())
		if currentRevision and currentRevision > 0 then
			reqUrl = reqUrl .. "&since=" .. tostring(currentRevision)
		end
	end

	local authHeader = "Bearer " .. (credential or token.Text or "")
	local response = Http:RequestAsync({Url = reqUrl, Method = method, Headers = {Authorization = authHeader, ["Content-Type"] = "application/json", ["bypass-tunnel-reminder"] = "true"}, Body = payload and Http:JSONEncode(payload) or nil})

	if response.StatusCode == 401 and guestEnter and not renewed then guestEnter(); return request(method, payload, true) end
	local decoded, value = pcall(function() return Http:JSONDecode(response.Body) end)
	if not decoded then error("Server returned invalid response (HTTP "..response.StatusCode.."). Retrying...") end
	if response.StatusCode == 409 and method == "POST" then value.conflict = true; return value end
	if not response.Success then error(value.error or ("HTTP "..response.StatusCode)) end
	return value
end

api = function(path, method, payload, renewed)
	if not alive then return {} end
	local reqUrl = base().."/api"..path
	if (method or "GET") == "GET" then
		reqUrl = reqUrl .. (reqUrl:find("?") and "&" or "?") .. "_t=" .. tostring(os.clock())
	end

	local authHeader = "Bearer " .. (credential or token.Text or "")
	local response = Http:RequestAsync({Url = reqUrl, Method = method or "GET", Headers = {Authorization = authHeader, ["Content-Type"] = "application/json", ["bypass-tunnel-reminder"] = "true"}, Body = payload and Http:JSONEncode(payload) or nil})
	if response.StatusCode == 401 and path ~= "/guest" and path ~= "/rooms/auth" and not path:find("/delete") and not renewed then guestEnter(); return api(path, method, payload, true) end
	local decoded, data = pcall(function() return Http:JSONDecode(response.Body) end)
	if not decoded then error("Server unavailable (HTTP "..response.StatusCode.."). Check server address and verify server is running.") end
	if not response.Success then error(data.error or ("HTTP "..response.StatusCode)) end
	return data
end

local function meshSource(value)
	local p = value.props
	if type(p.MeshId) == "string" and p.MeshId ~= "" then return Content.fromUri(p.MeshId) end
	if p.MeshContent and p.MeshContent.t == "Content" and p.MeshContent.v ~= "" then return decode(p.MeshContent) end
	return nil
end

local function loadMesh(obj, key, value)
	if not obj:IsA("MeshPart") then return end
	local source = meshSource(value); if not source then return end
	local p = value.props
	local ok, current = pcall(function() return obj.MeshId end)
	if ok and type(p.MeshId) == "string" and current == p.MeshId then return end
	if meshRetry[key] and meshRetry[key] > os.clock() then return end
	local success, err = pcall(function()
		local options = {}; for _, name in ipairs({"CollisionFidelity", "RenderFidelity", "FluidFidelity"}) do if p[name] then options[name] = decode(p[name]) end end
		local fresh = Assets:CreateMeshPartAsync(source, options); if not fresh then error("Roblox did not return mesh geometry") end
		local targetCf = (p and p.CFrame and decode(p.CFrame)) or obj.CFrame
		obj:ApplyMesh(fresh)
		pcall(function() obj.CFrame = targetCf end)
		fresh:Destroy()
	end)
	if success then meshRetry[key] = nil; warnings[key..":mesh"] = nil
	else meshRetry[key] = os.clock() + 15; warn(key..":mesh", value.name..": Roblox refused to load mesh; other parts continue syncing") end
end

local function apply(remote, sent, force)
	local before = cachedSnapshot
	local changed = {}
	local partsToUnanchor = {}
	local constraintsToEnable = {}
	for key, record in pairs(remote) do
		if force or versions[key] ~= record.version or pending[key] or meshRetry[key] or referenceRetry[key] or (appearanceRetry[key] and appearanceRetry[key] <= os.clock()) then
			changed[key] = {version = record.version, value = force and copy(record.value) or merge(baseline[key], before[key], record.value)}
		end
	end

	local totalChanged = 0
	for _ in pairs(changed) do totalChanged += 1 end

	local createdCount = 0
	for key, r in pairs(changed) do
		if r.value and r.value.class ~= "PTTerrainChunk" and not objects[key] and not (r.value.class == "Weld" and (r.value.name == "AccessoryWeld" or key:find("AccessoryWeld"))) then
			createdCount += 1
			if totalChanged > 50 and (createdCount % 120 == 0 or createdCount == totalChanged) then
				status("Creating: " .. formatCount(createdCount) .. "/" .. formatCount(totalChanged) .. "...")
				task.wait()
			end
			if r.value.isToolbox and r.value.assetId and r.value.assetId > 0 then
				pending[key] = true
				task.spawn(function()
					local ok, asset = pcall(function() return InsertService:LoadAsset(r.value.assetId) end)
					if ok and asset then
						local model = asset:GetChildren()[1] or asset
						model.Name = r.value.name; model:SetAttribute("PT_ObjectId", key); objects[key] = model; ids[model] = key
						local targetPivot = r.value.props and (r.value.props.WorldPivot or r.value.props.CFrame)
						if targetPivot then pcall(function() model.WorldPivot = decode(targetPivot) end) end
						if r.value.modelScale then pcall(function() model:ScaleTo(r.value.modelScale) end) end
						model.Parent = objects[r.value.parent] or workspace; asset:Destroy()
						pending[key] = nil
						status("Toolbox model loaded: "..model.Name)
					else
						local ok2, obj = pcall(Instance.new, r.value.class)
						if ok2 then
							if obj:IsA("BasePart") then for _, s in ipairs({"TopSurface", "BottomSurface", "LeftSurface", "RightSurface", "FrontSurface", "BackSurface"}) do obj[s] = Enum.SurfaceType.Smooth end end
							obj:SetAttribute("PT_ObjectId", key); objects[key] = obj; ids[obj] = key; pending[key] = nil; warnings[key..":create"] = nil
						end
					end
				end)
			else
				local ok, obj = pcall(Instance.new, r.value.class)
				if not ok and r.value.class == "MeshPart" then
					local src = meshSource(r.value)
					if src then
						ok, obj = pcall(function() return Assets:CreateMeshPartAsync(src) end)
					end
				end
				if ok then
					if obj:IsA("BasePart") then
						for _, s in ipairs({"TopSurface", "BottomSurface", "LeftSurface", "RightSurface", "FrontSurface", "BackSurface"}) do obj[s] = Enum.SurfaceType.Smooth end
						obj.Anchored = true
						if r.value.props then
							if r.value.props.Size then pcall(function() obj.Size = decode(r.value.props.Size) end) end
							if r.value.props.CFrame then pcall(function() obj.CFrame = decode(r.value.props.CFrame) end) end
						end
					end
					obj:SetAttribute("PT_ObjectId", key); objects[key] = obj; ids[obj] = key; pending[key] = nil; warnings[key..":create"] = nil
				else pending[key] = true; warn(key..":create", r.value.name..": class cannot be created via API") end
			end
		end
	end
	for key, r in pairs(changed) do local v = r.value; local obj = objects[key]
		if v and obj then
			local ok = pcall(function()
				if obj.Name ~= v.name then obj.Name = v.name end
				if not serviceIds[key] then
					local parent = objects[v.parent]
					if not parent then error("Parent unavailable") end
					if obj.Parent ~= parent then
						if obj:IsA("Folder") and (parent == game:GetService("ServerStorage") or parent:IsDescendantOf(game:GetService("ServerStorage"))) then
							local existing = parent:FindFirstChild(v.name)
							if existing and existing:IsA("Folder") and existing ~= obj then
								local existingKey = ids[existing]
								if not existingKey or not remote[existingKey] then
									for _, ch in ipairs(obj:GetChildren()) do
										ch.Parent = existing
									end
									if existingKey then
										objects[existingKey] = nil
										dirtyDeleted[existingKey] = nil
									end
									ids[obj] = nil
									objects[key] = existing
									ids[existing] = key
									pcall(function() existing:SetAttribute("PT_ObjectId", key) end)
									obj:Destroy()
									obj = existing
								end
							end
						end
						if obj.Parent ~= parent then obj.Parent = parent end
					end
				end
			end)
			if ok then pending[key] = nil; warnings[key..":parent"] = nil else pending[key] = true; warn(key..":parent", v.name..": waiting for parent object") end
		end
	end
	local models = {}
	for key, r in pairs(changed) do local obj = objects[key]; if r.value and obj and obj:IsA("Model") and r.value.modelScale then table.insert(models, {key = key, record = r, obj = obj}) end end
	local function depth(obj) local n = 0; while obj.Parent do n += 1; obj = obj.Parent end; return n end
	table.sort(models, function(a, b) return depth(a.obj) < depth(b.obj) end)
	for _, item in ipairs(models) do
		local value = item.record.value.modelScale
		if type(value) == "number" and value > 0 and math.abs(item.obj:GetScale() - value) > 1e-6 then
			local safe = true
			if not force then for _, child in ipairs(item.obj:GetDescendants()) do local key = ids[child]; if key and not equal(before[key], sent[key]) then safe = false; break end end end
			if safe then local ok = pcall(function() item.obj:ScaleTo(value) end); if ok then warnings[item.key..":scale"] = nil else warn(item.key..":scale", item.obj.Name..": model scale unavailable") end end
		end
	end
	local appliedCount = 0
	for key, r in pairs(changed) do local v = r.value; local obj = objects[key]
		appliedCount += 1
		if force and totalChanged > 50 and (appliedCount % 60 == 0 or appliedCount == totalChanged) then
			status("Loading place: " .. formatCount(appliedCount) .. "/" .. formatCount(totalChanged) .. " (" .. math.floor(appliedCount / totalChanged * 100) .. "%)")
			task.wait()
		end
		if not v then appearanceRetry[key] = nil end
		if v and obj and not pending[key] then
			referenceRetry[key] = nil
			appearanceRetry[key] = nil
			loadMesh(obj, key, v)
			local values = {}
			for name, value in pairs(v.props) do if not (obj:IsA("MeshPart") and (name == "MeshId" or name == "MeshContent" or name == "CollisionFidelity" or name == "RenderFidelity" or name == "FluidFidelity")) then table.insert(values, {name, value}) end end
			local function priority(pair)
				local name, value = pair[1], pair[2]
				if name == "Shape" then return 0 end
				if name == "Size" then return 2 end
				if name == "CFrame" or name == "WorldPivot" then return 3 end
				if type(value) == "table" and value.t == "Instance" then return 4 end
				if name == "Source" then return 5 end
				return 1
			end
			table.sort(values, function(a, b) local aa, bb = priority(a), priority(b); if aa == bb then return a[1] < b[1] end; return aa < bb end)
			for _, pair in ipairs(values) do local name, value = pair[1], pair[2]
				local ok = pcall(function()
					if type(value) == "table" and value.t == "Instance" and not objects[value.v] then referenceRetry[key] = true; error("Linked instance still loading") end
					if name == "Source" and obj:IsA("LuaSourceContainer") then if Editor:GetEditorSource(obj) ~= value then Editor:UpdateSourceAsync(obj, function() return value end) end
					elseif obj:IsA("Model") and (name == "CFrame" or name == "WorldPivot") then local cf = decode(value); if typeof(cf) == "CFrame" then pcall(function() obj.WorldPivot = cf end) end
					elseif name == "Anchored" and obj:IsA("BasePart") then
						if isCharacterPart(obj) then
							obj.Anchored = true
						elseif decode(value) == false then
							partsToUnanchor[obj] = true
						else
							obj.Anchored = true
						end
					elseif name == "Enabled" and (obj:IsA("Constraint") or obj:IsA("BallSocketConstraint") or obj:IsA("AnimationConstraint")) and decode(value) == true then
						constraintsToEnable[obj] = true
						obj.Enabled = false
					elseif name == "CFrame" and obj:IsA("BasePart") then
						local m = obj:FindFirstAncestorWhichIsA("Model")
						if not force and m and isRigBeingAnimated(m) and (isRigLimb(obj) or obj:FindFirstAncestorWhichIsA("Accessory")) then
							-- Only suppress CFrame updates during active animation preview to prevent joint conflicts
						else
							local targetCf = decode(value)
							if not equal(encode(obj[name]), encode(targetCf)) then
								obj[name] = targetCf
							end
						end
					elseif not equal(encode(obj[name]), value) then
						obj[name] = decode(value)
					end
				end)
				if ok then warnings[key..":"..name] = nil else warn(key..":"..name, v.name.."."..name..": unavailable via API"); if appearanceSet[name] then appearanceRetry[key] = os.clock() + 10 end end
			end
			if v.attributes then
				for name in pairs(obj:GetAttributes()) do if name ~= "PT_ObjectId" and v.attributes[name] == nil then local ok = pcall(function() obj:SetAttribute(name, nil) end); if not ok then warn(key..":attribute:"..name, v.name..": attribute protected by Roblox") end end end
				for name, value in pairs(v.attributes) do local ok = pcall(function() if not equal(encode(obj:GetAttribute(name)), value) then obj:SetAttribute(name, decode(value)) end end); if not ok then warn(key..":attribute:"..name, v.name..": failed to apply attribute "..name) end end
			end
			if v.tags then local tags = {}; for _, tag in ipairs(v.tags) do tags[tag] = true; if not Collection:HasTag(obj, tag) then Collection:AddTag(obj, tag) end end; for _, tag in ipairs(Collection:GetTags(obj)) do if not tags[tag] then Collection:RemoveTag(obj, tag) end end end
		elseif not v and obj and not serviceIds[key] then local ok = pcall(function() obj:Destroy() end); if ok then ids[obj] = nil; objects[key] = nil; pending[key] = nil; meshRetry[key] = nil; referenceRetry[key] = nil else warn(key..":delete", obj.Name..": Roblox prevented deletion") end end
	end
	for key, r in pairs(changed) do if key:sub(1, 9) == "~Terrain/" then applyTerrain(key, r.value) end end

	-- Safely activate constraints now that attachments and parts are at their true positions
	for c in pairs(constraintsToEnable) do
		pcall(function() c.Enabled = true end)
	end
	-- Safely unanchor physics parts now that constraints and NoCollision are established
	for p in pairs(partsToUnanchor) do
		if not isCharacterPart(p) then
			pcall(function() p.Anchored = false end)
		else
			pcall(function() p.Anchored = true end)
		end
	end

	for key, r in pairs(remote) do
		versions[key] = r.version
		if changed[key] then
			baseline[key] = copy(r.value)
			cachedSnapshot[key] = copy(r.value)
		end
	end
	consolidateEclipseSaves()
	ensureAccessoryWelds()
end

local function blocked(obj, key)
	if pending[key] then return true end
	if not obj then return false end
	local parent = obj.Parent
	while parent and parent ~= game do local parentId = ids[parent]; if parentId and pending[parentId] then return true end; parent = parent.Parent end
	return false
end

local function changes(current)
	local list = {}; local seen = {}
	for key, value in pairs(current) do seen[key] = true; if not blocked(objects[key], key) and not equal(value, baseline[key]) then table.insert(list, {id = key, version = versions[key] or 0, value = value}) end end
	for key in pairs(baseline) do if not seen[key] and not pending[key] then table.insert(list, {id = key, version = versions[key] or 0, deleted = true}) end end
	return list
end

-- ZERO-LAG SENDCHANGES: only compares and sends when objects were actually edited
local function sendChanges(current, forceFullCompare)
	local list = {}
	if forceFullCompare or next(dirtyObjects) or next(dirtyDeleted) or next(dirtyTerrainChunks) then
		list = changes(current)
	end

	if #list > 0 then
		local batches = {}
		local curBatch = {}
		local curBytes = 0
		for _, item in ipairs(list) do
			local itemJson = Http:JSONEncode(item)
			local itemLen = #itemJson
			if (#curBatch >= 400 or curBytes + itemLen > 650000) and #curBatch > 0 then
				table.insert(batches, curBatch)
				curBatch = {}
				curBytes = 0
			end
			table.insert(curBatch, item)
			curBytes += itemLen
		end
		if #curBatch > 0 then
			table.insert(batches, curBatch)
		end

		local sentCount = 0
		for _, batch in ipairs(batches) do
			sentCount += #batch
			if #list > 50 then
				status("Saving to server: " .. formatCount(sentCount) .. "/" .. formatCount(#list) .. " (" .. math.floor(sentCount / #list * 100) .. "%)")
			end
			local result = request("POST", {changes = batch, since = currentRevision})
			if not result.conflict then
				warnings.syncConflict = nil
				currentRevision = result.revision
				for _, ch in ipairs(batch) do
					if ch.deleted then
						baseline[ch.id] = nil
						versions[ch.id] = nil
					else
						baseline[ch.id] = copy(ch.value)
						versions[ch.id] = currentRevision
					end
				end
				if not forceFullCompare and result.remoteChanges and next(result.remoteChanges) then
					apply(result.remoteChanges, current, false)
				end
			end
		end
		return {revision = currentRevision, objects = {}}
	end

	-- When no local changes exist, simply ask server for deltas since currentRevision
	local latest = request("GET")
	if latest.unchanged then
		return {revision = currentRevision, objects = {}}
	end

	currentRevision = latest.revision
	if latest.delta then
		apply(latest.objects, current, false)
	else
		apply(latest.objects, current, true)
	end

	warnings.syncConflict = nil
	return latest
end

local function focusImportedPlace()
	local low = Vector3.new(math.huge, math.huge, math.huge)
	local high = Vector3.new(-math.huge, -math.huge, -math.huge)
	local count = 0
	for key, obj in pairs(objects) do
		-- CRUCIAL FIX: Exclude Baseplate! Default Baseplate is 2048x2048 studs and throws camera 3,000 studs into the sky!
		if obj:IsA("BasePart") and obj.Name ~= "Baseplate" and obj:IsDescendantOf(workspace) then
			local a = obj.Position - obj.Size / 2; local b = obj.Position + obj.Size / 2
			low = Vector3.new(math.min(low.X, a.X), math.min(low.Y, a.Y), math.min(low.Z, a.Z))
			high = Vector3.new(math.max(high.X, b.X), math.max(high.Y, b.Y), math.max(high.Z, b.Z)); count += 1
		end
	end
	if count > 0 and workspace.CurrentCamera then
		local center = (low + high) / 2
		local span = high - low
		local distance = math.clamp(math.max(span.X, math.max(span.Y, span.Z)) * 1.25, 20, 200)
		workspace.CurrentCamera.CFrame = CFrame.lookAt(center + Vector3.new(distance * .65, distance * .5, distance), center)
		workspace.CurrentCamera.Focus = CFrame.new(center)
	elseif workspace.CurrentCamera then
		-- Default comfortable close-up view of the center
		workspace.CurrentCamera.CFrame = CFrame.lookAt(Vector3.new(20, 16, 26), Vector3.new(0, 2, 0))
		workspace.CurrentCamera.Focus = CFrame.new(0, 0, 0)
	end
end

local function downloadAllObjects(state)
	if state.has_more and state.total_objects then
		local allObjects = copy(state.objects or {})
		local page = state.page or 1
		local limit = state.limit or 250
		while state.has_more do
			page += 1
			status("Downloading objects: "..formatCount(math.min(page * limit, state.total_objects)).."/"..formatCount(state.total_objects).."...")
			local pUrl = endpoint .. (endpoint:find("?") and "&" or "?") .. "page=" .. tostring(page) .. "&limit=" .. tostring(limit) .. "&_t=" .. tostring(os.clock())
			local resp = Http:RequestAsync({Url = pUrl, Method = "GET", Headers = {Authorization = "Bearer "..credential, ["Content-Type"] = "application/json"}})
			if resp.Success then
				local pData = Http:JSONDecode(resp.Body)
				for k, v in pairs(pData.objects or {}) do allObjects[k] = v end
				state.has_more = pData.has_more
			else
				break
			end
		end
		state.objects = allObjects
	end
	return state
end

local function connectSession(isCreating)
	if busy then return end
	if active then
		if Run:IsRunning() then status("Stop Play mode before leaving session."); return end
		busy = true
		local ok, err = pcall(function()
			local current = snapshot(true)
			local remote = sendChanges(current, true)
			if warnings.syncConflict then error("Unsent edits remain. Retry leaving in a few seconds.") end
		end)
		busy = false
		if not ok then status("Cannot leave: unsent changes. "..tostring(err)); return end
		restoreSuppressed = true; active = false; connect.Text = "Reconnect to Session"; status("Changes synced to session. Safe to close local copy.")
		pcall(function()
			if room.Text ~= "" then
				api("/rooms/"..room.Text.."/presence", "POST", {leave = true})
			end
		end)
		return
	end
	if Run:IsRunning() then status("Stop Play/Test mode before connecting."); return end
	busy = true
	local ok, err = pcall(function()
		local baseServer = base()
		if not baseServer:match("^https?://") then error("Enter server address with http:// or https://") end
		endpoint = baseServer.."/api/rooms/"..room.Text.."/sync"
		credential = token.Text
		plugin:SetSetting("PTAddress", baseServer)
		plugin:SetSetting("PTRoom", room.Text)
		plugin:SetSetting("PTRoomToken:"..room.Text, credential)

		index()
		local current = snapshot(true)
		local state = request("GET")

		-- Support paginated download for massive places
		state = downloadAllObjects(state)

		-- If creating project or room on server is empty, upload local place
		if isCreating or state.unchanged or next(state.objects or {}) == nil then
			status("Dedicated room is empty. Uploading current place as initial state...")
			state = sendChanges(current, true)
		elseif state.objects and next(state.objects) ~= nil then
			apply(state.objects, current, true)
		end
		consolidateEclipseSaves()
		ensureAccessoryWelds()
		currentRevision = state.revision or currentRevision

		local after = snapshot(true); for key, value in pairs(after) do if not versions[key] then baseline[key] = value end end
		active = true; accept.Visible = false; connect.Text = "Leave Session"; status("Connected to dedicated project: "..room.Text.." · Real-time sync enabled."..warningText())
		-- Camera untouched on connect
	end)
	busy = false; if not ok then active = false; status(tostring(err)); accept.Visible = endpoint ~= nil end
end

-- Refresh Server Projects List
local function refreshProjectsList()
	for _, child in ipairs(projectsListFrame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	status("Querying projects from " .. base() .. "...")
	local ok, list = pcall(function() return api("/rooms", "GET") end)
	if not ok or type(list) ~= "table" then
		local lbl = textLabel("Failed to load projects: " .. tostring(list), 24, projectsListFrame)
		lbl.TextColor3 = palette.danger
		status("Cannot reach server. Verify address in Settings.")
		return
	end
	if #list == 0 then
		local lbl = textLabel("No active projects on this server. Create one above!", 24, projectsListFrame)
		lbl.TextColor3 = palette.subtle
		status("No projects found on server.")
		return
	end
	for _, r in ipairs(list) do
		local row = card(projectsListFrame, "Row_" .. r.id)
		row.BackgroundColor3 = palette.field
		local rowHeader = title(r.name .. (r.requires_password and "  🔒 (Password required)" or "  🔓 (Open)"), row)
		rowHeader.TextSize = 13
		local rowMeta = textLabel("ID: " .. r.id .. "  |  " .. tostring(r.objects_count) .. " objects  |  " .. tostring(r.active_peers) .. " online", 18, row)
		rowMeta.TextSize = 11; rowMeta.TextColor3 = palette.subtle
		local selBtn = makeButton("Select Project: " .. r.id, row)
		selBtn.MouseButton1Click:Connect(function()
			projectJoinId.Text = r.id
			status("Selected room: " .. r.name .. " (" .. r.id .. ")")
			if r.requires_password then
				projectJoinPassword:CaptureFocus()
			end
		end)

		local delBtn = makeButton("Delete Project", row, "danger")
		delBtn.TextSize = 11
		delBtn.Size = UDim2.new(1, 0, 0, 26)

		local confirmBox = container(row, "ConfirmDelete")
		confirmBox.Visible = false
		confirmBox.BackgroundColor3 = palette.dangerBg
		pad(confirmBox, 6, 6)
		corner(confirmBox, 6)
		stroke(confirmBox, palette.dangerBorder, 1)

		local confirmPrompt = textLabel(
			r.requires_password
				and "Enter password to permanently delete this project:"
				or "Are you sure you want to permanently delete this project?",
			20,
			confirmBox
		)
		confirmPrompt.TextColor3 = Color3.fromRGB(252, 165, 165)
		confirmPrompt.TextSize = 11

		local delPwInput = nil
		if r.requires_password then
			delPwInput = field("Enter room password", "", confirmBox)
			delPwInput.Size = UDim2.new(1, 0, 0, 26)
		end

		local actionRow = container(confirmBox, "ActionRow")
		actionRow.Size = UDim2.new(1, 0, 0, 28)
		local actLayout = Instance.new("UIListLayout")
		actLayout.FillDirection = Enum.FillDirection.Horizontal
		actLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
		actLayout.Padding = UDim.new(0, 8)
		actLayout.Parent = actionRow

		local cancelBtn = makeButton("Cancel", actionRow)
		cancelBtn.Size = UDim2.new(0, 70, 0, 26)
		cancelBtn.TextSize = 11

		local execDelBtn = makeButton("Confirm Delete", actionRow, "danger")
		execDelBtn.Size = UDim2.new(0, 110, 0, 26)
		execDelBtn.TextSize = 11

		delBtn.MouseButton1Click:Connect(function()
			confirmBox.Visible = true
			delBtn.Visible = false
			if delPwInput then
				delPwInput:CaptureFocus()
			end
		end)

		cancelBtn.MouseButton1Click:Connect(function()
			confirmBox.Visible = false
			delBtn.Visible = true
		end)

		execDelBtn.MouseButton1Click:Connect(function()
			local pw = delPwInput and delPwInput.Text or ""
			if r.requires_password and pw == "" then
				status("Password is required to delete this project.")
				if delPwInput then delPwInput:CaptureFocus() end
				return
			end
			status("Deleting project '" .. r.name .. "' (" .. r.id .. ")...")
			local ok, res = pcall(function()
				return api("/rooms/" .. r.id .. "/delete", "POST", {password = pw})
			end)
			if ok then
				status("Project '" .. r.name .. "' deleted successfully.")
				if room.Text == r.id and active then
					active = false
					endpoint = nil
					connect.Text = "Reconnect to Session"
					room.Text = ""
					token.Text = ""
					credential = nil
					plugin:SetSetting("PTRoom", "")
					refreshUI(active, loggedIn, inbox ~= nil, busy)
				end
				refreshProjectsList()
			else
				status("Delete failed: " .. tostring(res))
			end
		end)
	end
	status("Loaded " .. tostring(#list) .. " project(s) from server.")
end
btnRefreshProjects.MouseButton1Click:Connect(refreshProjectsList)

-- Connect to Project Button Action
btnConnectProject.MouseButton1Click:Connect(function()
	if busy or active then return end
	local rId = projectJoinId.Text:gsub("%s+", "")
	if rId == "" then status("Enter Project ID or Name"); return end
	busy = true
	status("Connecting to project: " .. rId .. "...")
	local ok, res = pcall(function()
		return api("/rooms/auth", "POST", {
			roomId = rId,
			password = projectJoinPassword.Text,
			userName = selfNick.Text ~= "" and selfNick.Text or "User",
			userId = localUserId
		})
	end)
	busy = false
	if not ok then
		status("Join failed: " .. tostring(res))
		return
	end
	room.Text = res.roomId
	token.Text = res.token
	credential = res.token
	sessionTitle.Text = res.name
	plugin:SetSetting("PTRoom", res.roomId)
	plugin:SetSetting("PTRoomToken:" .. res.roomId, res.token)
	uiTab = "session"
	connectSession(false)
end)

-- Create New Project Button Action
btnCreateProject.MouseButton1Click:Connect(function()
	if busy or active then return end
	local pName = newProjectName.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if pName == "" then pName = game.Name ~= "" and game.Name or "Dedicated Project" end
	busy = true
	status("Creating new project on server: " .. pName .. "...")
	local ok, res = pcall(function()
		return api("/rooms/create", "POST", {
			name = pName,
			password = newProjectPassword.Text
		})
	end)
	busy = false
	if not ok then
		status("Create failed: " .. tostring(res))
		return
	end
	room.Text = res.id
	token.Text = res.token
	credential = res.token
	sessionTitle.Text = res.name
	plugin:SetSetting("PTRoom", res.id)
	plugin:SetSetting("PTRoomToken:" .. res.id, res.token)
	uiTab = "session"
	connectSession(true)
end)

-- Force Push & Pull Buttons Actions
btnForcePush.MouseButton1Click:Connect(function()
	if not active or busy then return end
	busy = true
	status("Pushing local place state to dedicated server...")
	local ok, err = pcall(function()
		local current = snapshot(true)
		local list = {}
		for k, v in pairs(current) do
			table.insert(list, {id = k, version = versions[k] or 0, value = v})
		end
		local BATCH_SIZE = 100
		for i = 1, #list, BATCH_SIZE do
			local batch = {}
			for j = i, math.min(i + BATCH_SIZE - 1, #list) do
				table.insert(batch, list[j])
			end
			request("POST", {changes = batch, since = currentRevision})
		end
		status("Successfully pushed place to server!")
	end)
	busy = false
	if not ok then status("Push failed: " .. tostring(err)) end
end)

btnFocusBuild.MouseButton1Click:Connect(function()
	focusImportedPlace()
	status("Camera centered on build.")
end)

btnForcePull.MouseButton1Click:Connect(function()
	if not active or busy then return end
	busy = true
	status("Pulling fresh copy from dedicated server...")
	local ok, err = pcall(function()
		local current = snapshot(true)
		local state = request("GET")
		state = downloadAllObjects(state)
		apply(state.objects, current, true)
		consolidateEclipseSaves()
		ensureAccessoryWelds()
		status("Place updated from server.")
	end)
	busy = false
	if not ok then status("Pull failed: " .. tostring(err)) end
end)

guestEnter = function(rename)
	if not base():match("^https?://") then status("Enter server address in Settings tab"); return end
	local key = plugin:GetSetting("PTGuestDeviceKey") or plugin:GetSetting("PTGuestDeviceKey:"..base())
	if type(key) ~= "string" or #key ~= 64 then key = (Http:GenerateGUID(false)..Http:GenerateGUID(false)):gsub("-", ""):lower(); plugin:SetSetting("PTGuestDeviceKey:"..base(), key) end
	if selfNick.Text == "" then
		pcall(function() local uid = game:GetService("StudioService"):GetUserId(); if type(uid) == "number" and uid > 0 then selfNick.Text = game:GetService("Players"):GetNameFromUserIdAsync(uid) end end)
		if selfNick.Text == "" then selfNick.Text = "User_"..key:sub(1, 6) end
	end
	plugin:SetSetting("PTGuestDeviceKey", key)
	local uidToSend = 0
	if type(localUserId) == "number" and localUserId > 0 then
		uidToSend = localUserId
	elseif selfNick.Text ~= "" and selfNick.Text ~= "Username" then
		pcall(function()
			local uid = game:GetService("Players"):GetUserIdFromNameAsync(selfNick.Text)
			if type(uid) == "number" and uid > 0 then uidToSend = uid; localUserId = uid end
		end)
	end
	local value = api("/guest", "POST", {name = selfNick.Text, deviceKey = key, rename = rename == true, userId = uidToSend})
	if type(value) == "table" and value.token then
		token.Text = value.token or ""
		credential = value.token or ""
		selfNick.Text = value.name or selfNick.Text
		loggedIn = true
		plugin:SetSetting("PTInviteToken:"..base(), token.Text); plugin:SetSetting("PTInviteName", selfNick.Text); plugin:SetSetting("PTAddress", base())
		status("Connected as "..selfNick.Text..". Ready to collaborate.")
	else
		error("Server connection failed: invalid response")
	end
	return value
end

local inbox = nil
local lastSent = nil
local inviting = false
local polling = false

local function inviteUser()
	if inviting then return end
	inviting = true
	local ok, err = pcall(function()
		if #nick.Text:gsub("%s+", "") < 3 then error("Enter friend's plugin username") end
		if not active then error("Connect to a project first before inviting peers") end
		local sent = api("/invitations", "POST", {room = room.Text, nick = nick.Text}); lastSent = sent.id
		inviteStatus.Text = sent.recipientOnline and ("Waiting for acceptance: "..nick.Text) or ("Request saved. Waiting for '"..nick.Text.."' to open the plugin.")
		status(inviteStatus.Text)
	end)
	inviting = false; if not ok then inviteStatus.Text = tostring(err); status(tostring(err)) end
end
invite.MouseButton1Click:Connect(inviteUser)

local function emptyPlace()
	for _, service in ipairs({"ReplicatedStorage", "ServerScriptService", "ServerStorage", "StarterGui", "StarterPack"}) do
		if #game:GetService(service):GetChildren() > 0 then return false end
	end
	for _, obj in ipairs(workspace:GetChildren()) do
		if not obj:IsA("Terrain") and not obj:IsA("Camera") and obj.Name ~= "Baseplate" and not obj:IsA("SpawnLocation") then return false end
	end
	return true
end

local function acceptInvitation()
	if not inbox or inviting or busy then return end
	if active then status("Disconnect from current session first."); return end
	if not emptyPlace() then status("Open a new empty Baseplate: File -> New. Current place was not overwritten."); return end
	inviting = true
	local ok, err = pcall(function()
		local result = api("/invitations/"..inbox.id.."/respond", "POST", {decision = "accept"})
		room.Text = result.room.id; token.Text = result.token or token.Text; credential = token.Text; inbox = nil; yes.Visible = false; no.Visible = false
		sessionTitle.Text = result.room.name

		index()
		local initial = api("/rooms/"..room.Text.."/sync")
		if not initial.objects or next(initial.objects) == nil then error("Host has not published the place yet. Click Reconnect in a few moments.") end
		local defaults = {}; for _, obj in ipairs(workspace:GetChildren()) do if obj.Name == "Baseplate" or obj:IsA("SpawnLocation") then table.insert(defaults, obj) end end
		connectSession(); connect.Visible = active
		if not active then error(notice.Text) end
		for _, obj in ipairs(defaults) do local key = ids[obj]; if key and not initial.objects[key] then baseline[key] = nil; objects[key] = nil; ids[obj] = nil; obj:Destroy() end end
		-- Camera untouched
		incoming.Text = "You are collaborating on "..result.room.name.." together."
	end)
	inviting = false; if not ok then status(tostring(err)) end
end
yes.MouseButton1Click:Connect(acceptInvitation)

retry.MouseButton1Click:Connect(function()
	if busy or active or room.Text == "" then return end
	connectSession(); connect.Visible = active
	-- Camera untouched
end)

no.MouseButton1Click:Connect(function()
	if not inbox or inviting then return end
	inviting = true
	local ok, err = pcall(function() api("/invitations/"..inbox.id.."/respond", "POST", {decision = "decline"}); inbox = nil; yes.Visible = false; no.Visible = false; incoming.Text = "Invitation declined." end)
	inviting = false; if not ok then status(tostring(err)) end
end)

connect.MouseButton1Click:Connect(connectSession)

accept.MouseButton1Click:Connect(function()
	if busy or not endpoint then return end
	busy = true
	local ok, err = pcall(function() local current = snapshot(true); local state = request("GET"); apply(state.objects, current, true); active = true; connect.Visible = true; accept.Visible = false; status("Server version accepted.") end)
	busy = false; if not ok then status(tostring(err)) end
end)

btnDeleteActiveRoom.MouseButton1Click:Connect(function()
	if not active or room.Text == "" then return end
	local pName = sessionTitle.Text ~= "" and sessionTitle.Text or room.Text
	activeDelPrompt.Text = "Permanently delete '" .. pName .. "' from server?"
	activeDelPw.Text = ""
	activeDelConfirm.Visible = true
	btnDeleteActiveRoom.Visible = false
	activeDelPw:CaptureFocus()
end)

activeDelCancel.MouseButton1Click:Connect(function()
	activeDelConfirm.Visible = false
	btnDeleteActiveRoom.Visible = true
end)

activeDelExec.MouseButton1Click:Connect(function()
	if not active or room.Text == "" then return end
	local curRoom = room.Text
	local pName = sessionTitle.Text ~= "" and sessionTitle.Text or curRoom
	status("Deleting active project '" .. pName .. "' from server...")
	local ok, res = pcall(function()
		return api("/rooms/" .. curRoom .. "/delete", "POST", {password = activeDelPw.Text})
	end)
	if ok then
		status("Project '" .. pName .. "' deleted successfully from server.")
		activeDelConfirm.Visible = false
		btnDeleteActiveRoom.Visible = true
		activeDelPw.Text = ""
		active = false
		endpoint = nil
		connect.Text = "Reconnect to Session"
		room.Text = ""
		token.Text = ""
		credential = nil
		plugin:SetSetting("PTRoom", "")
		uiTab = "projects"
		refreshUI(active, loggedIn, inbox ~= nil, busy)
		refreshProjectsList()
	else
		status("Delete failed: " .. tostring(res))
	end
end)

task.spawn(function()
	if selfNick.Text == "" then pcall(function() local uid = game:GetService("StudioService"):GetUserId(); if uid > 0 then selfNick.Text = game:GetService("Players"):GetNameFromUserIdAsync(uid) end end) end
	if address.Text ~= "" and address.Text:match("^https?://") then
		local ready, reason = pcall(guestEnter)
		if not ready then
			status("Failed to connect. Check server address in Settings. "..tostring(reason))
		else
			pcall(refreshProjectsList)
		end
	else
		status("Enter server address in Settings tab")
	end
	task.spawn(fetchDashStatus)
	while alive do
		task.wait(3.0)
		if not alive then break end
		if not loggedIn and not inviting and not polling and widget.Enabled then pcall(guestEnter) end
		if alive and loggedIn and not polling and not inviting and widget.Enabled and (active or uiTab == "session") then
			polling = true
			local ok, err = pcall(function()
				local invitations = api("/invitations")
				if lastSent then
					for _, sent in ipairs(api("/invitations/outbox")) do if sent.id == lastSent then
							if sent.state == "accepted" then inviteStatus.Text = "Friend accepted invitation."; lastSent = nil
							elseif sent.state == "declined" then inviteStatus.Text = "Friend declined invitation."; lastSent = nil
							elseif sent.delivered then inviteStatus.Text = "Request received by friend's plugin. Waiting for acceptance."
							elseif sent.recipientOnline then inviteStatus.Text = "Friend is online. Delivering invitation..."
							else inviteStatus.Text = "Friend has not received request yet. Check username and plugin version." end
						end end
				end
				local nextInvite = invitations[#invitations]
				if nextInvite and (not inbox or inbox.id ~= nextInvite.id) then
					inbox = nextInvite; incoming.Text = nextInvite.from.." invited you to '"..nextInvite.place.."'. Open an empty place before accepting."; yes.Visible = true; no.Visible = true; uiTab = "session"; widget.Enabled = true
				elseif not nextInvite and inbox then inbox = nil; yes.Visible = false; no.Visible = false; incoming.Text = "No new invitations." end
			end)
			polling = false; if not ok then incoming.Text = "Failed to check invitations: "..tostring(err) end
		end
	end
end)

-- Main sync loop (Zero-Lag: yields without freeze)
task.spawn(function()
	while alive do
		task.wait(0.5) 
		if not alive then break end
		if active and not busy and not Run:IsRunning() then
			busy = true
			local ok, err = pcall(function()
				local current = snapshot(false)
				local state = sendChanges(current, false)
				status((warnings.syncConflict and "Unsent changes pending" or ("Server rev "..tostring(state.revision))).." · room "..room.Text:sub(1, 10)..warningText())
			end)
			busy = false
			if not ok then status("Sync retrying... Local changes preserved. "..tostring(err)) end
		elseif active and Run:IsRunning() then
			status("Sync paused during Play mode. Stop game to resume editing.")
		end
	end
end)

plugin.Unloading:Connect(function()
	alive = false
	if active and not busy and not Run:IsRunning() then
		pcall(function()
			if room.Text ~= "" then
				api("/rooms/"..room.Text.."/presence", "POST", {leave = true})
			end
		end)
	end
	active = false; loggedIn = false
end)

logout.MouseButton1Click:Connect(function()
	if busy or inviting then return end
	inviting = true; local ok, err = pcall(guestEnter); inviting = false
	if not ok then status("Check server in Settings. "..tostring(err)) else status("Connection active: " .. base()) end
	fetchDashStatus()
end)

local previousAddress = base()
address.FocusLost:Connect(function()
	if base() == previousAddress then return end
	if busy or inviting then address.Text = previousAddress; status("Please wait for current operation to finish."); return end
	previousAddress = base(); active = false; loggedIn = false; inbox = nil; room.Text = ""; token.Text = ""
	yes.Visible = false; no.Visible = false
	plugin:SetSetting("PTAddress", base()); uiTab = "projects"; local ok, err = pcall(guestEnter)
	if not ok then status("Failed to connect to new server. "..tostring(err)) else refreshProjectsList() end
	task.spawn(fetchDashStatus)
end)

selfNick.FocusLost:Connect(function()
	if busy or inviting then return end
	local old = plugin:GetSetting("PTInviteName") or ""
	if selfNick.Text == old then return end
	inviting = true; local ok, err = pcall(function() guestEnter(true) end); inviting = false
	if not ok then selfNick.Text = old; status(tostring(err)) end
end)

task.spawn(function()
	while alive do
		if not alive then break end
		refreshUI(active, loggedIn, inbox ~= nil, busy or inviting)
		task.wait(.25)
	end
end)

-- Peer Cursors / Participant Avatars (Stationary debounce: 0% network when camera not moving)
do
	local enabled = plugin:GetSetting("PTShowParticipants") ~= false
	local folder = nil
	local markers = {}
	local previousRoom = nil
	local previousBase = nil
	local sending = false
	local lastCamPos = Vector3.new()
	local lastCamLook = Vector3.new()
	local lastPresenceSend = 0

	local function updatePeerCards(peers)
		for _, child in ipairs(peersFrame:GetChildren()) do
			if not child:IsA("UIListLayout") and child ~= participantsText then
				child:Destroy()
			end
		end
		if #peers == 0 then
			participantsText.Visible = true
			participantsText.Text = "No other participants connected yet."
			return
		end
		participantsText.Visible = false
		for _, peer in ipairs(peers) do
			local pCard = Instance.new("Frame")
			pCard.Name = "PeerCard_"..tostring(peer.id)
			pCard.Size = UDim2.new(1, 0, 0, 42)
			pCard.BackgroundColor3 = Color3.fromRGB(18, 22, 31)
			pCard.BorderSizePixel = 0
			pCard.Parent = peersFrame
			corner(pCard, 8)
			stroke(pCard, palette.line, 1)

			local avatar = Instance.new("ImageLabel")
			avatar.Name = "Avatar"
			avatar.Size = UDim2.fromOffset(30, 30)
			avatar.Position = UDim2.new(0, 6, 0.5, -15)
			avatar.BackgroundTransparency = 1
			local uid = tonumber(peer.userId) or 0
			if uid > 0 then
				avatar.Image = "rbxthumb://type=AvatarHeadShot&id="..tostring(uid).."&w=150&h=150"
			else
				avatar.Image = ""
			end
			avatar.Parent = pCard
			corner(avatar, 15)

			local tint = Color3.fromHSV(peer.hue or 0.5, .75, 1)
			local dot = Instance.new("Frame")
			dot.Name = "Dot"
			dot.Size = UDim2.fromOffset(8, 8)
			dot.Position = UDim2.new(0, 26, 0.5, 4)
			dot.BackgroundColor3 = (peer.isIdle == true) and Color3.fromRGB(234, 179, 8) or tint
			dot.BorderSizePixel = 0
			dot.Parent = pCard
			corner(dot, 4)

			local nameLbl = Instance.new("TextLabel")
			nameLbl.Name = "Name"
			nameLbl.Size = UDim2.new(1, -48, 0, 16)
			nameLbl.Position = UDim2.new(0, 42, 0, 4)
			nameLbl.BackgroundTransparency = 1
			nameLbl.Font = Enum.Font.GothamBold
			nameLbl.TextSize = 12
			nameLbl.TextColor3 = palette.text
			nameLbl.TextXAlignment = Enum.TextXAlignment.Left
			nameLbl.Text = peer.name
			nameLbl.Parent = pCard

			local isIdle = peer.isIdle == true
			local actLbl = Instance.new("TextLabel")
			actLbl.Name = "Activity"
			actLbl.Size = UDim2.new(1, -48, 0, 14)
			actLbl.Position = UDim2.new(0, 42, 0, 20)
			actLbl.BackgroundTransparency = 1
			actLbl.Font = Enum.Font.Gotham
			actLbl.TextSize = 10
			actLbl.TextColor3 = isIdle and Color3.fromRGB(234, 179, 8) or palette.green
			actLbl.TextXAlignment = Enum.TextXAlignment.Left
			local actText = peer.activity
			if not actText or actText == "" then
				local selCount = peer.selected and #peer.selected or 0
				actText = selCount > 0 and ("Selected " .. selCount .. " part(s)") or "Viewing place"
			end
			actLbl.Text = actText
			actLbl.Parent = pCard
		end
	end

	local function clear()
		if folder then folder:Destroy(); folder = nil end
		markers = {}
		pcall(function() updatePeerCards({}) end)
	end

	local function vector(v) return Vector3.new(v[1], v[2], v[3]) end

	local function marker(peer)
		if not folder then folder = Instance.new("Folder"); folder.Name = "PlaceTogetherPresence"; folder.Archivable = false; folder.Parent = game:GetService("CoreGui") end
		local group = Instance.new("Folder"); group.Name = peer.id; group.Parent = folder
		local tint = Color3.fromHSV(peer.hue or 0.5, .65, 1)
		local sphere = Instance.new("SphereHandleAdornment"); sphere.Name = "Participant"; sphere.Adornee = workspace.Terrain; sphere.Radius = 1.5; sphere.Color3 = tint; sphere.Transparency = .15; sphere.AlwaysOnTop = false; sphere.Parent = group
		pcall(function() sphere.Shading = Enum.AdornShading.Shaded end)
		local direction = Instance.new("LineHandleAdornment"); direction.Name = "Direction"; direction.Adornee = workspace.Terrain; direction.Color3 = tint; direction.Thickness = 3; direction.Parent = group
		local caption = Instance.new("BillboardGui"); caption.Name = "Nickname"; caption.Adornee = workspace.Terrain; caption.Size = UDim2.fromOffset(180, 32); caption.AlwaysOnTop = true; caption.MaxDistance = 2000; caption.Parent = group
		local label = Instance.new("TextLabel"); label.Size = UDim2.fromScale(1, 1); label.BackgroundTransparency = 1; label.Font = Enum.Font.GothamMedium; label.TextSize = 14; label.TextColor3 = tint; label.TextStrokeColor3 = Color3.fromRGB(20, 20, 25); label.TextStrokeTransparency = .2; label.Text = peer.name; label.Parent = caption
		return {group = group, sphere = sphere, direction = direction, tint = tint, selection = {}, boxes = {}, caption = caption, label = label, position = vector(peer.position), target = vector(peer.position), look = vector(peer.look), targetLook = vector(peer.look), seen = os.clock()}
	end

	local function receive(peers)
		local present = {}; local names = {}
		for _, peer in ipairs(peers) do
			present[peer.id] = true; table.insert(names, peer.name)
			if enabled then
				local item = markers[peer.id] or marker(peer); markers[peer.id] = item
				item.target = vector(peer.position); item.targetLook = vector(peer.look); item.label.Text = peer.name; item.seen = os.clock()
				item.selection = {}; for _, key in ipairs(peer.selected or {}) do item.selection[key] = true end
				for key, box in pairs(item.boxes) do if not item.selection[key] then box:Destroy(); item.boxes[key] = nil end end
			end
		end
		for id, item in pairs(markers) do if not present[id] then item.group:Destroy(); markers[id] = nil end end
		updatePeerCards(peers)
	end

	local function cameraState()
		local camera = workspace.CurrentCamera; if not camera then return nil end
		local position = camera.CFrame.Position; local look = camera.CFrame.LookVector
		local now = os.clock()

		if not lastCameraPos or (position - lastCameraPos).Magnitude > 0.05 or (look - lastCameraLook).Magnitude > 0.02 then
			lastActionTime = now
			lastCameraPos = position
			lastCameraLook = look
		end

		local rawSelected = Selection:Get()
		local selected = {}
		for _, obj in ipairs(rawSelected) do
			local key = ids[obj]
			if key and obj:IsDescendantOf(workspace) and (obj:IsA("BasePart") or obj:IsA("Model")) then
				table.insert(selected, key)
				if #selected >= 32 then break end
			end
		end

		local isIdle = (now - lastActionTime > 60)
		local isPlaying = false
		pcall(function()
			isPlaying = game:GetService("RunService"):IsRunning()
		end)

		local act = "Viewing place"
		if isPlaying then
			act = "Testing place (Play mode)"
		elseif (now - lastScriptEditTime) < 15 and lastScriptDocName then
			act = "Editing script: " .. lastScriptDocName
		elseif #rawSelected > 0 then
			local animModel = nil
			for _, item in ipairs(rawSelected) do
				local m = item:IsA("Model") and item or item:FindFirstAncestorWhichIsA("Model")
				if m and isRigBeingAnimated(m) then animModel = m; break end
			end
			if animModel then
				local mName = tostring(animModel.Name)
				if #mName > 22 then mName = mName:sub(1, 20) .. ".." end
				act = "Animating: " .. mName
			elseif #rawSelected == 1 then
				local item = rawSelected[1]
				local sName = tostring(item.Name)
				if #sName > 22 then sName = sName:sub(1, 20) .. ".." end
				if item:IsA("LuaSourceContainer") then
					act = "Editing script: " .. sName
				else
					act = "Selected: " .. sName
				end
			else
				act = "Selected " .. #rawSelected .. " objects"
			end
		end

		if isIdle then
			if act == "Viewing place" then
				act = "Idle (away)"
			else
				act = "Idle (" .. act .. ")"
			end
		end

		local hit = workspace:Raycast(position, Vector3.new(0, -512, 0))
		local ground = hit and hit.Position + Vector3.new(0, .12, 0) or position - Vector3.new(0, 3, 0)
		return {
			position = {position.X, position.Y, position.Z},
			look = {look.X, look.Y, look.Z},
			ground = {ground.X, ground.Y, ground.Z},
			selected = selected,
			userId = localUserId,
			activity = act,
			isIdle = isIdle
		}
	end

	presenceToggle.Text = enabled and "Peer Cursors: On" or "Peer Cursors: Off"
	local toggleConnection = presenceToggle.MouseButton1Click:Connect(function()
		enabled = not enabled; plugin:SetSetting("PTShowParticipants", enabled)
		presenceToggle.Text = enabled and "Peer Cursors: On" or "Peer Cursors: Off"
		if not enabled then clear() end
	end)

	local renderConnection = Run.RenderStepped:Connect(function(dt)
		if not active or Run:IsRunning() or not enabled then if folder then clear() end; return end
		local blend = 1 - math.exp(-12 * math.min(dt, .1))
		for id, item in pairs(markers) do
			if os.clock() - item.seen > 12 then item.group:Destroy(); markers[id] = nil
			else
				item.position = item.position:Lerp(item.target, blend); item.look = item.look:Lerp(item.targetLook, blend)
				item.sphere.CFrame = workspace.Terrain.CFrame:ToObjectSpace(CFrame.new(item.position))
				item.direction.Visible = item.look.Magnitude > .01
				if item.look.Magnitude > .01 then item.direction.CFrame = workspace.Terrain.CFrame:ToObjectSpace(CFrame.lookAt(item.position, item.position + item.look)); item.direction.Length = 4 end
				item.caption.StudsOffsetWorldSpace = item.position - workspace.Terrain.Position + Vector3.new(0, 2.5, 0)
				for key in pairs(item.selection) do
					local obj = objects[key]; local box = item.boxes[key]
					if obj and obj:IsDescendantOf(workspace) and (obj:IsA("BasePart") or obj:IsA("Model")) then
						if not box then box = Instance.new("SelectionBox"); box.Name = "SelectedObject"; box.Color3 = item.tint; box.SurfaceColor3 = item.tint; box.SurfaceTransparency = .9; box.LineThickness = .04; box.Parent = item.group; item.boxes[key] = box end
						box.Adornee = obj
					elseif box then box:Destroy(); item.boxes[key] = nil end
				end
			end
		end
	end)

	task.spawn(function()
		while alive do
			if active and loggedIn and not Run:IsRunning() then
				local currentRoom = room.Text; local currentBase = base()
				if previousRoom ~= currentRoom or previousBase ~= currentBase then clear() end
				previousRoom = currentRoom; previousBase = currentBase
				
				local cam = workspace.CurrentCamera
				local camMoved = false
				if cam then
					local curPos = cam.CFrame.Position
					local curLook = cam.CFrame.LookVector
					if (curPos - lastCamPos).Magnitude > 0.1 or (curLook - lastCamLook).Magnitude > 0.05 or (os.clock() - lastPresenceSend > 3.0) then
						camMoved = true
						lastCamPos = curPos
						lastCamLook = curLook
					end
				end

				if camMoved then
					local payload = cameraState()
					if payload then
						sending = true
						lastPresenceSend = os.clock()
						local ok, peers = pcall(function() return api("/rooms/"..currentRoom.."/presence", "POST", payload) end)
						sending = false
						if alive and active and not Run:IsRunning() and currentRoom == room.Text and currentBase == base() then
							if ok then
								local rendered, reason = pcall(function() receive(peers) end)
								if not rendered then clear(); participantsText.Text = "Peer cursors: "..tostring(reason) end
							else participantsText.Text = "Updating peer connection..." end
						end
					end
				end
			else
				clear()
				participantsText.Text = "No other participants connected yet."
				if previousRoom and not sending then
					local oldRoom = previousRoom; local oldBase = previousBase
					previousRoom = nil; previousBase = nil
					if oldBase == base() then pcall(function() api("/rooms/"..oldRoom.."/presence", "POST", {leave = true}) end) end
				end
			end
			task.wait(.5)
		end
	end)

	plugin.Unloading:Connect(function() alive = false; renderConnection:Disconnect(); toggleConnection:Disconnect(); clear() end)
end

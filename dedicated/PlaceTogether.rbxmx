function app.operations.setNotice(message)
    local nl = message:find(string.char(10), 1, true)
    local line = nl and message:sub(1, nl - 1) or message
    if line:sub(-1) == string.char(13) then
        line = line:sub(1, -2)
    end
    app.notice.Text = line
end
app.LoadUI = {
    localActive = false,
    remotePeer = nil,
    gui = nil,
    frame = nil,
}
app.loadTitle, app.loadDetail, app.loadFill, app.loadPercent, app.loadCard = nil
function app.operations.buildLoadGui()
    if not app.LoadUI.frame then
        local f = Instance.new("Frame")
        f.Name = "PlaceTogetherLoading"
        f.Size = UDim2.fromScale(1, 1)
        f.BackgroundColor3 = Color3.fromRGB(10, 13, 20)
        f.BackgroundTransparency = 0.08
        f.BorderSizePixel = 0
        f.ZIndex = 50
        f.Visible = false
        f.Parent = app.frame
        app.LoadUI.frame = f
        local ft = Instance.new("TextLabel")
        ft.Size = UDim2.new(1, -40, 0, 28)
        ft.Position = UDim2.new(0, 20, 0.5, -46)
        ft.BackgroundTransparency = 1
        ft.Font = Enum.Font.GothamBold
        ft.TextSize = 17
        ft.TextColor3 = app.palette.text
        ft.TextWrapped = true
        ft.Text = "Loading..."
        ft.ZIndex = 51
        ft.Parent = f
        app.LoadUI.fallbackTitle = ft
        local fd = Instance.new("TextLabel")
        fd.Size = UDim2.new(1, -40, 0, 44)
        fd.Position = UDim2.new(0, 20, 0.5, -12)
        fd.BackgroundTransparency = 1
        fd.Font = Enum.Font.Gotham
        fd.TextSize = 12
        fd.TextColor3 = app.palette.muted
        fd.TextWrapped = true
        fd.TextYAlignment = Enum.TextYAlignment.Top
        fd.Text = "Editing is paused while the transfer finishes."
        fd.ZIndex = 51
        fd.Parent = f
        app.LoadUI.fallbackDetail = fd
    end
    if app.LoadUI.gui and app.LoadUI.gui.Parent then
        return true
    end
    local ok, gui = pcall(function()
        local g = Instance.new("ScreenGui")
        g.Name = "PlaceTogetherLoading"
        g.ResetOnSpawn = false
        g.IgnoreGuiInset = true
        g.DisplayOrder = 999999
        g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        g.Parent = game:GetService("CoreGui")
        return g
    end)
    if not ok or not gui then
        return false
    end
    app.LoadUI.gui = gui
    local cover = Instance.new("TextButton")
    cover.Name = "Cover"
    cover.Size = UDim2.fromScale(1, 1)
    cover.BackgroundColor3 = Color3.fromRGB(6, 9, 15)
    cover.BackgroundTransparency = 0.25
    cover.AutoButtonColor = false
    cover.Text = ""
    cover.Modal = true
    cover.ZIndex = 1
    cover.Parent = gui
    local card = Instance.new("Frame")
    card.Size = UDim2.fromOffset(380, 154)
    card.Position = UDim2.new(0.5, -190, 0.5, -77)
    card.BackgroundColor3 = app.palette.card
    card.BorderSizePixel = 0
    card.ZIndex = 2
    card.Parent = gui
    app.operations.corner(card, 12)
    app.operations.stroke(card, app.palette.cardBorder, 1)
    app.pad(card, 20, 16)
    app.loadCard = card
    app.loadTitle = Instance.new("TextLabel")
    app.loadTitle.Size = UDim2.new(1, 0, 0, 24)
    app.loadTitle.BackgroundTransparency = 1
    app.loadTitle.Font = Enum.Font.GothamBold
    app.loadTitle.TextSize = 17
    app.loadTitle.TextColor3 = app.palette.text
    app.loadTitle.TextXAlignment = Enum.TextXAlignment.Left
    app.loadTitle.Text = "Loading..."
    app.loadTitle.ZIndex = 3
    app.loadTitle.Parent = card
    app.loadDetail = Instance.new("TextLabel")
    app.loadDetail.Size = UDim2.new(1, 0, 0, 38)
    app.loadDetail.Position = UDim2.fromOffset(0, 30)
    app.loadDetail.BackgroundTransparency = 1
    app.loadDetail.Font = Enum.Font.Gotham
    app.loadDetail.TextSize = 12
    app.loadDetail.TextColor3 = app.palette.muted
    app.loadDetail.TextWrapped = true
    app.loadDetail.TextXAlignment = Enum.TextXAlignment.Left
    app.loadDetail.TextYAlignment = Enum.TextYAlignment.Top
    app.loadDetail.Text = ""
    app.loadDetail.ZIndex = 3
    app.loadDetail.Parent = card
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 8)
    track.Position = UDim2.fromOffset(0, 78)
    track.BackgroundColor3 = app.palette.field
    track.BorderSizePixel = 0
    track.ZIndex = 3
    track.Parent = card
    app.operations.corner(track, 4)
    app.loadFill = Instance.new("Frame")
    app.loadFill.Size = UDim2.new(0, 0, 1, 0)
    app.loadFill.BackgroundColor3 = app.palette.accent
    app.loadFill.BorderSizePixel = 0
    app.loadFill.ZIndex = 4
    app.loadFill.Parent = track
    app.operations.corner(app.loadFill, 4)
    app.loadPercent = Instance.new("TextLabel")
    app.loadPercent.Size = UDim2.new(1, 0, 0, 18)
    app.loadPercent.Position = UDim2.fromOffset(0, 94)
    app.loadPercent.BackgroundTransparency = 1
    app.loadPercent.Font = Enum.Font.Code
    app.loadPercent.TextSize = 12
    app.loadPercent.TextColor3 = app.palette.subtle
    app.loadPercent.TextXAlignment = Enum.TextXAlignment.Left
    app.loadPercent.Text = ""
    app.loadPercent.ZIndex = 3
    app.loadPercent.Parent = card
    return true
end
function app.LoadUI.render()
    app.operations.buildLoadGui()
    local active = app.LoadUI.localActive or app.LoadUI.remotePeer ~= nil
    if app.LoadUI.gui then
        app.LoadUI.gui.Enabled = active
    end
    if app.LoadUI.frame then
        app.LoadUI.frame.Visible = active
    end
    if not active then
        return 
    end
    local title, detail, done, total
    if app.LoadUI.localActive then
        title = app.LoadUI.localTitle or "Loading..."
        detail = app.LoadUI.localDetail or "Please wait. Editing is paused for both players."
        done, total = app.LoadUI.localDone or 0, app.LoadUI.localTotal or 0
    else
        local peer = app.LoadUI.remotePeer
        title = "Waiting for " .. tostring(peer.name or "other player")
        detail = tostring(peer.task or "Loading map...") .. ". Editing is paused."
        done, total = tonumber(peer.done) or 0, tonumber(peer.total) or 0
    end
    if app.loadTitle then
        app.loadTitle.Text = title
    end
    if app.loadDetail then
        app.loadDetail.Text = detail
    end
    local fraction = total &gt; 0 and math.clamp(done / total, 0, 1) or 0
    if app.loadFill then
        app.loadFill.Size = UDim2.fromScale(fraction, 1)
    end
    local percent = total &gt; 0 and string.format("%d / %d  (%d%%)", done, total, math.floor(fraction * 100)) or "Working..."
    if app.loadPercent then
        app.loadPercent.Text = percent
    end
    if app.LoadUI.fallbackTitle then
        app.LoadUI.fallbackTitle.Text = title
    end
    if app.LoadUI.fallbackDetail then
        app.LoadUI.fallbackDetail.Text = detail .. "\n" .. percent
    end
end
function app.LoadUI.setLocal(active, title, detail, done, total)
    app.LoadUI.localActive = active == true
    app.LoadUI.localTitle = title
    app.LoadUI.localDetail = detail
    app.LoadUI.localDone = done or 0
    app.LoadUI.localTotal = total or 0
    app.LoadUI.render()
end
function app.LoadUI.setRemote(peer)
    if peer and (peer.loading or peer.active) then
        app.LoadUI.remotePeer = {
            name = peer.name,
            task = peer.loadTask or peer.task,
            done = peer.loadDone or peer.done,
            total = peer.loadTotal or peer.total,
            at = os.clock(),
        }
    else
        app.LoadUI.remotePeer = nil
    end
    app.LoadUI.render()
end
function app.LoadUI.clearRemote()
    app.LoadUI.remotePeer = nil
    app.LoadUI.render()
end
function app.LoadUI.hide()
    app.LoadUI.localActive = false
    app.LoadUI.remotePeer = nil
    app.LoadUI.render()
end
function app.operations.refreshUI(isActive, isLoggedIn, hasInbox, isBusy)
    app.homePanel.Visible = app.uiTab == "home"
    app.teamTestPanel.Visible = app.uiTab == "teamTest"
    app.settingsPanel.Visible = app.uiTab == "settings"
    if app.shareNick.Text ~= app.selfNick.Text then
        app.shareNick.Text = app.selfNick.Text
    end
    app.identity.Text = isLoggedIn and (app.selfNick.Text .. (isActive and " | In Session" or " | Ready")) or "Connecting to server..."
    if isActive then
        app.dot.BackgroundColor3 = app.palette.green
        app.statusBadgeLabel.Text = "LIVE"
        app.statusBadgeLabel.TextColor3 = app.palette.green
        app.badgeStroke.Color = app.palette.green
    elseif isLoggedIn then
        app.dot.BackgroundColor3 = app.palette.accent
        app.statusBadgeLabel.Text = "READY"
        app.statusBadgeLabel.TextColor3 = app.palette.accent
        app.badgeStroke.Color = app.palette.line
    else
        app.dot.BackgroundColor3 = app.palette.muted
        app.statusBadgeLabel.Text = "OFFLINE"
        app.statusBadgeLabel.TextColor3 = app.palette.muted
        app.badgeStroke.Color = app.palette.line
    end
    app.startCard.Visible = not isActive
    app.sessionCard.Visible = isActive
    app.connect.Visible = isActive
    app.roomCodeLabel.Visible = isActive and app.room.Text ~= ""
    app.roomCodeLabel.Text = "Room code (select below, Ctrl+C)"
    if app.copyRoom.Text ~= app.room.Text then
        app.copyRoom.Text = app.room.Text
    end
    app.copyRoom.Visible = isActive and app.room.Text ~= ""
    app.incomingCard.Visible = hasInbox
    app.retry.Visible = isLoggedIn and not isActive and app.room.Text ~= ""
    if app.operations.isLocalAddress(app.base()) then
        app.localModeHint.Text = "LOCAL TEST MODE | this Studio window has its own identity (" .. app.localInstanceTag .. "). Host in one window and join with the room code in another. No port forwarding needed."
    else
        app.localModeHint.Text = ""
    end
    app.joinCode.TextEditable = not isBusy
    app.nick.TextEditable = not isBusy
    for key, b in pairs(app.tabButtons) do
        local isSelected = app.uiTab == key
        b.BackgroundColor3 = isSelected and app.palette.tabActive or app.palette.tabBg
        b.TextColor3 = isSelected and app.palette.text or app.palette.muted
        b.Font = isSelected and Enum.Font.GothamBold or Enum.Font.GothamMedium
        if app.tabStrokes[key] then
            app.tabStrokes[key].Enabled = isSelected
            app.tabStrokes[key].Color = isSelected and app.palette.cardBorder or app.palette.line
        end
    end
    for _, b in ipairs({
        app.invite,
        app.yes,
        app.no,
        app.connect,
        app.retry,
        app.accept,
        app.logout,
        app.hostButton,
        app.hostSame,
        app.joinButton,
        app.joinSame,
        app.useLocal,
    }) do
        b.Active = not isBusy
        b.AutoButtonColor = not isBusy
        b.TextTransparency = isBusy and 0.45 or 0
    end
end
app.button.Click:Connect(function()
    app.widget.Enabled = not app.widget.Enabled
end)
app.operations.refreshUI(false, false, false, false)
;
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="PT_RoomActions">
      <Properties>
        <string name="Name">RoomActions</string>
        <ProtectedString name="Source">-- PlaceTogether Studio application component.
return function(app)
app.inbox = nil
app.lastSent = nil
app.inviting = false
app.polling = false
app.api = function(path, method, payload, renewed)
    local t0 = os.clock()
    local reqUrl = app.base() .. "/api" .. path
    if (method or "GET") == "GET" then
        reqUrl = reqUrl .. (reqUrl:find("?") and "&amp;" or "?") .. "_t=" .. tostring(os.clock())
    end
    local response = app.http:RequestAsync({
        Url = reqUrl,
        Method = method or "GET",
        Headers = {
            Authorization = "Bearer " .. app.token.Text,
            ["Content-Type"] = "application/json",
            ["bypass-tunnel-reminder"] = "true",
            ["X-PT-Secret"] = app.features.secret and app.features.secret.Text or (app.owner:GetSetting("PTServerSecret") or ""),
        },
        Body = payload and app.http:JSONEncode(payload) or nil,
    })
    if response.StatusCode == 401 and path ~= "/guest" and not renewed then
        app.guestEnter()
        ;
        return app.api(path, method, payload, true)
    end
    local decoded, data = pcall(function()
        return app.http:JSONDecode(response.Body)
    end)
    if not decoded then
        error("Server unavailable (HTTP " .. response.StatusCode .. "). Check server address and verify server is running.")
    end
    if not response.Success then
        error(data.error or ("HTTP " .. response.StatusCode))
    end
    return data
end
app.guestEnter = function(rename)
    local serverBase = app.base()
    if serverBase == "" or not serverBase:match("^https?://") then
        app.status("Enter server address in Settings tab")
        ;
        return 
    end
    local localMode = app.operations.isLocalAddress(serverBase)
    local key
    if localMode then
        key = app.localInstanceKey
        local remoteName = app.owner:GetSetting("PTInviteName")
        if app.selfNick.Text == "" or app.selfNick.Text == remoteName then
            app.localNick = app.localNick or (app.operations.defaultDisplayName(key) .. " #" .. app.localInstanceTag)
            app.selfNick.Text = app.localNick
        elseif rename then
            app.localNick = app.selfNick.Text
        end
        if app.localNick == nil or app.localNick == "" then
            app.localNick = app.selfNick.Text
        end
        if app.selfNick.Text == "" then
            app.selfNick.Text = app.localNick
        end
    else
        key = app.owner:GetSetting("PTGuestDeviceKey") or app.owner:GetSetting("PTGuestDeviceKey:" .. serverBase)
        if type(key) ~= "string" or #key ~= 64 then
            key = (app.http:GenerateGUID(false) .. app.http:GenerateGUID(false)):gsub("-", ""):lower()
            app.owner:SetSetting("PTGuestDeviceKey:" .. serverBase, key)
        end
        app.owner:SetSetting("PTGuestDeviceKey", key)
        if app.selfNick.Text == "" or app.selfNick.Text == app.localNick then
            app.selfNick.Text = app.owner:GetSetting("PTInviteName") or app.operations.defaultDisplayName(key)
        end
    end
    local value = app.api("/guest", "POST", {
        name = app.selfNick.Text,
        deviceKey = key,
        rename = rename == true,
    })
    app.token.Text = value.token
    ;
    app.credential = value.token
    ;
    app.selfNick.Text = value.name
    ;
    app.loggedIn = true
    if localMode then
        app.localNick = value.name
        app.status("Local test identity: " .. value.name .. ". Host or join with a room code.")
    else
        app.owner:SetSetting("PTInviteToken:" .. serverBase, value.token)
        app.owner:SetSetting("PTInviteName", value.name)
        app.status("Your username: " .. value.name .. ". Ready to invite friends.")
    end
    app.owner:SetSetting("PTAddress", serverBase)
    return value
end
function app.operations.openHost(forceNew, sameCopy)
    if not app.loggedIn then
        app.guestEnter()
    end
    if app.active then
        return 
    end
    local storage = game:GetService("ReplicatedStorage")
    if forceNew then
        storage:SetAttribute("PT_SavedRoom", nil)
        storage:SetAttribute("PT_SavedServer", nil)
    end
    local saved = storage:GetAttribute("PT_SavedRoom")
    if not forceNew and type(saved) == "string" and saved:match("^[a-f0-9]+$") and storage:GetAttribute("PT_SavedServer") == app.base() then
        local accessible, info = pcall(function()
            return app.api("/rooms/" .. saved .. "/state")
        end)
        if accessible and not info.closed and (info.mode == "copy") == (sameCopy == true) then
            app.room.Text = saved
            ;
            app.sessionTitle.Text = info.name
            ;
            app.operations.connectSession({
                host = true,
                sameCopy = sameCopy,
            })
            if not app.active then
                error(app.notice.Text)
            end
            return 
        end
        storage:SetAttribute("PT_SavedRoom", nil)
        ;
        storage:SetAttribute("PT_SavedServer", nil)
        app.restoreSuppressed = true
        ;
        app.room.Text = ""
    end
    local value = app.api("/rooms", "POST", {
        name = game.Name,
        mode = sameCopy and "copy" or "live",
    })
    app.room.Text = value.id
    app.sessionTitle.Text = game.Name
    app.operations.connectSession({
        host = true,
        sameCopy = sameCopy,
    })
    if not app.active then
        error(app.notice.Text)
    end
    storage:SetAttribute("PT_SavedRoom", value.id)
    storage:SetAttribute("PT_SavedServer", app.base())
    app.connect.Visible = true
end
function app.operations.inviteUser()
    if app.inviting then
        return 
    end
    app.inviting = true
    local ok, err = pcall(function()
        if #app.nick.Text:gsub("%s+", "") &lt; 3 then
            error("Enter friend's plugin username")
        end
        app.operations.openHost()
        local sent = app.api("/invitations", "POST", {
            room = app.room.Text,
            nick = app.nick.Text,
        })
        ;
        app.lastSent = sent.id
        app.inviteStatus.Text = sent.recipientOnline and ("Waiting for acceptance: " .. app.nick.Text) or ("Request saved. Waiting for '" .. app.nick.Text .. "' to open the plugin.")
        app.status(app.inviteStatus.Text)
    end)
    app.inviting = false
    ;
    if not ok then
        app.inviteStatus.Text = tostring(err)
        ;
        app.status(tostring(err))
    end
end
app.invite.MouseButton1Click:Connect(app.operations.inviteUser)
-- Empty folders, empty configurations and the default Baseplate/Spawn are
-- ignored. Real content no longer blocks a join, but the user is warned because
-- it will stay next to the shared map.
function app.operations.ignorableObject(obj)
    if obj:IsA("Terrain") or obj:IsA("Camera") then
        return true
    end
    if obj:IsA("Folder") or obj:IsA("Configuration") then
        for _, child in ipairs(obj:GetDescendants()) do
            if not app.operations.ignorableObject(child) then
                return false
            end
        end
        return true
    end
    return false
end
function app.operations.emptyPlace()
    for _, service in ipairs({
        "ReplicatedStorage",
        "ServerScriptService",
        "ServerStorage",
        "StarterGui",
        "StarterPack",
    }) do
        for _, obj in ipairs(game:GetService(service):GetChildren()) do
            if not app.operations.ignorableObject(obj) then
                return false
            end
        end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if not app.operations.ignorableObject(obj) and obj.Name ~= "Baseplate" and not obj:IsA("SpawnLocation") then
            return false
        end
    end
    return true
end
function app.operations.placeObjectCount(limit)
    local count = 0
    local function walk(parent)
        for _, child in ipairs(parent:GetChildren()) do
            count = count + (1)
            if count &gt;= limit then
                return true
            end
            if walk(child) then
                return true
            end
        end
        return false
    end
    for _, name in ipairs(app.roots) do
        if walk(game:GetService(name)) then
            break
        end
    end
    return count
end
app.heavyConfirmed = nil
function app.operations.heavyNoticeText(text)
    app.heavyNotice.Text = text
    app.heavyNotice.Visible = true
end
function app.operations.clearHeavyNotice()
    app.heavyNotice.Visible = false
    app.heavyNotice.Text = ""
end
function app.operations.startHost(sameCopy)
    if app.active then
        app.status("Already in a session.")
        ;
        return 
    end
    if app.busy then
        return 
    end
    if not sameCopy then
        local count = app.operations.placeObjectCount(app.HEAVY_PLACE_OBJECTS)
        if count &gt;= app.HEAVY_PLACE_OBJECTS and app.heavyConfirmed ~= "host" then
            app.heavyConfirmed = "host"
            app.operations.heavyNoticeText("Large place detected (" .. count .. "+ objects). Uploading it will be slow for both players. Recommended: send your friend an identical 1:1 .rbxl copy, open it in both Studios, and use Host Same Copy + Join Same Copy. To upload anyway, press Host New Session again.")
            app.status("Large place: use Same Copy for instant start, or press Host New Session again to upload.")
            return 
        end
    end
    app.operations.clearHeavyNotice()
    ;
    app.heavyConfirmed = nil
    local ok, err = pcall(app.operations.openHost, true, sameCopy == true)
    if not ok then
        app.status(tostring(err))
        ;
        return 
    end
    if app.active then
        if sameCopy then
            app.status("Same Copy room ready. Room code: " .. app.room.Text .. ". Send the identical .rbxl to your friend, then use Join Same Copy.")
        else
            app.status("Session ready. Room code: " .. app.room.Text .. ". Open a second Studio and click Join by Room Code.")
        end
    end
end
function app.operations.joinRoomByCode(sameCopy)
    if app.active then
        app.status("Leave the current session first.")
        ;
        return 
    end
    if app.busy then
        return 
    end
    if app.run:IsRunning() then
        app.status("Stop Play/Test mode before connecting.")
        ;
        return 
    end
    local code = tostring(app.joinCode.Text or ""):gsub("%s+", "")
    if code == "" then
        app.status("Enter the room code shown in the host Studio.")
        ;
        return 
    end
    if #code &gt; 64 or not code:match("^[%w_-]+$") then
        app.status("Invalid room code.")
        ;
        return 
    end
    local clean = app.operations.emptyPlace()
    app.busy = true
    local info, confirmHeavy, heavyDetail
    local ok, err = pcall(function()
        if not app.loggedIn then
            app.guestEnter()
        end
        info = app.api("/rooms/" .. code .. "/state")
        if info.closed then
            error("This room is closed.")
        end
        if info.mode == "copy" and not sameCopy then
            error("This room uses Same Copy mode. Open the shared .rbxl and use Join Same Copy.")
        end
        if sameCopy and info.mode ~= "copy" then
            error("This is a normal live room. Use Join by Room Code instead.")
        end
        if not sameCopy then
            local objects = tonumber(info.objectCount) or 0
            local bytes = tonumber(info.sizeBytes) or 0
            local heavy = info.heavy == true or objects &gt;= app.HEAVY_OBJECTS or bytes &gt;= app.HEAVY_BYTES
            if heavy and app.heavyConfirmed ~= code then
                confirmHeavy = true
                heavyDetail = string.format("%d objects, %.1f MB", objects, bytes / (1024 * 1024))
                return 
            end
        end
        app.room.Text = code
        app.sessionTitle.Text = info.name or game.Name
    end)
    app.busy = false
    if not ok then
        app.status(tostring(err))
        ;
        return 
    end
    if confirmHeavy then
        app.heavyConfirmed = code
        app.operations.heavyNoticeText("This map is large (" .. heavyDetail .. "). Recommended: ask the host to send you the identical 1:1 .rbxl, open it in Studio, and use Join Same Copy (no download). To download it anyway, press Join by Room Code again.")
        app.status("Large map: Same Copy is recommended, or press Join by Room Code again to download.")
        return 
    end
    app.operations.clearHeavyNotice()
    ;
    app.heavyConfirmed = nil
    app.operations.connectSession({
        sameCopy = sameCopy == true,
    })
    if not app.active then
        app.status(app.notice.Text)
        ;
        return 
    end
    if not sameCopy then
        -- The shared map is authoritative. Remove only leftover default objects
        -- that the host did not claim; real content and empty folders stay.
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "Baseplate" or obj:IsA("SpawnLocation") then
                local key = app.instanceKeys[obj]
                if key and not app.lastRemoteKeys[key] then
                    app.acknowledged[key] = nil
                    ;
                    app.instances[key] = nil
                    ;
                    app.instanceKeys[obj] = nil
                    pcall(function()
                        obj:Destroy()
                    end)
                end
            end
        end
    end
    app.joinCode.Text = ""
    local storage = game:GetService("ReplicatedStorage")
    storage:SetAttribute("PT_SavedRoom", app.room.Text)
    storage:SetAttribute("PT_SavedServer", app.base())
    app.synchronization.centerPending = true
    if sameCopy then
        app.status("Joined same-copy room " .. app.room.Text .. ". Both places must stay identical; only edits are synced.")
    else
        local extra = clean and "" or " Existing objects were left in place; remove them if the shared map looks cluttered."
        app.status("Joined room " .. app.room.Text .. (app.operations.isLocalAddress(app.base()) and " (local test mode)." or ".") .. extra)
    end
end
-- Use the main visible map cluster. A distant helper part must not move the join camera.
function app.synchronization.mapCenter(samples, spawns, terrain)
    local function median(values)
        table.sort(values)
        ;
        return values[math.ceil(#values / 2)]
    end
    if #samples == 0 then
        if #spawns &gt; 0 then
            return spawns[1].position, Vector3.new(48, 16, 48)
        end
        if #terrain &gt; 0 then
            local xs, ys, zs = {
            }, {
            }, {
            }
            for _, p in ipairs(terrain) do
                table.insert(xs, p.X)
                ;
                table.insert(ys, p.Y)
                ;
                table.insert(zs, p.Z)
            end
            return Vector3.new(median(xs), median(ys) + 32, median(zs)), Vector3.new(96, 32, 96)
        end
        return Vector3.new(0, 8, 0), Vector3.new(48, 16, 48)
    end
    local xs, ys, zs = {
    }, {
    }, {
    }
    for _, v in ipairs(samples) do
        table.insert(xs, v.position.X)
        ;
        table.insert(ys, v.position.Y)
        ;
        table.insert(zs, v.position.Z)
    end
    local seed = Vector3.new(median(xs), median(ys), median(zs))
    local smallRadius
    if #samples &lt; 5 then
        local biggest = samples[1]
        for _, v in ipairs(samples) do
            if v.volume &gt; biggest.volume then
                biggest = v
            end
        end
        seed = biggest.position
        smallRadius = math.max(128, biggest.extent.Magnitude * 3)
    end
    local distances = {
    }
    for _, v in ipairs(samples) do
        table.insert(distances, (v.position - seed).Magnitude)
    end
    table.sort(distances)
    local radius = math.max(128, distances[math.max(1, math.ceil(#distances * 0.7))] * 1.5)
    if smallRadius then
        radius = smallRadius
    end
    local low, high = nil, nil
    for _, v in ipairs(samples) do
        if (v.position - seed).Magnitude &lt;= radius then
            local a, b = v.position - v.extent, v.position + v.extent
            if not low then
                low = a
                ;
                high = b
            else
                low = Vector3.new(math.min(low.X, a.X), math.min(low.Y, a.Y), math.min(low.Z, a.Z))
                high = Vector3.new(math.max(high.X, b.X), math.max(high.Y, b.Y), math.max(high.Z, b.Z))
            end
        end
    end
    if not low then
        return seed, Vector3.new(48, 16, 48)
    end
    return (low + high) / 2, high - low
end
function app.synchronization.centerAfterJoin()
    local cam = workspace.CurrentCamera
    if not cam then
        app.synchronization.centerPending = true
        ;
        return 
    end
    local samples, spawns, terrain = {
    }, {
    }, {
    }
    app.synchronization.sliceAt = os.clock()
    for _, o in pairs(app.instances) do
        if o:IsA("BasePart") and o:IsDescendantOf(workspace) then
            if o:IsA("SpawnLocation") then
                if o.Enabled then
                    table.insert(spawns, {
                        position = o.Position,
                    })
                end
            elseif o.Transparency &lt; 0.98 and o.Archivable and o.Size.Magnitude &gt; 0.1 then
                local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = o.CFrame:GetComponents()
                local h = o.Size / 2
                local extent = Vector3.new(math.abs(r00) * h.X + math.abs(r01) * h.Y + math.abs(r02) * h.Z, math.abs(r10) * h.X + math.abs(r11) * h.Y + math.abs(r12) * h.Z, math.abs(r20) * h.X + math.abs(r21) * h.Y + math.abs(r22) * h.Z)
                table.insert(samples, {
                    position = o.Position,
                    extent = extent,
                    volume = o.Size.X * o.Size.Y * o.Size.Z,
                })
            end
        end
        app.synchronization.budget()
    end
    for _, origin in pairs(app.terrainKnown) do
        table.insert(terrain, Vector3.new(origin[1] + 32, origin[2] + 32, origin[3] + 32))
    end
    local center, span = app.synchronization.mapCenter(samples, spawns, terrain)
    local distance = math.clamp(math.max(span.X, span.Z) * 0.45, 24, 100)
    -- Keep the first view close to the map, even when the entire place is very large.
    local target = Vector3.new(center.X, center.Y, center.Z)
    local params = RaycastParams.new()
    ;
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ray = workspace:Raycast(target + Vector3.new(0, math.max(64, span.Y + 16), 0), Vector3.new(0, -math.max(256, span.Y * 2 + 128), 0), params)
    if ray then
        target = ray.Position + Vector3.new(0, 3, 0)
    end
    cam.CFrame = CFrame.lookAt(target + Vector3.new(distance * 0.65, distance * 0.7, distance * 0.75), target)
    cam.Focus = CFrame.new(target)
    app.synchronization.centerPending = false
    app.synchronization.log("Joined at map center")
end
function app.operations.focusImportedPlace()
    app.synchronization.centerAfterJoin()
end
function app.operations.acceptInvitation()
    if not app.inbox or app.inviting or app.busy then
        return 
    end
    if app.active then
        app.status("Disconnect from current session first.")
        ;
        return 
    end
    app.inviting = true
    local ok, err = pcall(function()
        local result = app.api("/invitations/" .. app.inbox.id .. "/respond", "POST", {
            decision = "accept",
        })
        app.room.Text = result.room.id
        ;
        app.inbox = nil
        ;
        app.yes.Visible = false
        ;
        app.no.Visible = false
        app.sessionTitle.Text = result.room.name
        local sameCopy = result.room.mode == "copy"
        app.operations.connectSession({
            sameCopy = sameCopy,
        })
        app.connect.Visible = app.active
        if not app.active then
            error(app.notice.Text)
        end
        if not sameCopy then
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj.Name == "Baseplate" or obj:IsA("SpawnLocation") then
                    local key = app.instanceKeys[obj]
                    if key and not app.lastRemoteKeys[key] then
                        app.acknowledged[key] = nil
                        ;
                        app.instances[key] = nil
                        ;
                        app.instanceKeys[obj] = nil
                        pcall(function()
                            obj:Destroy()
                        end)
                    end
                end
            end
        end
        app.operations.focusImportedPlace()
        app.incoming.Text = "You are collaborating on " .. result.room.name .. " together."
    end)
    app.inviting = false
    ;
    if not ok then
        app.status(tostring(err))
    end
end
app.yes.MouseButton1Click:Connect(app.operations.acceptInvitation)

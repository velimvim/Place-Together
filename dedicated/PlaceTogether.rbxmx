app.dashToggle = app.operations.makeButton("Web Dashboard: Checking...", app.settingsPanel)
local isDashEnabled = false
local function updateDashButton(state)
    isDashEnabled = (state == true)
    if isDashEnabled then
        app.dashToggle.Text = "Web Dashboard: Enabled"
        app.dashToggle.TextColor3 = app.palette.green
    else
        app.dashToggle.Text = "Web Dashboard: Disabled"
        app.dashToggle.TextColor3 = app.palette.subtle
    end
end
local function fetchDashStatus()
    task.spawn(function()
        local ok, cfg = pcall(function() return app.api("/config/dashboard", "GET") end)
        if ok and type(cfg) == "table" and cfg.enabled ~= nil then
            updateDashButton(cfg.enabled == true)
        else
            app.dashToggle.Text = "Web Dashboard: Disabled"
            app.dashToggle.TextColor3 = app.palette.subtle
        end
    end)
end
app.dashToggle.MouseButton1Click:Connect(function()
    app.dashToggle.Text = "Updating..."
    task.spawn(function()
        local ok, res = pcall(function() return app.api("/config/dashboard", "POST", {enabled = not isDashEnabled}) end)
        if ok and type(res) == "table" and res.enabled ~= nil then
            updateDashButton(res.enabled == true)
            app.status("Web Dashboard " .. (res.enabled and "enabled" or "disabled") .. " on server.")
        else
            updateDashButton(isDashEnabled)
            app.status("Failed to toggle dashboard: " .. tostring(res))
        end
    end)
end)
task.spawn(fetchDashStatus)

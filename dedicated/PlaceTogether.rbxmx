function app.synchronization.budget()
    if os.clock() - app.synchronization.sliceAt &gt;= 0.002 then
        task.wait()
        ;
        app.synchronization.sliceAt = os.clock()
    end
    if not app.synchronization.alive then
        error("Plugin unloaded")
    end
end
-- AnimationTrack.Stopped is not always delivered while a plugin previews an
-- animation, so also ask the Animator which tracks are playing. The result is
-- cached briefly because capture/apply run for many parts in a burst.
function app.synchronization.rigAnimating(rig)
    if not rig then
        return false
    end
    local animator = rig:FindFirstChildOfClass("Animator")
    if not animator then
        local humanoid = rig:FindFirstChildOfClass("Humanoid")
        animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    end
    if animator then
        local cached = app.synchronization.animCheck[animator]
        if not cached or os.clock() - cached.at &gt; 0.2 then
            local ok, tracks = pcall(function()
                return animator:GetPlayingAnimationTracks()
            end)
            cached = {
                at = os.clock(),
                playing = ok and type(tracks) == "table" and #tracks &gt; 0 or false,
            }
            app.synchronization.animCheck[animator] = cached
        end
        if cached.playing then
            return true
        end
    end
    return (app.synchronization.animationUntil[rig] or 0) &gt; os.clock()
end
function app.synchronization.disconnect()
    app.synchronization.ready = false
    app.synchronization.enabled = false
    for _, list in pairs(app.synchronization.watches) do
        for _, c in ipairs(list) do
            c:Disconnect()
        end
    end
    for _, c in ipairs(app.synchronization.connections) do
        c:Disconnect()
    end
    app.synchronization.watches = {
    }
    ;
    app.synchronization.connections = {
    }
    for _, c in ipairs(app.synchronization.inputConnections) do
        c:Disconnect()
    end
    for _, list in pairs(app.synchronization.handleWatches) do
        for _, c in ipairs(list) do
            c:Disconnect()
        end
    end
    app.synchronization.inputConnections = {
    }
    ;
    app.synchronization.handleWatches = {
    }
    ;
    app.synchronization.handleHeld = {
    }
    ;
    app.synchronization.pointerDown = false
    ;
    app.synchronization.focusLost = false
end
function app.synchronization.mark(obj, internal)
    if not app.synchronization.enabled or app.run:IsRunning() then
        return 
    end
    if app.synchronization.receiving then
        return 
    end
    local now = os.clock()
    local rig = app.operations.rigOf(obj)
    if rig and obj:IsA("BasePart") and obj ~= rig.PrimaryPart and obj.Name ~= "HumanoidRootPart" then
        local b = app.synchronization.rigBurst[rig]
        if not b or now - b.start &gt; 0.7 then
            b = {
                start = now,
                count = 0,
            }
            ;
            app.synchronization.rigBurst[rig] = b
        end
        b.count = b.count + (1)
        if b.count &gt;= 10 then
            app.synchronization.animationUntil[rig] = now + 2.5
        end
    end
    if app.synchronization.ready and not internal then
        app.synchronization.lastEditAt = now
    end
    if not app.synchronization.dirty[obj] then
        app.synchronization.dirty[obj] = true
        ;
        table.insert(app.synchronization.queue, obj)
    end
end
-- Toolbox models can insert hundreds of parts in one frame. Publishing that in
-- the background makes both Studios feel frozen, so the workers detect the burst
-- and switch to the full-screen loading flow instead.
function app.synchronization.noteInsert(obj)
    if app.synchronization.receiving or not app.synchronization.ready or app.run:IsRunning() then
        return 
    end
    local now = os.clock()
    if now &gt; (app.synchronization.insertUntil or 0) then
        app.synchronization.insertCount = 0
    end
    app.synchronization.insertUntil = now + 1.5
    app.synchronization.insertCount = (app.synchronization.insertCount or 0) + 1
    if app.synchronization.insertCount &gt;= 100 then
        app.synchronization.bulkDue = true
        if not app.synchronization.bulkUpload then
            app.synchronization.loading = true
            app.synchronization.loadTask = "Loading model"
            app.LoadUI.setLocal(true, "Loading model", "Preparing a heavy insertion...", 0, 0)
        end
    end
end
function app.synchronization.log(message)
    table.insert(app.synchronization.activity, 1, os.date("%H:%M:%S") .. "  " .. message)
    while #app.synchronization.activity &gt; 5 do
        table.remove(app.synchronization.activity)
    end
end
function app.synchronization.releasePointer()
    app.synchronization.pointerDown = false
    ;
    app.synchronization.handleHeld = {
    }
    ;
    app.synchronization.releasedAt = os.clock()
end
function app.synchronization.inputHeld()
    if not app.synchronization.ready then
        return false
    end
    local ok, down = pcall(function()
        return game:GetService("UserInputService"):IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    end)
    if ok then
        app.synchronization.pointerDown = down
    end
    return app.synchronization.pointerDown or next(app.synchronization.handleHeld) ~= nil or app.synchronization.focusLost
end
function app.synchronization.holdReason()
    if not app.synchronization.ready then
        return nil
    end
    if app.synchronization.loading then
        return "Loading"
    end
    if app.synchronization.remoteLoad then
        return "Remote loading"
    end
    if app.synchronization.paused then
        return "Paused"
    end
    if app.synchronization.inputHeld() then
        return "Editing"
    end
    if os.clock() - math.max(app.synchronization.lastEditAt, app.synchronization.releasedAt) &lt; 0.35 then
        return "Waiting"
    end
    return nil
end
function app.synchronization.watchHandle(handle)
    if app.synchronization.handleWatches[handle] or not (handle:IsA("Handles") or handle:IsA("ArcHandles")) then
        return 
    end
    app.synchronization.handleWatches[handle] = {
        handle.MouseButton1Down:Connect(function()
            app.synchronization.handleHeld[handle] = true
            ;
            app.synchronization.pointerDown = true
        end),
        handle.MouseButton1Up:Connect(function()
            app.synchronization.releasePointer()
        end),
        handle.Destroying:Connect(function()
            app.synchronization.handleHeld[handle] = nil
            ;
            app.synchronization.handleWatches[handle] = nil
        end),
    }
end
function app.synchronization.attachInput()
    local function bind(callback)
        local ok, c = pcall(callback)
        ;
        if ok and c then
            table.insert(app.synchronization.inputConnections, c)
        end
    end
    local u = game:GetService("UserInputService")
    bind(function()
        return u.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                app.synchronization.pointerDown = true
            end
        end)
    end)
    bind(function()
        return u.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                app.synchronization.releasePointer()
            end
        end)
    end)
    bind(function()
        return u.WindowFocusReleased:Connect(function()
            app.synchronization.focusLost = false
            ;
            app.synchronization.releasePointer()
        end)
    end)
    bind(function()
        return u.WindowFocused:Connect(function()
            app.synchronization.focusLost = false
            ;
            app.synchronization.releasePointer()
        end)
    end)
    local ok, mouse = pcall(function()
        return app.owner:GetMouse()
    end)
    if ok then
        bind(function()
            return mouse.Button1Down:Connect(function()
                app.synchronization.pointerDown = true
            end)
        end)
        bind(function()
            return mouse.Button1Up:Connect(app.synchronization.releasePointer)
        end)
    end
    -- Listen to other plugins' visible Handles without activating or stealing their tool.
    local core = game:GetService("CoreGui")
    bind(function()
        return core.DescendantAdded:Connect(function(o)
            app.synchronization.watchHandle(o)
        end)
    end)
    for _, o in ipairs(core:GetDescendants()) do
        app.synchronization.watchHandle(o)
        ;
        app.synchronization.budget()
    end
end
function app.synchronization.queueCount()
    local seen = {
    }
    ;
    local count = 0
    local function add(key)
        if not seen[key] then
            seen[key] = true
            ;
            count = count + (1)
        end
    end
    for o in pairs(app.synchronization.dirty) do
        add(app.instanceKeys[o] or o)
    end
    for key in pairs(app.synchronization.unsent) do
        add(key)
    end
    for key in pairs(app.synchronization.retryRecords) do
        add(key)
    end
    return count
end

function app.operations.textLabel(text, height, parent)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, height or 20)
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.Text = text
    l.TextColor3 = app.palette.muted
    l.BackgroundTransparency = 1
    l.TextWrapped = true
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.Font = Enum.Font.Gotham
    l.TextSize = 13
    l.Parent = parent or app.currentParent
    return l
end
function app.title(text, parent)
    local l = app.operations.textLabel(text, 22, parent)
    l.Font = Enum.Font.GothamBold
    l.TextSize = 16
    l.TextColor3 = app.palette.text
    return l
end
function app.operations.field(placeholder, text, parent)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, 0, 0, 38)
    box.Text = text or ""
    box.PlaceholderText = placeholder
    box.ClearTextOnFocus = false
    box.TextColor3 = app.palette.text
    box.PlaceholderColor3 = app.palette.subtle
    box.BackgroundColor3 = app.palette.field
    box.BorderSizePixel = 0
    box.Font = Enum.Font.GothamMedium
    box.TextSize = 13
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.Parent = parent or app.currentParent
    app.operations.corner(box, 8)
    app.pad(box, 12, 0)
    local s = app.operations.stroke(box, app.palette.fieldBorder, 1)
    box.Focused:Connect(function()
        s.Color = app.palette.fieldFocus
        s.Thickness = 1.5
    end)
    box.FocusLost:Connect(function()
        s.Color = app.palette.fieldBorder
        s.Thickness = 1
    end)
    return box
end
function app.operations.makeButton(text, parent, kind)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 38)
    b.Text = text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.BorderSizePixel = 0
    b.AutoButtonColor = true
    b.Parent = parent or app.currentParent
    app.operations.corner(b, 8)
    if kind == "primary" then
        b.TextColor3 = app.palette.ink
        b.BackgroundColor3 = app.palette.accent
        app.operations.stroke(b, app.palette.accentBorder, 1)
    elseif kind == "danger" then
        b.TextColor3 = Color3.fromRGB(252, 165, 165)
        b.BackgroundColor3 = app.palette.dangerBg
        app.operations.stroke(b, app.palette.dangerBorder, 1)
    else
        b.TextColor3 = app.palette.text
        b.BackgroundColor3 = Color3.fromRGB(28, 33, 45)
        b.Font = Enum.Font.GothamMedium
        app.operations.stroke(b, app.palette.line, 1)
    end
    return b
end
function app.card(parent, name)
    local f = app.operations.container(parent, name)
    f.BackgroundTransparency = 0
    f.BackgroundColor3 = app.palette.card
    app.pad(f, 14, 14)
    app.operations.corner(f, 10)
    app.operations.stroke(f, app.palette.cardBorder, 1)
    return f
end

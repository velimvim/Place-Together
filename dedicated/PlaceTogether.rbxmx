local props = {"Anchored", "CanCollide", "CanTouch", "CanQuery", "Transparency", "Reflectance", "Color", "Material", "Size", "CFrame", "Shape", "MeshId", "TextureID", "TextureId", "Texture", "Face", "Enabled", "Brightness", "Range", "Shadows", "Angle", "SoundId", "Volume", "Looped", "PlaybackSpeed", "Value", "PrimaryPart", "Part0", "Part1", "C0", "C1", "Attachment0", "Attachment1", "Position", "Orientation", "Axis", "SecondaryAxis", "Text", "TextSize", "TextColor3", "BackgroundColor3", "BackgroundTransparency", "BorderSizePixel", "Visible", "AnchorPoint", "Image", "ImageColor3", "CanvasSize", "DisplayOrder", "ResetOnSpawn", "Disabled", "Ambient", "OutdoorAmbient", "ClockTime", "FogEnd", "FogStart", "FogColor"}


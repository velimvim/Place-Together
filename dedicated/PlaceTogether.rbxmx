<roblox version="4">
  <Item class="Script" referent="PT_STUDIO_MAIN">
    <Properties>
      <string name="Name">PlaceTogether</string>
      <ProtectedString name="Source">-- PlaceTogether Studio 0.1.1. Each component receives the same explicit context.
local app = { owner = plugin, entry = script }
require(script.Panels)(app)
require(script.Synchronization)(app)
require(script.RoomActions)(app)
require(script.Collaboration)(app)
</ProtectedString>
      <bool name="Disabled">false</bool>
    </Properties>
    <Item class="ModuleScript" referent="PT_AvatarRig">
      <Properties>
        <string name="Name">AvatarRig</string>
        <ProtectedString name="Source">-- Builds a display rig and solves its complete joint graph in Studio Edit mode.
local Rig = {}
Rig.__index = Rig

local function makePart(model, name, size, color, transform)
    local part = Instance.new("Part")
    part.Name, part.Size, part.Color = name, size, color
    part.CFrame = transform
    part.Material = Enum.Material.SmoothPlastic
    part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    part.Parent = model
    return part
end

local function simpleBody(tint)
    local model = Instance.new("Model")
    local skin = Color3.fromRGB(239, 193, 144)
    local root = makePart(model, "HumanoidRootPart", Vector3.new(2,2,1), tint, CFrame.new())
    root.Transparency = 1
    model.PrimaryPart = root
    local torso = makePart(model, "Torso", Vector3.new(2,2,1), tint, CFrame.new())
    local head = makePart(model, "Head", Vector3.new(1.25,1.25,1.25), skin, CFrame.new(0,1.6,0))
    local leftArm = makePart(model, "Left Arm", Vector3.new(1,2,1), skin, CFrame.new(-1.5,0,0))
    local rightArm = makePart(model, "Right Arm", Vector3.new(1,2,1), skin, CFrame.new(1.5,0,0))
    local leftLeg = makePart(model, "Left Leg", Vector3.new(1,2,1), Color3.fromRGB(48,60,80), CFrame.new(-.5,-2,0))
    local rightLeg = makePart(model, "Right Leg", Vector3.new(1,2,1), Color3.fromRGB(48,60,80), CFrame.new(.5,-2,0))
    local function joint(name,a,b,position)
        local motor=Instance.new("Motor6D")
        motor.Name,motor.Part0,motor.Part1=name,a,b
        local world=CFrame.new(position)
        motor.C0,motor.C1=a.CFrame:ToObjectSpace(world),b.CFrame:ToObjectSpace(world)
        motor.Parent=a
    end
    joint("RootJoint",root,torso,Vector3.zero)
    joint("Neck",torso,head,Vector3.new(0,1,0))
    joint("Left Shoulder",torso,leftArm,Vector3.new(-1,1,0))
    joint("Right Shoulder",torso,rightArm,Vector3.new(1,1,0))
    joint("Left Hip",torso,leftLeg,Vector3.new(-.5,-1,0))
    joint("Right Hip",torso,rightLeg,Vector3.new(.5,-1,0))
    return model
end

local function nameplate(model,root,name,tint)
    local gui=Instance.new("BillboardGui")
    gui.Name="BuilderName"
    gui.Size=UDim2.fromOffset(240,66)
    gui.StudsOffsetWorldSpace=Vector3.new(0,3.2,0)
    gui.AlwaysOnTop=true
    gui.Adornee=root
    gui.Parent=model
    local label=Instance.new("TextLabel")
    label.BackgroundTransparency=1
    label.Size=UDim2.new(1,0,0,22)
    label.Position=UDim2.fromOffset(0,40)
    label.Font=Enum.Font.GothamMedium
    label.TextSize=13
    label.TextColor3=tint
    label.TextStrokeTransparency=.35
    label.Text=name
    label.Parent=gui
    return label
end

function Rig.attach(model)
    local root=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    assert(root and root:IsA("BasePart"),"Avatar is missing its root part")
    model.PrimaryPart=root
    local self=setmetatable({model=model,root=root,edges={},parts={},rest={}},Rig)
    for _,item in ipairs(model:GetDescendants()) do
        if item:IsA("BasePart") then
            item.Anchored=true
            item.CanCollide,item.CanTouch,item.CanQuery=false,false,false
            item.Massless=true
            self.parts[#self.parts+1]=item
            self.edges[item]={}
            self.rest[item]=root.CFrame:ToObjectSpace(item.CFrame)
        elseif item:IsA("Humanoid") then
            item.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
            item.HealthDisplayType=Enum.HumanoidHealthDisplayType.AlwaysOff
        end
    end
    for _,item in ipairs(model:GetDescendants()) do
        if item:IsA("JointInstance") or item:IsA("WeldConstraint") then
            local a,b=item.Part0,item.Part1
            if a and b and self.edges[a] and self.edges[b] then
                local c0,c1
                if item:IsA("JointInstance") then c0,c1=item.C0,item.C1
                else c0,c1=a.CFrame:ToObjectSpace(b.CFrame),CFrame.identity end
                local edge={a=a,b=b,c0=c0,c1=c1,name=item.Name:lower():gsub("%s+", ""),animated=item:IsA("Motor6D")}
                self.edges[a][#self.edges[a]+1]=edge
                self.edges[b][#self.edges[b]+1]=edge
            end
        end
    end
    return self
end

function Rig.create(name,tint)
    tint=tint or Color3.fromRGB(82,187,184)
    local model=simpleBody(tint)
    model.Name=name
    model.Archivable=false
    model:SetAttribute("PT_Internal",true)
    local self=Rig.attach(model)
    self.label=nameplate(model,self.root,name,tint)
    return self
end

function Rig.jointPose(edge,state,phase,idle)
    if not edge.animated then return CFrame.identity end
    local name=edge.name
    local moving=state=="Walking" or state=="Running"
    local wave=moving and math.sin(phase)*(state=="Running" and .7 or .45) or math.sin(idle*1.7)*.025
    local side=name:find("left",1,true) and -1 or 1
    local pitch=0
    if name:find("shoulder",1,true) then
        pitch=wave*side
        if state=="Jumping" then pitch=-.75 elseif state=="Freefall" then pitch=-.3 end
    elseif name:find("hip",1,true) then pitch=-wave*side*.85
    elseif name:find("elbow",1,true) then pitch=moving and -.12-math.abs(wave)*.3 or -.04
    elseif name:find("knee",1,true) then pitch=moving and math.max(0,wave*side)*.55 or 0
    elseif name:find("waist",1,true) then pitch=moving and .06 or math.sin(idle*1.7)*.01 end
    -- Rotate around the body's X axis expressed in this joint's own bind frame.
    local axis=edge.c0:VectorToObjectSpace(Vector3.xAxis)
    return CFrame.fromAxisAngle(axis,pitch)
end

function Rig:pose(rootFrame,state,phase,idle)
    self.root.CFrame=rootFrame
    local visited={[self.root]=true}
    local queue={self.root}
    local cursor=1
    while cursor&lt;=#queue do
        local part=queue[cursor]
        cursor+=1
        for _,edge in ipairs(self.edges[part]) do
            local other=part==edge.a and edge.b or edge.a
            if not visited[other] then
                local c0=edge.c0*Rig.jointPose(edge,state,phase or 0,idle or 0)
                if part==edge.a then other.CFrame=part.CFrame*c0*edge.c1:Inverse()
                else other.CFrame=part.CFrame*edge.c1*c0:Inverse() end
                visited[other]=true
                queue[#queue+1]=other
            end
        end
    end
    for _,part in ipairs(self.parts) do
        if not visited[part] then part.CFrame=rootFrame*self.rest[part] end
    end
end

function Rig:destroy()
    self.model:Destroy()
    self.edges,self.parts,self.rest={},{},{}
end
return Rig
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="PT_Collaboration">
      <Properties>
        <string name="Name">Collaboration</string>
        <ProtectedString name="Source">-- PlaceTogether Studio application component.
return function(app)
function app.features.install()
    local U = app.features
    local UserInputService = game:GetService("UserInputService")
    local Selection = game:GetService("Selection")
    local TT
    -- Assigned before the presence stream starts.
    local lastActionTime = os.clock()
    local lastCamPos = nil
    local lastCamLook = nil
    pcall(function()
        UserInputService.InputBegan:Connect(function() lastActionTime = os.clock() end)
    end)
    pcall(function()
        Selection.SelectionChanged:Connect(function() lastActionTime = os.clock() end)
    end)
    pcall(function()
        local CHS = game:GetService("ChangeHistoryService")
        CHS.OnUndo:Connect(function() lastActionTime = os.clock() end)
        CHS.OnRedo:Connect(function() lastActionTime = os.clock() end)
    end)
    local function formatDuration(seconds)
        seconds = math.max(0, math.floor(tonumber(seconds) or 0))
        if seconds &lt; 60 then
            return string.format("%ds", seconds)
        elseif seconds &lt; 3600 then
            local m = math.floor(seconds / 60)
            local s = seconds % 60
            if s &gt; 0 and m &lt; 10 then
                return string.format("%dm %ds", m, s)
            else
                return string.format("%dm", m)
            end
        else
            local h = math.floor(seconds / 3600)
            local m = math.floor((seconds % 3600) / 60)
            if m &gt; 0 then
                return string.format("%dh %dm", h, m)
            else
                return string.format("%dh", h)
            end
        end
    end

    local function updatePeerCards(peerList)
        if not app.peersFrame then return end
        for _, child in ipairs(app.peersFrame:GetChildren()) do
            if not child:IsA("UIListLayout") and child ~= app.participantsText then
                child:Destroy()
            end
        end
        if not peerList or #peerList == 0 then
            app.participantsText.Visible = true
            app.participantsText.Text = "No other participants in room yet."
            return
        end
        app.participantsText.Visible = false
        for _, peer in ipairs(peerList) do
            local pCard = Instance.new("Frame")
            pCard.Name = "PeerCard_" .. tostring(peer.id)
            pCard.Size = UDim2.new(1, 0, 0, 42)
            pCard.BackgroundColor3 = Color3.fromRGB(18, 22, 31)
            pCard.BorderSizePixel = 0
            pCard.Parent = app.peersFrame
            app.operations.corner(pCard, 8)
            app.operations.stroke(pCard, app.palette.line, 1)

            local avatar = Instance.new("ImageLabel")
            avatar.Name = "Avatar"
            avatar.Size = UDim2.fromOffset(30, 30)
            avatar.Position = UDim2.new(0, 6, 0.5, -15)
            avatar.BackgroundTransparency = 1
            local uid = tonumber(peer.userId) or 0
            if uid &gt; 0 then
                avatar.Image = "rbxthumb://type=AvatarHeadShot&amp;id=" .. tostring(uid) .. "&amp;w=150&amp;h=150"
            else
                avatar.Image = ""
            end
            avatar.Parent = pCard
            app.operations.corner(avatar, 15)

            local tint = Color3.fromHSV(peer.hue or 0.5, 0.75, 1)
            local dot = Instance.new("Frame")
            dot.Name = "Dot"
            dot.Size = UDim2.fromOffset(8, 8)
            dot.Position = UDim2.new(0, 26, 0.5, 4)
            dot.BackgroundColor3 = (peer.isIdle == true) and Color3.fromRGB(234, 179, 8) or tint
            dot.BorderSizePixel = 0
            dot.Parent = pCard
            app.operations.corner(dot, 4)

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Name = "Name"
            nameLbl.Size = UDim2.new(1, -48, 0, 16)
            nameLbl.Position = UDim2.new(0, 42, 0, 4)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextSize = 12
            nameLbl.TextColor3 = app.palette.text
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Text = peer.name
            nameLbl.Parent = pCard

            local isIdle = (peer.isIdle == true)
            local actLbl = Instance.new("TextLabel")
            actLbl.Name = "Activity"
            actLbl.Size = UDim2.new(1, -48, 0, 14)
            actLbl.Position = UDim2.new(0, 42, 0, 20)
            actLbl.BackgroundTransparency = 1
            actLbl.Font = Enum.Font.Gotham
            actLbl.TextSize = 10
            actLbl.TextColor3 = isIdle and Color3.fromRGB(234, 179, 8) or app.palette.green
            actLbl.TextXAlignment = Enum.TextXAlignment.Left
            local actText = peer.activity
            if not actText or actText == "" then
                local selCount = peer.selected and #peer.selected or 0
                actText = selCount &gt; 0 and ("Selected " .. selCount .. " part(s)") or "Viewing place"
            end
            if isIdle and not actText:find("Idle%s*%(") then
                local idleT = peer.idleTime or 60
                actText = (actText == "Viewing place") and ("Idle (" .. formatDuration(idleT) .. ")") or ("Idle (" .. formatDuration(idleT) .. ") · " .. actText)
            end
            actLbl.Text = actText
            actLbl.Parent = pCard
        end
    end

    local currentActiveScriptInfo = nil
    local smoothLerpEnabled = app.owner:GetSetting("PTSmoothLerp") ~= false
    local smoothTargets = {
    }
    U.smoothTargets = smoothTargets
    local alive = true
    local teamTestToolbarBtn = app.toolbar:CreateButton("TeamWalk", "Co-op walkthrough (edit mode)", "")
    local function makeButton(text, parent, kind, height)
        local b = app.operations.makeButton(text, parent, kind == "success" and "primary" or kind)
        if height then
            b.Size = UDim2.new(1, 0, 0, height)
        end
        return b
    end
    local textLabel = app.operations.textLabel
    local corner = app.operations.corner
    local stroke = app.operations.stroke
    local testCard = app.card(app.teamTestPanel, "Walkthrough")
    app.title("Team Test", testCard)
    local ttActiveUsersLabel = textLabel("Walkthrough: avatars and collisions in edit mode.", 36, testCard)
    local toggleTeamTestBtn = makeButton("Start co-op walkthrough", testCard, "primary")
    textLabel("Walkthrough previews movement; game scripts and Roblox server physics do not run.", 40, testCard).TextSize = 11
    local conflictBanner = app.card(app.homePanel, "SelectionConflict")
    local conflictLabel = textLabel("", 40, conflictBanner)
    conflictBanner.Visible = false
    local secretCard = app.card(app.settingsPanel, "ServerPassword")
    app.title("Server password (optional)", secretCard)
    U.secret = app.operations.field("X-PT-Secret", app.owner:GetSetting("PTServerSecret") or "", secretCard)
    U.secret.FocusLost:Connect(function()
        app.owner:SetSetting("PTServerSecret", U.secret.Text)
    end)
    local smoothToggle = makeButton("Smooth remote drag: On", secretCard)
    smoothToggle.MouseButton1Click:Connect(function()
        smoothLerpEnabled = not smoothLerpEnabled
        app.owner:SetSetting("PTSmoothLerp", smoothLerpEnabled)
        smoothToggle.Text = smoothLerpEnabled and "Smooth remote drag: On" or "Smooth remote drag: Off"
    end)
    local function playNotificationSound()
        pcall(function()
            local sound = Instance.new("Sound")
            ;
            sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
            ;
            sound.Volume = 0.3
            sound.Parent = game:GetService("CoreGui")
            ;
            sound:Play()
            ;
            task.delay(2, function()
                sound:Destroy()
            end)
        end)
    end
    task.spawn(function()
        while alive do
            task.wait(0.5)
            currentActiveScriptInfo = nil
            if app.active then
                pcall(function()
                    local object = game:GetService("StudioService").ActiveScript
                    if object and app.instanceKeys[object] then
                        local line = 1
                        ;
                        local doc = app.editor:FindScriptDocument(object)
                        if doc then
                            line = doc:GetSelection()
                        end
                        currentActiveScriptInfo = {
                            id = app.instanceKeys[object],
                            name = object.Name,
                            line = line,
                        }
                    end
                end)
            end
        end
    end)
    -- Lifecycle and the imported walkthrough/presence subsystem follow below.
    app.owner.Unloading:Connect(function()
        alive = false
    end)
    U.installContext = {
    }
    local function isLocallyDragging(obj)
        if not obj then
            return false
        end
        local mouseDown = false
        pcall(function()
            mouseDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        end)
        if not mouseDown then
            return false
        end
        for _, sel in ipairs(Selection:Get()) do
            if sel == obj or obj:IsDescendantOf(sel) then
                return true
            end
        end
        return false
    end
    local function queueSmoothTransform(key, obj, targetCF, isModel, immediate)
        if not smoothLerpEnabled or isLocallyDragging(obj) or app.synchronization.remoteLoad or app.synchronization.bulkUpload then
            return 
        end
        app.features.previews[key] = os.clock()
        smoothTargets[key] = {
            obj = obj,
            targetCF = targetCF,
            isModel = isModel,
            updatedAt = os.clock(),
        }
    end
    TT = require(app.entry.Walkthrough).new({
        plugin = app.owner,
        name = function()
            return app.selfNick.Text
        end,
        status = app.status,
        toggle = toggleTeamTestBtn,
        canStart = function()
            local allowed = app.active and not app.busy and not app.synchronization.bulkUpload and not app.synchronization.remoteLoad and not app.run:IsRunning()
            return allowed
        end,
        canContinue = function()
            return app.active and not app.run:IsRunning()
        end,
    })
    toggleTeamTestBtn.MouseButton1Click:Connect(TT.toggle)
    teamTestToolbarBtn.Click:Connect(TT.toggle)
    do
        local alive = true
        local enabled = app.owner:GetSetting("PTShowParticipants") ~= false
        local folder = nil
        local markers = {
        }
        local previousRoom = nil
        local previousBase = nil
        local sending = false
        local function clear()
            if folder then
                folder:Destroy()
                folder = nil
            end
            markers = {
            }
        end
        local function vector(v)
            return Vector3.new(v[1], v[2], v[3])
        end
        local function marker(peer)
            if not folder then
                folder = Instance.new("Folder")
                folder.Name = "PlaceTogetherPresence"
                folder.Archivable = false
                folder.Parent = game:GetService("CoreGui")
            end
            local group = Instance.new("Folder")
            group.Name = peer.id
            group.Parent = folder
            local tint = Color3.fromHSV(peer.hue or 0.55, 0.65, 1)
            local sphere = Instance.new("SphereHandleAdornment")
            sphere.Name = "Participant"
            sphere.Adornee = workspace.Terrain
            sphere.Radius = 1.4
            sphere.Color3 = tint
            sphere.Transparency = 0.15
            sphere.AlwaysOnTop = false
            sphere.Parent = group
            pcall(function()
                sphere.Shading = Enum.AdornShading.Shaded
            end)
            local direction = Instance.new("LineHandleAdornment")
            direction.Name = "Direction"
            direction.Adornee = workspace.Terrain
            direction.Color3 = tint
            direction.Thickness = 3
            direction.Parent = group
            local caption = Instance.new("BillboardGui")
            caption.Name = "Nickname"
            caption.Adornee = workspace.Terrain
            caption.Size = UDim2.fromOffset(180, 32)
            caption.AlwaysOnTop = true
            caption.MaxDistance = 2500
            caption.Parent = group
            local label = Instance.new("TextLabel")
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.GothamBold
            label.TextSize = 13
            label.TextColor3 = tint
            label.TextStrokeColor3 = Color3.fromRGB(15, 15, 20)
            label.TextStrokeTransparency = 0.15
            label.Text = peer.name
            label.Parent = caption
            return {
                group = group,
                sphere = sphere,
                direction = direction,
                tint = tint,
                selection = {
                },
                boxes = {
                },
                caption = caption,
                label = label,
                position = vector(peer.position),
                target = vector(peer.position),
                look = vector(peer.look),
                targetLook = vector(peer.look),
                seen = os.clock(),
            }
        end
        local function receive(peers)
            local present = {
            }
            local names = {
            }
            app.features.latestPeers = peers
            for _, p in ipairs(peers) do
                p._receivedAt = os.clock()
            end
            for _, peer in ipairs(peers) do
                if peer.ping then
                    peer.ping.time = os.clock() - (peer.ping.age or 0)
                end
                present[peer.id] = true
                table.insert(names, peer.name)
                if enabled and not (peer.teamTest and peer.teamTest.active) then
                    local item = markers[peer.id] or marker(peer)
                    markers[peer.id] = item
                    item.target = vector(peer.position)
                    item.targetLook = vector(peer.look)
                    local lblText = peer.name
                    if peer.isIdle then
                        local idleT = peer.idleTime or 60
                        lblText = peer.name .. " (Idle " .. formatDuration(idleT) .. ")"
                    end
                    item.label.Text = lblText
                    item.seen = os.clock()
                    item.selection = {
                    }
                    for _, key in ipairs(peer.selected or {
                    }) do
                        item.selection[key] = true
                    end
                    for key, box in pairs(item.boxes) do
                        if not item.selection[key] then
                            box:Destroy()
                            item.boxes[key] = nil
                        end
                    end
                elseif markers[peer.id] then
                    markers[peer.id].group:Destroy()
                    markers[peer.id] = nil
                end
                if smoothLerpEnabled and type(peer.transforms) == "table" then
                    for key, comps in pairs(peer.transforms) do
                        local obj = app.instances[key]
                        if obj and type(comps) == "table" and #comps == 12 then
                            local cf = CFrame.new(table.unpack(comps))
                            if obj:IsA("Model") then
                                queueSmoothTransform(key, obj, cf, true, false)
                            elseif obj:IsA("BasePart") then
                                queueSmoothTransform(key, obj, cf, false, false)
                            end
                        end
                    end
                end
            end
            for id, item in pairs(markers) do
                if not present[id] then
                    item.group:Destroy()
                    markers[id] = nil
                end
            end
            app.participantsText.Text = #names &gt; 0 and ("Peers online (" .. #names .. "): " .. table.concat(names, ", ")) or "No other participants in room yet."
            pcall(updatePeerCards, peers)
            -- Check selection conflicts and 3D Pings from peers
            local mySelectedKeys = {
            }
            for _, obj in ipairs(Selection:Get()) do
                local k = app.instanceKeys[obj]
                if k then
                    mySelectedKeys[k] = obj
                end
            end
            local conflictObjName = nil
            local conflictPeerName = nil
            for _, peer in ipairs(peers) do
                if peer.selected then
                    for _, k in ipairs(peer.selected) do
                        if mySelectedKeys[k] then
                            conflictObjName = mySelectedKeys[k].Name
                            conflictPeerName = peer.name
                            break
                        end
                    end
                end
                if peer.ping and (os.clock() - peer.ping.time &lt; 8) then
                    local item = markers[peer.id]
                    if item then
                        item.ping = peer.ping
                        if item.lastPingId ~= peer.ping.id then
                            item.lastPingId = peer.ping.id
                            playNotificationSound()
                        end
                    end
                end
                if conflictObjName then
                    break
                end
            end
            if conflictObjName then
                conflictBanner.Visible = true
                conflictLabel.Text = "⚠️ Conflict: '" .. conflictObjName .. "' is also selected by " .. conflictPeerName
            else
                conflictBanner.Visible = false
            end
            -- Update Active Team Testers
            local testers = {
            }
            for _, peer in ipairs(peers) do
                if peer.teamTest and peer.teamTest.active then
                    table.insert(testers, peer.name)
                else
                    if TT.remoteTesters[peer.id] then
                        if TT.remoteTesters[peer.id].model then
                            TT.remoteTesters[peer.id].model:Destroy()
                        end
                        TT.remoteTesters[peer.id] = nil
                    end
                end
            end
            for id, item in pairs(TT.remoteTesters) do
                if not present[id] then
                    if item.model then
                        item.model:Destroy()
                    end
                    ;
                    TT.remoteTesters[id] = nil
                end
            end
            TT.activeTestersList = testers
            local allTesters = {
            }
            if TT.active then
                table.insert(allTesters, app.selfNick.Text .. " (You)")
            end
            for _, tName in ipairs(testers) do
                table.insert(allTesters, tName)
            end
            ttActiveUsersLabel.Text = #allTesters &gt; 0 and ("👥 Active testers: " .. table.concat(allTesters, ", ")) or "No active testers in room."
            if TT.hudActiveUsersLabel then
                TT.hudActiveUsersLabel.Text = "👥 " .. table.concat(allTesters, ", ")
            end
            if TT.active then
                toggleTeamTestBtn.Text = "⏹ Exit Team Test"
                toggleTeamTestBtn.TextColor3 = Color3.fromRGB(252, 165, 165)
                toggleTeamTestBtn.BackgroundColor3 = app.palette.dangerBg
            elseif #testers &gt; 0 then
                toggleTeamTestBtn.Text = "▶ Join Team Test (" .. testers[1] .. " is testing!)"
                toggleTeamTestBtn.TextColor3 = Color3.fromRGB(187, 247, 208)
                toggleTeamTestBtn.BackgroundColor3 = app.palette.greenBg
            else
                toggleTeamTestBtn.Text = "▶ Start Team Test"
                toggleTeamTestBtn.TextColor3 = app.palette.ink
                toggleTeamTestBtn.BackgroundColor3 = app.palette.accent
            end
        end
        local function cameraState()
            local camera = workspace.CurrentCamera
            if not camera then
                return nil
            end
            local position = camera.CFrame.Position
            local look = camera.CFrame.LookVector
            local selected = {
            }
            local transforms = {
            }
            local tCount = 0
            for _, obj in ipairs(Selection:Get()) do
                local key = app.instanceKeys[obj]
                if key and obj:IsDescendantOf(workspace) and (obj:IsA("BasePart") or obj:IsA("Model")) then
                    table.insert(selected, key)
                    if tCount &lt; 16 then
                        local ok, cf = pcall(function()
                            return obj:IsA("Model") and obj:GetPivot() or obj.CFrame
                        end)
                        if ok and cf then
                            transforms[key] = {
                                cf:GetComponents(),
                            }
                            tCount = tCount + (1)
                        end
                    end
                    if #selected &gt;= 32 then
                        break
                    end
                end
            end
            local teamTestData = nil
            if TT.active and TT.char and TT.char.PrimaryPart then
                local p = TT.char.PrimaryPart.Position
                local lv = TT.char.PrimaryPart.CFrame.LookVector
                teamTestData = {
                    active = true,
                    pos = {
                        p.X,
                        p.Y,
                        p.Z,
                    },
                    look = {
                        lv.X,
                        lv.Y,
                        lv.Z,
                    },
                    state = TT.state,
                    userId = TT.myUserId or 0,
                }
            else
                teamTestData = {
                    active = false,
                }
            end
            if not lastCamPos or (position - lastCamPos).Magnitude &gt; 0.05 or (look - lastCamLook).Magnitude &gt; 0.02 then
                lastActionTime = os.clock()
                lastCamPos = position
                lastCamLook = look
            end
            local idleSec = math.max(0, math.floor(os.clock() - lastActionTime))
            local isIdle = (idleSec &gt;= 60)
            local act = "Viewing place"
            if TT and TT.active then
                act = "Team Test (walking)"
            elseif currentActiveScriptInfo and currentActiveScriptInfo.name then
                act = "Editing script: " .. tostring(currentActiveScriptInfo.name)
            elseif #selected == 1 then
                local selItems = Selection:Get()
                act = "Selected: " .. (selItems[1] and tostring(selItems[1].Name) or "Object")
            elseif #selected &gt; 1 then
                act = "Selected " .. #selected .. " objects"
            end
            if isIdle then
                local timeStr = formatDuration(idleSec)
                act = (act == "Viewing place") and ("Idle (" .. timeStr .. ")") or ("Idle (" .. timeStr .. ") · " .. act)
            end
            return {
                position = {
                    position.X,
                    position.Y,
                    position.Z,
                },
                look = {
                    look.X,
                    look.Y,
                    look.Z,
                },
                selected = selected,
                transforms = transforms,
                teamTest = teamTestData,
                activeScript = currentActiveScriptInfo,
                userId = app.localUserId or 0,
                activity = act,
                isIdle = isIdle,
                idleTime = idleSec,
            }
        end
        app.presenceToggle.Text = enabled and "Peer Cursors &amp; Live Drag: On" or "Peer Cursors &amp; Live Drag: Off"
        local toggleConnection = app.presenceToggle.MouseButton1Click:Connect(function()
            enabled = not enabled
            app.owner:SetSetting("PTShowParticipants", enabled)
            app.presenceToggle.Text = enabled and "Peer Cursors &amp; Live Drag: On" or "Peer Cursors &amp; Live Drag: Off"
            if not enabled then
                clear()
            end
        end)
        local renderConnection = app.run.RenderStepped:Connect(function(dt)
            if not app.active or app.run:IsRunning() then
                if folder then
                    clear()
                end
                smoothTargets = {
                }
                ;
                app.features.smoothTargets = smoothTargets
                if TT.active then
                    TT.stop()
                end
                for id, item in pairs(TT.remoteTesters) do
                    if item.model then
                        item.model:Destroy()
                    end
                    ;
                    TT.remoteTesters[id] = nil
                end
                if TT.folder then
                    TT.folder:Destroy()
                    ;
                    TT.folder = nil
                end
                app.features.previews = {
                }
                return 
            end
            if app.synchronization.remoteLoad or app.synchronization.bulkUpload then
                return 
            end
            if TT.active then
                TT.updateLocal(dt)
            end
            local peers = app.features.latestPeers or {
            }
            for _, peer in ipairs(peers) do
                if peer.teamTest and peer.teamTest.active and os.clock() - (peer._receivedAt or os.clock()) &lt; 12 then
                    TT.updateRemote(peer, dt)
                end
            end
            for key, at in pairs(app.features.previews) do
                if os.clock() - at &gt; 1 then
                    local obj = app.instances[key]
                    ;
                    local saved = app.synchronization.current[key]
                    if obj and saved and not isLocallyDragging(obj) then
                        local old = app.synchronization.receiving
                        ;
                        app.synchronization.receiving = true
                        pcall(function()
                            if obj:IsA("Model") and saved.props and saved.props.WorldPivot then
                                obj:PivotTo(app.operations.decode(saved.props.WorldPivot))
                            elseif saved.props and saved.props.CFrame then
                                obj.CFrame = app.operations.decode(saved.props.CFrame)
                            end
                        end)
                        app.synchronization.receiving = old
                    end
                    app.features.previews[key] = nil
                end
            end
            if smoothLerpEnabled and next(smoothTargets) then
                local priorReceiving = app.synchronization.receiving
                app.synchronization.receiving = true
                local objBlend = 1 - math.exp(-22 * math.min(dt, 0.1))
                local now = os.clock()
                for key, item in pairs(smoothTargets) do
                    local obj = item.obj
                    if not obj or not obj.Parent or isLocallyDragging(obj) then
                        smoothTargets[key] = nil
                    else
                        local ok, curCF = pcall(function()
                            return item.isModel and obj:GetPivot() or obj.CFrame
                        end)
                        if not ok or not curCF then
                            smoothTargets[key] = nil
                        else
                            local dist = (curCF.Position - item.targetCF.Position).Magnitude
                            if dist &lt; 0.002 and curCF.Rotation:FuzzyEq(item.targetCF.Rotation, 0.0005) or (now - item.updatedAt &gt; 0.5) then
                                pcall(function()
                                    if item.isModel then
                                        obj:PivotTo(item.targetCF)
                                    else
                                        obj.CFrame = item.targetCF
                                    end
                                end)
                                smoothTargets[key] = nil
                            else
                                local nextCF = curCF:Lerp(item.targetCF, objBlend)
                                pcall(function()
                                    if item.isModel then
                                        obj:PivotTo(nextCF)
                                    else
                                        obj.CFrame = nextCF
                                    end
                                end)
                            end
                        end
                    end
                end
                app.synchronization.receiving = priorReceiving
            end
            if not enabled then
                if folder then
                    clear()
                end
                return 
            end
            local blend = 1 - math.exp(-16 * math.min(dt, 0.1))
            for id, item in pairs(markers) do
                if os.clock() - item.seen &gt; 12 then
                    item.group:Destroy()
                    markers[id] = nil
                else
                    item.position = item.position:Lerp(item.target, blend)
                    item.look = item.look:Lerp(item.targetLook, blend)
                    item.sphere.CFrame = workspace.Terrain.CFrame:ToObjectSpace(CFrame.new(item.position))
                    item.direction.Visible = item.look.Magnitude &gt; 0.01
                    if item.look.Magnitude &gt; 0.01 then
                        item.direction.CFrame = workspace.Terrain.CFrame:ToObjectSpace(CFrame.lookAt(item.position, item.position + item.look))
                        item.direction.Length = 4
                    end
                    item.caption.StudsOffsetWorldSpace = item.position - workspace.Terrain.Position + Vector3.new(0, 2.5, 0)
                    for key in pairs(item.selection) do
                        local obj = app.instances[key]
                        local box = item.boxes[key]
                        if obj and obj:IsDescendantOf(workspace) and (obj:IsA("BasePart") or obj:IsA("Model")) then
                            if not box then
                                box = Instance.new("SelectionBox")
                                box.Name = "SelectedObject"
                                box.Color3 = item.tint
                                box.SurfaceColor3 = item.tint
                                box.SurfaceTransparency = 0.9
                                box.LineThickness = 0.04
                                box.Parent = item.group
                                item.boxes[key] = box
                            end
                            box.Adornee = obj
                        elseif box then
                            box:Destroy()
                            item.boxes[key] = nil
                        end
                    end
                end
            end
            -- 3. 3D Spatial Beacons (Pings)
            local myCamPos = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.zero
            for id, item in pairs(markers) do
                if item.ping and (os.clock() - item.ping.time &lt; 8) then
                    if not item.beacon then
                        local bGroup = Instance.new("Folder")
                        bGroup.Name = "PingBeacon"
                        bGroup.Parent = item.group
                        local bSphere = Instance.new("SphereHandleAdornment")
                        bSphere.Adornee = workspace.Terrain
                        bSphere.Color3 = item.tint
                        bSphere.Transparency = 0.2
                        bSphere.AlwaysOnTop = true
                        bSphere.Parent = bGroup
                        local bBeam = Instance.new("LineHandleAdornment")
                        bBeam.Adornee = workspace.Terrain
                        bBeam.Color3 = item.tint
                        bBeam.Thickness = 4
                        bBeam.AlwaysOnTop = true
                        bBeam.Parent = bGroup
                        local bGui = Instance.new("BillboardGui")
                        bGui.Adornee = workspace.Terrain
                        bGui.Size = UDim2.fromOffset(190, 42)
                        bGui.AlwaysOnTop = true
                        bGui.Parent = bGroup
                        local bBg = Instance.new("Frame")
                        bBg.Size = UDim2.fromScale(1, 1)
                        bBg.BackgroundColor3 = Color3.fromRGB(15, 18, 26)
                        bBg.BorderSizePixel = 0
                        corner(bBg, 6)
                        stroke(bBg, item.tint, 1.5)
                        bBg.Parent = bGui
                        local bName = Instance.new("TextLabel")
                        bName.Size = UDim2.new(1, -8, 0, 18)
                        bName.Position = UDim2.fromOffset(4, 2)
                        bName.BackgroundTransparency = 1
                        bName.Font = Enum.Font.GothamBold
                        bName.TextSize = 12
                        bName.TextColor3 = item.tint
                        bName.Text = "📍 " .. (item.ping.text or "Look here!") .. " (" .. item.label.Text .. ")"
                        bName.Parent = bBg
                        local bDist = Instance.new("TextLabel")
                        bDist.Size = UDim2.new(1, -8, 0, 16)
                        bDist.Position = UDim2.fromOffset(4, 20)
                        bDist.BackgroundTransparency = 1
                        bDist.Font = Enum.Font.Gotham
                        bDist.TextSize = 10
                        bDist.TextColor3 = app.palette.subtle
                        bDist.Text = "calculating..."
                        bDist.Parent = bBg
                        item.beacon = {
                            group = bGroup,
                            sphere = bSphere,
                            beam = bBeam,
                            gui = bGui,
                            distLabel = bDist,
                            pos = Vector3.new(item.ping.pos[1], item.ping.pos[2], item.ping.pos[3]),
                        }
                    end
                    local b = item.beacon
                    local pulse = 1.8 + math.sin(os.clock() * 8) * 0.5
                    b.sphere.Radius = pulse
                    b.sphere.CFrame = workspace.Terrain.CFrame:ToObjectSpace(CFrame.new(b.pos))
                    b.beam.CFrame = workspace.Terrain.CFrame:ToObjectSpace(CFrame.lookAt(b.pos, b.pos + Vector3.new(0, 1, 0)))
                    b.beam.Length = 30
                    b.gui.StudsOffsetWorldSpace = b.pos - workspace.Terrain.Position + Vector3.new(0, 3.5, 0)
                    local d = math.floor((myCamPos - b.pos).Magnitude)
                    b.distLabel.Text = tostring(d) .. " studs away"
                elseif item.beacon then
                    item.beacon.group:Destroy()
                    item.beacon = nil
                    item.ping = nil
                end
            end
        end)
        task.spawn(function()
            while alive do
                if app.active and app.loggedIn and not app.run:IsRunning() then
                    local currentRoom = app.room.Text
                    local currentBase = app.base()
                    if previousRoom ~= currentRoom or previousBase ~= currentBase then
                        clear()
                    end
                    previousRoom = currentRoom
                    previousBase = currentBase
                    local nowSec = os.clock()
                    local myIdleSec = math.max(0, math.floor(nowSec - lastActionTime))
                    local myIsIdle = (myIdleSec &gt;= 60)
                    if app.dot and app.statusBadgeLabel then
                        if myIsIdle then
                            app.dot.BackgroundColor3 = Color3.fromRGB(234, 179, 8)
                            app.statusBadgeLabel.Text = "IDLE " .. formatDuration(myIdleSec)
                            app.statusBadgeLabel.TextColor3 = Color3.fromRGB(234, 179, 8)
                            if app.badgeStroke then app.badgeStroke.Color = Color3.fromRGB(234, 179, 8) end
                            if app.identity then app.identity.Text = app.selfNick.Text .. " · Idle (" .. formatDuration(myIdleSec) .. ")" end
                        else
                            app.dot.BackgroundColor3 = app.palette.green
                            app.statusBadgeLabel.Text = "LIVE"
                            app.statusBadgeLabel.TextColor3 = app.palette.green
                            if app.badgeStroke then app.badgeStroke.Color = app.palette.green
                            if app.identity then app.identity.Text = app.selfNick.Text .. " · In Session" end
                        end
                    end
                    local payload = cameraState()
                    if payload then
                        sending = true
                        local ok, peers = pcall(function()
                            return app.api("/rooms/" .. currentRoom .. "/presence", "POST", payload)
                        end)
                        sending = false
                        if alive and app.active and not app.run:IsRunning() and currentRoom == app.room.Text and currentBase == app.base() then
                            if ok then
                                local rendered, reason = pcall(function()
                                    receive(peers)
                                end)
                                if not rendered then
                                    clear()
                                    app.participantsText.Text = "Peer cursors: " .. tostring(reason)
                                end
                            else
                                app.participantsText.Text = "Updating peer connection..."
                            end
                        end
                    end
                else
                    clear()
                    app.participantsText.Text = "Participants will appear once connected."
                    if previousRoom and not sending then
                        local oldRoom = previousRoom
                        local oldBase = previousBase
                        previousRoom = nil
                        previousBase = nil
                        if oldBase == app.base() then
                            pcall(function()
                                app.api("/rooms/" .. oldRoom .. "/presence", "POST", {
                                    leave = true,
                                })
                            end)
                        end
                    end
                end
                task.wait(0.15)
            end
        end)
        app.owner.Unloading:Connect(function()
            alive = false
            renderConnection:Disconnect()
            toggleConnection:Disconnect()
            TT.stop()
            for _, item in pairs(TT.remoteTesters) do
                if item.model then
                    item.model:Destroy()
                end
            end
            if TT.folder then
                TT.folder:Destroy()
            end
            clear()
        end)
    end
end
app.features.install()
end
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="PT_Panels">
      <Properties>
        <string name="Name">Panels</string>
        <ProtectedString name="Source">-- PlaceTogether Studio application component.
return function(app)
    app.localUserId = 0
    pcall(function()
        local uid = game:GetService("StudioService"):GetUserId()
        if type(uid) == "number" and uid &gt; 0 then app.localUserId = uid end
    end)

app.features = {
    previews = {
    },
}
app.operations = {
}
app.http = game:GetService("HttpService")
app.editor = game:GetService("ScriptEditorService")
app.run = game:GetService("RunService")
app.Serialization = nil
pcall(function()
    app.Serialization = game:GetService("SerializationService")
end)
app.roots = {
    "Workspace",
    "ReplicatedStorage",
    "ReplicatedFirst",
    "ServerScriptService",
    "ServerStorage",
    "StarterGui",
    "StarterPack",
    "StarterPlayer",
    "Teams",
    "MaterialService",
    "TextChatService",
    "Lighting",
    "SoundService",
}
app.serviceIds = {
}
;
for _, name in ipairs(app.roots) do
    app.serviceIds["@" .. name] = true
end
app.common = {
    "Archivable",
    "TopSurface",
    "BottomSurface",
    "LeftSurface",
    "RightSurface",
    "FrontSurface",
    "BackSurface",
    "MaterialVariant",
}
app.props = {
    "Anchored",
    "CanCollide",
    "CanTouch",
    "CanQuery",
    "Transparency",
    "Reflectance",
    "Color",
    "Material",
    "Size",
    "CFrame",
    "Shape",
    "MeshId",
    "TextureID",
    "TextureId",
    "Texture",
    "Face",
    "Enabled",
    "Brightness",
    "Range",
    "Shadows",
    "Angle",
    "SoundId",
    "Volume",
    "Looped",
    "PlaybackSpeed",
    "Value",
    "PrimaryPart",
    "Part0",
    "Part1",
    "C0",
    "C1",
    "Attachment0",
    "Attachment1",
    "Position",
    "Orientation",
    "Axis",
    "SecondaryAxis",
    "Text",
    "TextSize",
    "TextColor3",
    "BackgroundColor3",
    "BackgroundTransparency",
    "BorderSizePixel",
    "Visible",
    "AnchorPoint",
    "Image",
    "ImageColor3",
    "CanvasSize",
    "DisplayOrder",
    "ResetOnSpawn",
    "Disabled",
    "Ambient",
    "OutdoorAmbient",
    "ClockTime",
    "FogEnd",
    "FogStart",
    "FogColor",
}
app.DEFAULT_PORT = 8787
app.localInstanceKey = (app.http:GenerateGUID(false) .. app.http:GenerateGUID(false)):gsub("%-", ""):lower()
app.localInstanceTag = app.localInstanceKey:sub(1, 4)
app.localNick = nil
function app.operations.splitHostPort(value)
    if value:sub(1, 1) == "[" then
        local close = value:find("]", 1, true)
        if close then
            return value:sub(1, close), value:match("^%[.-%]:(%d+)$")
        end
    end
    local host, port = value:match("^(.-):(%d+)$")
    return host or value, port
end
-- The UI asks for a bare IP/host and a separate port. This keeps normal use simple:
-- "192.168.1.5" + "8787", never "https://...:8787/" pasted into one box.
function app.operations.splitAddress(value)
    local text = tostring(value or ""):gsub("%s+", "")
    text = text:gsub("^[%a][%w+.-]*://", ""):gsub("/+$", "")
    if text == "" then
        return "", nil
    end
    local host, port = app.operations.splitHostPort(text)
    host = tostring(host or ""):gsub("/.*$", "")
    return host, port
end
function app.operations.composeAddress(host, port)
    local cleanHost = tostring(host or ""):gsub("%s+", "")
    cleanHost = cleanHost:gsub("^[%a][%w+.-]*://", ""):gsub("/+$", ""):gsub("/.*$", "")
    local hostOnly, hostPort = app.operations.splitHostPort(cleanHost)
    local portText = tostring(port or hostPort or ""):gsub("%D", "")
    local portNumber = tonumber(portText) or app.DEFAULT_PORT
    if portNumber &lt; 1 or portNumber &gt; 65535 then
        portNumber = app.DEFAULT_PORT
    end
    if hostOnly == "" then
        return ""
    end
    return "http://" .. hostOnly .. ":" .. tostring(portNumber)
end
function app.operations.normalizeAddress(value)
    if tostring(value):match("^https?://") then
        return tostring(value):gsub("%s+", ""):gsub("/+$", "")
    end
    local host, port = app.operations.splitAddress(value)
    if host == "" then
        return ""
    end
    return app.operations.composeAddress(host, port or app.DEFAULT_PORT)
end
function app.operations.isLocalAddress(value)
    local serverBase = app.operations.normalizeAddress(value)
    local host = serverBase:match("^%a+://([^/]+)") or ""
    host = app.operations.splitHostPort(host):lower()
    return host == "localhost" or host == "127.0.0.1" or host == "[::1]" or host == "::1"
end
function app.operations.defaultDisplayName(key)
    local name = ""
    pcall(function()
        local uid = game:GetService("StudioService"):GetUserId()
        if uid &gt; 0 then
            name = game:GetService("Players"):GetNameFromUserIdAsync(uid)
        end
    end)
    if name == "" then
        name = "User_" .. tostring(key):sub(1, 6)
    end
    return name
end
app.savedURL = app.owner:GetSetting("PTAddress") or ""
app.savedHost, app.savedPort = app.operations.splitAddress(app.savedURL)
if app.savedURL:match("^https?://") and not app.operations.isLocalAddress(app.savedURL) then
    app.savedHost = app.savedURL
end
if type(app.savedHost) ~= "string" or app.savedHost == "" then
    app.savedHost = "localhost"
end
app.savedPort = tonumber(app.savedPort) or app.DEFAULT_PORT
app.toolbar = app.owner:CreateToolbar("PlaceTogether")
app.button = app.toolbar:CreateButton("PlaceTogether", "Collaborative Building", "")
app.widget = app.owner:CreateDockWidgetPluginGuiAsync("PlaceTogetherInvites02", DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, false, 340, 540, 280, 400))
app.widget.Title = "PlaceTogether Studio 0.1.1"
app.palette = {
    bg = Color3.fromRGB(18, 27, 36),
    card = Color3.fromRGB(23, 27, 36),
    cardBorder = Color3.fromRGB(38, 44, 58),
    field = Color3.fromRGB(18, 21, 28),
    fieldBorder = Color3.fromRGB(48, 56, 74),
    fieldFocus = Color3.fromRGB(90, 145, 255),
    line = Color3.fromRGB(38, 44, 58),
    text = Color3.fromRGB(248, 250, 252),
    muted = Color3.fromRGB(148, 163, 184),
    subtle = Color3.fromRGB(100, 116, 139),
    accent = Color3.fromRGB(46, 151, 158),
    accentBorder = Color3.fromRGB(96, 165, 250),
    ink = Color3.fromRGB(255, 255, 255),
    green = Color3.fromRGB(34, 197, 94),
    greenBg = Color3.fromRGB(20, 48, 32),
    danger = Color3.fromRGB(239, 68, 68),
    dangerBg = Color3.fromRGB(45, 22, 26),
    dangerBorder = Color3.fromRGB(120, 40, 50),
    tabBg = Color3.fromRGB(19, 21, 29),
    tabActive = Color3.fromRGB(35, 42, 58),
}
app.loggedIn = false
app.guestEnter = nil
app.uiTab = "home"
app.frame = Instance.new("Frame")
app.frame.Name = "PlaceTogetherUI"
app.frame.Size = UDim2.fromScale(1, 1)
app.frame.BackgroundColor3 = app.palette.bg
app.frame.BorderSizePixel = 0
app.frame.Parent = app.widget
function app.operations.corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = obj
    return c
end
function app.operations.stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or app.palette.line
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    return s
end
function app.pad(obj, n, nY)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, n)
    p.PaddingRight = UDim.new(0, n)
    p.PaddingTop = UDim.new(0, nY or n)
    p.PaddingBottom = UDim.new(0, nY or n)
    p.Parent = obj
    return p
end
function app.operations.stack(obj, gap)
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, gap or 10)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Parent = obj
    return l
end
function app.operations.container(parent, name)
    local f = Instance.new("Frame")
    f.Name = name
    f.Size = UDim2.new(1, 0, 0, 0)
    f.AutomaticSize = Enum.AutomaticSize.Y
    f.BackgroundTransparency = 1
    f.Parent = parent
    app.operations.stack(f, 10)
    return f
end
